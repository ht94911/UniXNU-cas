diff --git a/README.md b/README.md
index 754650d..0680d01 100644
--- a/README.md
+++ b/README.md
@@ -88,6 +88,12 @@ display selection changes no system display or timer state.
 An object without a timer or vsync source remains a readable candidate while
 discovery continues; its presence alone does not mark timing discovery ready.
 
+For iPhone 24A446 diagnostics, that same observer reads the original render
+Context registry, deferred-head time and dependency count, local deferral count,
+and linked-context pointer. Its one-millisecond sampling budget and repeated
+field checks report incomplete or changing reads explicitly. Context IDs let
+the retained messages and physical frame holds be compared to these states.
+
 The runtime keeps command counts in each open encoder and reuses unchanged resource-residency facts. Merge scratch can be lent to later encoders of the same command buffer, with its original barriers and leases. A shadow may remain current across command buffers only for tracked private memory owned by the runtime; heaps and external memory retain their required copies. `sheng-metal-flow=1` separately enables lowering, direct commit submission and pipeline warming for experiments; it defaults to off, and pipeline waits remain exact.
 
 ## Heap texture copies
diff --git a/bridge/context_wait_host.cpp b/bridge/context_wait_host.cpp
new file mode 100644
index 0000000..50ca366
--- /dev/null
+++ b/bridge/context_wait_host.cpp
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: MIT */
+#include "../NativeContextWaitState.h"
+#include <cassert>
+#include <cstdio>
+#include <vector>
+
+// Native registry bytes, not replacement Context methods. The fixtures use
+// the registry walk, constructor stores and drain_deferred loads verified from
+// the original image, including a nullable dependency set.
+struct Region { uint64_t address;std::vector<unsigned char> bytes; };
+struct Memory {
+ std::vector<Region> regions;
+ unsigned calls=0,depReads=0,contextReads=0;
+ uint64_t time=100000000,step=1;
+ bool changeRegistry=false,changeHead=false,changeCount=false;
+ uint64_t slot=nbcontextwait::kRegistrySlot,map=0x100000000,buckets=0x100001000;
+ uint64_t entry=0x100002000,context=0x100003000,head=0x100004000,set=0x100005000;
+ void area(uint64_t a,unsigned n){regions.push_back({a,std::vector<unsigned char>(n)});}
+ void put(uint64_t a,uint64_t value,unsigned n=8) {
+  for(auto &r:regions)if(a>=r.address && a-r.address+n<=r.bytes.size()) {
+   std::memcpy(r.bytes.data()+a-r.address,&value,n);return;
+  }
+  assert(false);
+ }
+ int read(uint64_t a,void *out,unsigned n) {
+  ++calls;
+  if(changeRegistry && a==slot && calls>1)put(slot,map+0x100000);
+  if(a==context && ++contextReads>1 && changeHead)put(context+0x2f8,head+0x1000);
+  if(changeCount && a==set+0x18 && ++depReads>1)put(set+0x18,4);
+  for(const auto &r:regions)if(a>=r.address && a-r.address+n<=r.bytes.size()) {
+   std::memcpy(out,r.bytes.data()+a-r.address,n);return 0;
+  }
+  return 1;
+ }
+ uint64_t now(){time+=step;return time;}
+ Memory(bool pending=true,bool dependencies=true) {
+  area(slot,8);area(map,32);area(buckets,16);area(entry,32);area(context,0x330);area(head,32);area(set,32);
+  put(slot,map);put(map,1,4);put(map+0x10,buckets);put(map+0x18,1);
+  put(buckets,entry);put(entry+0x10,17);put(entry+0x18,context);
+  put(context,nbcontextwait::kContextVtable);put(context+8,2,4);put(context+0x10,17,4);
+  if(pending)put(context+0x2f8,head);
+  const double target=99.0,drained=98.0;uint64_t bits=0;
+  std::memcpy(&bits,&target,8);put(head+0x10,bits);
+  std::memcpy(&bits,&drained,8);put(context+0x328,bits);
+  put(head+0x18,0x100006000);
+  if(dependencies){put(head+8,set);put(set+0x18,3);}
+ }
+ nbcontextwait::Snapshot capture() {
+  nbcontextwait::Snapshot out{};
+  nbcontextwait::capture(out,123,0,[this](uint64_t a,void *p,unsigned n){return read(a,p,n);},[this]{return now();});
+  return out;
+ }
+};
+int main() {
+ unsigned cases=0;
+ {
+  Memory m;auto s=m.capture();
+  assert(s.summary.flags==15 && s.summary.status==0 && s.summary.expected==1 && s.summary.visited==1);
+  assert(s.summary.contextIds[0]==17 && s.summary.selectedBits[0]==1 && s.summary.selected==1 && s.summary.emitted==1);
+  assert(s.states[0].flags==63 && s.states[0].status==0 && s.states[0].dependencyCount==3);
+  assert(s.states[0].parent==123 && s.states[0].id==((123ULL<<6)|1));++cases;
+ }
+ {
+  Memory m(true,false);auto s=m.capture();assert(s.states[0].flags==63 && !s.states[0].dependencyCount);++cases;
+ }
+ {
+  Memory m(false);auto s=m.capture();assert(s.summary.flags==15 && s.summary.visited==1 && !s.summary.selected && !s.summary.emitted);++cases;
+ }
+ {
+  Memory m(false);m.put(m.context+0x2e0,1);auto s=m.capture();
+  assert(s.summary.selected==1 && s.states[0].flags==63 && !s.states[0].head && s.states[0].localDeferredCount==1);++cases;
+ }
+ {
+  Memory m(false);m.put(m.context+0x1e0,0x100007000);auto s=m.capture();
+  assert(s.summary.selected==1 && s.states[0].flags==63 && !s.states[0].head && s.states[0].linkedContexts==0x100007000);++cases;
+ }
+ {
+  Memory m;m.put(m.slot,0);auto s=m.capture();assert(s.summary.status==nbcontextwait::NoRegistry && !(s.summary.flags&nbcontextwait::WalkComplete));++cases;
+ }
+ {
+  Memory m;m.put(m.context+0x10,18,4);auto s=m.capture();assert(s.summary.status==nbcontextwait::WrongContext && !s.summary.visited);++cases;
+ }
+ {
+  Memory m;m.put(m.context,nbcontextwait::kContextVtable+8);auto s=m.capture();assert(s.summary.status==nbcontextwait::WrongContext);++cases;
+ }
+ {
+  Memory m;m.put(m.context,nbcontextwait::kContextVtable|0x800000000000ULL);auto s=m.capture();assert(s.states[0].flags==63);++cases;
+ }
+ {
+  Memory m;m.changeRegistry=true;auto s=m.capture();assert(s.summary.status==nbcontextwait::Changed && !(s.summary.flags&nbcontextwait::RegistryRepeated));++cases;
+ }
+ {
+  Memory m;m.changeHead=true;auto s=m.capture();assert(s.states[0].status==nbcontextwait::Changed && !(s.states[0].flags&nbcontextwait::ContextRepeated));++cases;
+ }
+ {
+  Memory m;m.changeCount=true;auto s=m.capture();assert(s.states[0].status==nbcontextwait::Changed && !(s.states[0].flags&nbcontextwait::DependenciesRepeated));++cases;
+ }
+ {
+  Memory m;m.put(m.head+8,0x900000000);auto s=m.capture();assert(s.summary.selected==1 && s.states[0].status==nbcontextwait::ReadFailed && s.states[0].readKR==1);++cases;
+ }
+ {
+  Memory m;m.put(m.entry,m.entry);auto s=m.capture();assert(s.summary.status==nbcontextwait::Changed && !(s.summary.flags&nbcontextwait::WalkComplete));++cases;
+ }
+ {
+  Memory m;m.put(m.map,11,4);auto s=m.capture();assert(s.summary.status==nbcontextwait::ScopeLimit && !(s.summary.flags&nbcontextwait::WalkComplete));++cases;
+ }
+ {
+  Memory m;m.step=1001;auto s=m.capture();assert(s.summary.status==nbcontextwait::Budget && !(s.summary.flags&nbcontextwait::WalkComplete));++cases;
+ }
+ std::printf("context_wait_native_layout_cases=%u summary_bytes=%zu state_bytes=%zu\n",cases,sizeof(nbcontextwait::Summary),sizeof(nbcontextwait::State));
+}
