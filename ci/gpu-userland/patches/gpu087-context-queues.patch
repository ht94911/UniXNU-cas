diff --git a/NativeContextWaitState.h b/NativeContextWaitState.h
new file mode 100644
index 0000000..6160a78
--- /dev/null
+++ b/NativeContextWaitState.h
@@ -0,0 +1,146 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include "NativeDisplayWaitState.h"
+
+// Original24A446 Render::Context registry and drain_deferred fields. Read the
+// existing objects; never retain, drain, signal, or call the native registry.
+// The existing sampler checks a one-millisecond budget between contexts;
+// one slow Mach read or preemption can overrun it. Repeated reads are not atomic.
+namespace nbcontextwait {
+constexpr uint64_t kRegistrySlot=0x1e3fda440ULL,kContextVtable=0x1e9000b40ULL;
+constexpr unsigned kSummaryKind=37,kContextKind=36;
+constexpr unsigned kMaxContexts=256,kMaxPending=32,kMaxBuckets=1024,kBudgetUs=1000;
+enum Status:uint32_t { Complete=0,NoRegistry=1,ReadFailed=2,WrongContext=3,
+                       Changed=4,ScopeLimit=5,Budget=6 };
+enum SummaryFlags:uint32_t { RegistryRead=1,BucketsRead=2,WalkComplete=4,
+                             RegistryRepeated=8,SameCopyAtEnd=16 };
+enum ContextFlags:uint32_t { ContextRead=1,HeadRead=2,DependenciesRead=4,
+                             HeadRepeated=8,DependenciesRepeated=16,ContextRepeated=32 };
+struct Summary {
+ uint32_t version=1,bytes=1152;
+ uint64_t id=0,beganUs=0,endedUs=0,slot=0,registry=0,buckets=0,confirmRegistry=0;
+ uint32_t exponent=0,expected=0,visited=0,selected=0,emitted=0,flags=0,status=Complete;
+ int32_t readKR=-1;
+ uint32_t contextIds[kMaxContexts]{};
+ uint32_t selectedBits[kMaxContexts/32]{};
+};
+struct State {
+ uint32_t version=1,bytes=176;
+ uint64_t id=0,parent=0,beganUs=0,endedUs=0,context=0,vtable=0,head=0,dependencies=0,stream=0;
+ uint64_t targetTimeBits=0,drainedTimeBits=0,dependencyCount=0,confirmHead=0,confirmStream=0,confirmCount=0;
+ uint32_t contextId=0,contextFlags=0,referenceCount=0,flags=0,status=Complete;
+ int32_t readKR=-1;
+ uint32_t confirmContextId=0,reserved=0;
+ // needs_defer_update_locked separately tests [Context+0x2e0] and traverses
+ // [Context+0x1e0]. An empty command head does not exclude that path.
+ uint64_t localDeferredCount=0,linkedContexts=0;
+};
+static_assert(sizeof(Summary)==1152,"context registry summary wire size");
+static_assert(sizeof(State)==176,"deferred Context state wire size");
+struct Snapshot { Summary summary{};State states[kMaxPending]{}; };
+inline uint32_t word32(const uint64_t *data,unsigned offset) {
+ uint32_t value=0;std::memcpy(&value,(const unsigned char *)data+offset,sizeof(value));return value;
+}
+inline uint64_t word64(const uint64_t *data,unsigned offset) {
+ uint64_t value=0;std::memcpy(&value,(const unsigned char *)data+offset,sizeof(value));return value;
+}
+template<class Read,class Clock> inline void captureState(State &s,const uint64_t *core,
+                                                         int64_t slide,Read read,Clock now) {
+ s.beganUs=now();s.flags=ContextRead;
+ s.vtable=core[0];s.contextId=word32(core,0x10);s.referenceCount=word32(core,8);
+ s.contextFlags=word32(core,0xc);s.head=word64(core,0x2f8);s.drainedTimeBits=word64(core,0x328);
+ s.localDeferredCount=word64(core,0x2e0);s.linkedContexts=word64(core,0x1e0);
+ uint64_t head[4]{},confirm[4]{},again[0x330/8]{};
+ if(s.head) {
+  s.readKR=read(s.head,head,sizeof(head));
+  if(s.readKR){s.status=ReadFailed;s.endedUs=now();return;}
+ }
+ s.flags|=HeadRead;s.dependencies=head[1];s.targetTimeBits=head[2];s.stream=head[3];
+ if(s.dependencies) {
+  s.readKR=read(s.dependencies+0x18,&s.dependencyCount,sizeof(s.dependencyCount));
+  if(s.readKR){s.status=ReadFailed;s.endedUs=now();return;}
+ }
+ s.flags|=DependenciesRead;
+ if(s.head) {
+  s.readKR=read(s.head,confirm,sizeof(confirm));
+  if(s.readKR){s.status=ReadFailed;s.endedUs=now();return;}
+ }
+ s.confirmStream=confirm[3];
+ if(confirm[1]==head[1] && confirm[2]==head[2] && confirm[3]==head[3])s.flags|=HeadRepeated;
+ if(s.dependencies) {
+  s.readKR=read(s.dependencies+0x18,&s.confirmCount,sizeof(s.confirmCount));
+  if(s.readKR){s.status=ReadFailed;s.endedUs=now();return;}
+ }
+ if(s.dependencyCount==s.confirmCount)s.flags|=DependenciesRepeated;
+ s.readKR=read(s.context,again,sizeof(again));
+ if(s.readKR){s.status=ReadFailed;s.endedUs=now();return;}
+ s.confirmHead=word64(again,0x2f8);s.confirmContextId=word32(again,0x10);
+ if(nbdisplaywait::stripped(again[0])==uint64_t(int64_t(kContextVtable)+slide) &&
+    s.confirmContextId==s.contextId && word32(again,8) &&
+    word32(again,0xc)==s.contextFlags && s.confirmHead==s.head &&
+    word64(again,0x328)==s.drainedTimeBits && word64(again,0x2e0)==s.localDeferredCount &&
+    word64(again,0x1e0)==s.linkedContexts)
+  s.flags|=ContextRepeated;
+ if(s.flags!=63)s.status=Changed;
+ s.endedUs=now();
+}
+template<class Read,class Clock> inline void capture(Snapshot &out,uint64_t id,int64_t slide,
+                                                     Read read,Clock now) {
+ Summary &s=out.summary;s.id=id;s.beganUs=now();s.slot=uint64_t(int64_t(kRegistrySlot)+slide);
+ s.readKR=read(s.slot,&s.registry,sizeof(s.registry));
+ if(s.readKR){s.status=ReadFailed;s.endedUs=now();return;}
+ if(!s.registry){s.status=NoRegistry;s.endedUs=now();return;}
+ uint64_t registry[4]{},confirm[4]{},buckets[kMaxBuckets]{},nodes[kMaxContexts]{};
+ s.readKR=read(s.registry,registry,sizeof(registry));
+ if(s.readKR){s.status=ReadFailed;s.endedUs=now();return;}
+ s.flags|=RegistryRead;s.exponent=word32(registry,0);s.buckets=registry[2];
+ if(s.exponent>10 || registry[3]>UINT32_MAX){s.status=ScopeLimit;s.endedUs=now();return;}
+ s.expected=(uint32_t)registry[3];const unsigned bucketCount=1u<<s.exponent;
+ if(s.expected) {
+  s.readKR=read(s.buckets,buckets,bucketCount*sizeof(uint64_t));
+  if(s.readKR){s.status=ReadFailed;s.endedUs=now();return;}
+ }
+ s.flags|=BucketsRead;bool walked=true;
+ for(unsigned b=0;b<bucketCount && walked;++b) {
+  uint64_t node=buckets[b];
+  while(node) {
+   if(now()-s.beganUs>=kBudgetUs){s.status=Budget;walked=false;break;}
+   if(s.visited>=kMaxContexts){s.status=ScopeLimit;walked=false;break;}
+   bool duplicate=false;
+   for(unsigned n=0;n<s.visited;++n)if(nodes[n]==node){duplicate=true;break;}
+   if(duplicate){s.status=Changed;walked=false;break;}
+   uint64_t entry[4]{},core[0x330/8]{};
+   s.readKR=read(node,entry,sizeof(entry));
+   if(s.readKR){s.status=ReadFailed;walked=false;break;}
+   nodes[s.visited]=node;
+   s.readKR=read(entry[3],core,sizeof(core));
+   if(s.readKR){s.status=ReadFailed;walked=false;break;}
+   const uint32_t cid=word32(core,0x10);
+   if(!cid || entry[2]!=cid || !word32(core,8) ||
+      nbdisplaywait::stripped(core[0])!=uint64_t(int64_t(kContextVtable)+slide)) {
+    s.status=WrongContext;walked=false;break;
+   }
+   const unsigned at=s.visited++;s.contextIds[at]=cid;
+   if(word64(core,0x2f8) || word64(core,0x2e0) || word64(core,0x1e0) || (word32(core,0xc)&0x400)) {
+    s.selectedBits[at/32]|=1u<<(at%32);++s.selected;
+    if(s.emitted<kMaxPending) {
+     State &state=out.states[s.emitted++];state.parent=id;state.id=(id<<6)|s.emitted;state.context=entry[3];
+     captureState(state,core,slide,read,now);
+    } else s.status=ScopeLimit;
+   }
+   node=entry[0];
+  }
+ }
+ if(walked && s.visited==s.expected)s.flags|=WalkComplete;
+ else if(s.status==Complete)s.status=Changed;
+ s.readKR=read(s.slot,&s.confirmRegistry,sizeof(s.confirmRegistry));
+ if(!s.readKR && s.confirmRegistry==s.registry) {
+  s.readKR=read(s.registry,confirm,sizeof(confirm));
+  if(!s.readKR && confirm[0]==registry[0] && confirm[2]==registry[2] && confirm[3]==registry[3])
+   s.flags|=RegistryRepeated;
+ }
+ if(s.readKR && s.status==Complete)s.status=ReadFailed;
+ if(!(s.flags&RegistryRepeated) && s.status==Complete)s.status=Changed;
+ s.endedUs=now();
+}
+} // namespace nbcontextwait
