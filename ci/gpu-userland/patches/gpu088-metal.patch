diff --git a/bridge/extern_function_host.mm b/bridge/extern_function_host.mm
new file mode 100644
index 0000000..44b5ee3
--- /dev/null
+++ b/bridge/extern_function_host.mm
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: MIT
+// Compile the production frontend in this translation unit so the test invokes
+// NBLibrary's real Objective-C methods and retains its real kernel-function owner.
+#import "../NativeBridgeMetalFrontend.mm"
+#include <cassert>
+
+@protocol NBExternFunctionLookup
+- (id<MTLFunction>)newExternFunctionWithName:(NSString *)name;
+@end
+
+static NSMutableData *kernelLibraryFixture() {
+    std::vector<uint8_t> entry(4);
+    auto tag = [&](const char *name, const void *bytes, uint16_t length) {
+        entry.insert(entry.end(), name, name + 4);
+        entry.push_back((uint8_t)length);
+        entry.push_back((uint8_t)(length >> 8));
+        const auto *p = (const uint8_t *)bytes;
+        entry.insert(entry.end(), p, p + length);
+    };
+    const char name[] = "kernel_fixture";
+    const uint8_t type = 5;
+    const uint64_t bitcodeSize = 8, offsets[3] = {};
+    tag("NAME", name, sizeof name);
+    tag("TYPE", &type, sizeof type);
+    tag("MDSZ", &bitcodeSize, sizeof bitcodeSize);
+    tag("OFFT", offsets, sizeof offsets);
+    entry.insert(entry.end(), {'E', 'N', 'D', 'T'});
+    const uint32_t size = (uint32_t)entry.size(), count = 1;
+    memcpy(entry.data(), &size, sizeof size);
+    NSMutableData *data = [NSMutableData dataWithLength:88];
+    uint8_t *head = (uint8_t *)data.mutableBytes;
+    memcpy(head, "MTLB", 4);
+    head[10] = 1;
+    const uint64_t list = 88, bitcode = list + sizeof count + entry.size();
+    memcpy(head + 24, &list, sizeof list);
+    memcpy(head + 72, &bitcode, sizeof bitcode);
+    memcpy(head + 80, &bitcodeSize, sizeof bitcodeSize);
+    [data appendBytes:&count length:sizeof count];
+    [data appendBytes:entry.data() length:entry.size()];
+    const uint8_t payload[8] = {'B', 'C', 0xc0, 0xde, 1, 2, 3, 4};
+    [data appendBytes:payload length:sizeof payload];
+    return data;
+}
+
+@interface NBDispatchForwardingCheck : NBLibrary
+@property(nonatomic) NSUInteger calls;
+@property(nonatomic,strong) NSString *lastName;
+@property(nonatomic,strong) NBFunction *answer;
+@end
+@implementation NBDispatchForwardingCheck
+- (id<MTLFunction>)newFunctionWithName:(NSString *)name {
+    self.calls++;
+    self.lastName = name;
+    return [name isEqualToString:@"ordinary"] ? (id<MTLFunction>)self.answer : nil;
+}
+@end
+
+int main() {
+    @autoreleasepool {
+        const SEL external = @selector(newExternFunctionWithName:);
+        if (!class_getInstanceMethod([NBLibrary class], external)) {
+            puts("FAIL missing production newExternFunctionWithName:");
+            return 1;
+        }
+        unsigned cases = 0;
+        __weak NBLibrary *weakLibrary;
+        __weak NSData *weakStorage;
+        __attribute__((objc_precise_lifetime)) NBFunction *kept;
+        @autoreleasepool {
+            NSMutableData *storage = kernelLibraryFixture();
+            NBLibrary *library = [NBLibrary new];
+            library.storage = storage;
+            library.bytes = (const uint8_t *)storage.bytes;
+            library.length = storage.length;
+            weakLibrary = library;
+            weakStorage = storage;
+            assert([[library externFunctionNames] isEqualToArray:@[@"kernel_fixture"]]); ++cases;
+            kept = (NBFunction *)[(id<NBExternFunctionLookup>)library newExternFunctionWithName:@"kernel_fixture"];
+            assert(kept && kept.functionType == 4 && kept.handle == nullptr); ++cases;
+            assert(kept.library == library && [kept.sourceName isEqualToString:@"kernel_fixture"]); ++cases;
+            NSData *bitcode = functionBitcode(kept);
+            assert(bitcode.length == 8 && !memcmp(bitcode.bytes, "BC\xc0\xde", 4)); ++cases;
+        }
+        assert(weakLibrary && weakStorage); ++cases;
+        kept = nil;
+        assert(!weakLibrary && !weakStorage); ++cases;
+
+        NBDispatchForwardingCheck *proxy = [NBDispatchForwardingCheck new];
+        proxy.answer = [NBFunction new];
+        assert([(id<NBExternFunctionLookup>)proxy newExternFunctionWithName:@"ordinary"] == (id<MTLFunction>)proxy.answer); ++cases;
+        assert(proxy.calls == 1 && [proxy.lastName isEqualToString:@"ordinary"]); ++cases;
+        assert([(id<NBExternFunctionLookup>)proxy newExternFunctionWithName:@"absent"] == nil); ++cases;
+        assert(proxy.calls == 2 && [proxy.lastName isEqualToString:@"absent"]); ++cases;
+        assert([(id<NBExternFunctionLookup>)proxy newExternFunctionWithName:nil] == nil); ++cases;
+        assert(proxy.calls == 3 && proxy.lastName == nil); ++cases;
+        printf("PASS extern lookup: %u actual production selector, kernel ownership, bitcode and forwarding checks\n", cases);
+    }
+    return 0;
+}
