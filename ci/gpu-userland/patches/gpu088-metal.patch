+   []{return mach_absolute_time();});
+  traceWaitBytes(nbdisplaywait::kTimingRecordKind,sampleId,&timing,sizeof(timing));
+#if defined(NATIVE_METAL_IPHONE24A446) && defined(__arm64e__)
