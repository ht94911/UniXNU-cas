+  nbcontextwait::capture(contexts,sampleId,gObservedQuartzSlide,readObserverMemory,nowUs);
+  if(gRenderWaitCopyUs.load(std::memory_order_acquire)==copy)contexts.summary.flags|=nbcontextwait::SameCopyAtEnd;
+  traceWaitBytes(nbcontextwait::kSummaryKind,sampleId,&contexts.summary,sizeof(contexts.summary));
+  for(unsigned i=0;i<contexts.summary.emitted;++i)
+   traceWaitBytes(nbcontextwait::kContextKind,contexts.states[i].id,&contexts.states[i],sizeof(contexts.states[i]));
+#endif
+ }
+}
+#if defined(NATIVE_METAL_IPHONE24A446)
+static nbuiwait::Layout prepareUIUpdateObserver() {
+ nbuiwait::Layout layout{};
+#if defined(__arm64e__)
+ for(uint32_t i=0;i<std::min<uint32_t>(_dyld_image_count(),1024);++i) {
+  const char *name=_dyld_get_image_name(i);const mach_header *header=_dyld_get_image_header(i);
+  if(!name || !header || header->magic!=MH_MAGIC_64)continue;
+  const bool ui=!strcmp(name,"/System/Library/PrivateFrameworks/UIKitCore.framework/UIKitCore");
+  const bool uc=!strcmp(name,"/System/Library/PrivateFrameworks/UpdateCycle.framework/UpdateCycle");
+  if(!ui && !uc)continue;
+  const uint8_t *commands=(const uint8_t *)header+sizeof(mach_header_64);size_t at=0;
+  for(uint32_t j=0;j<header->ncmds && at+sizeof(load_command)<=header->sizeofcmds;++j) {
+   const auto *lc=(const load_command *)(commands+at);
+   if(lc->cmdsize<sizeof(load_command) || lc->cmdsize>header->sizeofcmds-at)break;
+   if(lc->cmd==LC_UUID && lc->cmdsize>=sizeof(uuid_command)) {
+    if(nbuiwait::imageUUIDMatches(((const uuid_command *)lc)->uuid,ui)) {
+     if(ui){layout.uiHeader=(uintptr_t)header;layout.uiSlide=_dyld_get_image_vmaddr_slide(i);}
+     else {layout.ucHeader=(uintptr_t)header;layout.ucSlide=_dyld_get_image_vmaddr_slide(i);}
+    }
+    break;
+   }
+   at+=lc->cmdsize;
+  }
+ }
+#endif
+ return layout;
+}
+#endif
+static void startClientWaitSampler() {
+ if(!clientWaitOn())return;
+ std::thread([] {
+  pthread_setname_np("ui-main-wait-sample");
+  (void)pthread_set_qos_class_self_np(QOS_CLASS_UTILITY,0);
+  traceRenderWaitImages(true);
+  using MainThread=pthread_t (*)(void);
+  const auto mainFunction=(MainThread)dlsym(RTLD_DEFAULT,"pthread_main_thread_np");
+  const pthread_t main=mainFunction?mainFunction():nullptr;
+  uint64_t tid=0;
+  thread_t port=main?pthread_mach_thread_np(main):MACH_PORT_NULL;
+  const bool retained=port!=MACH_PORT_NULL && mach_port_mod_refs(mach_task_self(),port,MACH_PORT_RIGHT_SEND,1)==KERN_SUCCESS;
+  const bool identified=main && !pthread_threadid_np(main,&tid);
+  traceProcessIdentity(true,tid);
+  if(!retained || !identified) {
+   nbwait::Sample failure{};failure.version=nbwait::kVersion;failure.bytes=sizeof(failure);
+   failure.tid=tid;failure.beganUs=failure.endedUs=nowUs();failure.stop=nbwait::NoRegisters;
+   failure.stateKr=KERN_INVALID_ARGUMENT;traceWaitBytes(27,0,&failure,sizeof(failure),true);
+   if(retained)mach_port_deallocate(mach_task_self(),port);
+   return;
+  }
+  const uint64_t high=(uintptr_t)pthread_get_stackaddr_np(main),size=pthread_get_stacksize_np(main);
+  const uint64_t low=size<=high?high-size:0;
+#if defined(NATIVE_METAL_IPHONE24A446)
+  const bool observeUIUpdate=!strcmp(getprogname(),"SpringBoard");
+  if(observeUIUpdate)enableOriginalContextSignposts();
+  const nbuiwait::Layout uiLayout=observeUIUpdate?prepareUIUpdateObserver():nbuiwait::Layout{};nbuiwait::Binding uiBinding{};
+  if(observeUIUpdate)native_bridge_metal_note(uiLayout.valid()?"ui-wait update deadlines images=1":"ui-wait update deadlines images=0");
+#endif
+  TraceRec name{};name.type=4;name.tid=(uint32_t)tid;
+  pthread_getname_np(main,(char *)&name.t0,24);traceSamplePush(name);
+  // One actual UI main thread, requested20ms cadence, at most30minutes. This is a
+  // separate process file with a boot UUID; no other process's rings are read.
+  constexpr uint64_t maximumSamples=90000,maximumDurationUs=1800000000;
+  const uint64_t began=nowUs();uint64_t samples=0;
+  char note[128];snprintf(note,sizeof(note),"ui-wait begin tid=%llu uptime_us=%llu budget_s=1800 max=90000",
+   (unsigned long long)tid,(unsigned long long)began);native_bridge_metal_note(note);
+  for(;samples<maximumSamples && nowUs()-began<maximumDurationUs;) {
+   usleep(20000);
+   nbwait::Sample sample{};sample.id=++samples;sample.tid=tid;sample.stackLow=low;sample.stackHigh=high;
+   nbwait::capture(port,sample,nowUs);traceWaitBytes(27,sample.id,&sample,sizeof(sample),true);
+#if defined(NATIVE_METAL_IPHONE24A446)
+   if(observeUIUpdate) {
+    nbuiwait::Anchor anchors[nbwait::kFrames]{};
+    const unsigned n=std::min<unsigned>(sample.depth,nbwait::kFrames);
+    for(unsigned i=0;i<n;++i)anchors[i]={sample.frames[i].fp,sample.frames[i].lr,
+     i?sample.frames[i-1].lr:sample.first.pc};
+    nbuiwait::bind(uiBinding,uiLayout,anchors,n,sample.stackLow,sample.stackHigh,sample.beganUs,readObserverMemory);
+    nbuiwait::State state{};state.id=sample.id;
+    nbuiwait::capture(state,uiBinding,uiLayout,readObserverMemory,nowUs,[]{return mach_absolute_time();});
+    traceWaitBytes(nbuiwait::kRecordKind,sample.id,&state,sizeof(state),true);
+   }
+   // Counters describe actual use of the existing index, once per second in
+   // the original record stream. No timing query on each icon lookup.
+   if(!strcmp(getprogname(),"SpringBoard") && !(samples%50)) {
+    TraceRec count{};count.type=33;count.t0=nowUs();
+    count.t1=nbiconlibrary::indexedViews.load(std::memory_order_relaxed);
+    count.t2=nbiconlibrary::originalViews.load(std::memory_order_relaxed);
+    count.t3=nbiconlibrary::indexedVisibility.load(std::memory_order_relaxed);
+    count.a=(uint32_t)nbiconlibrary::originalVisibility.load(std::memory_order_relaxed);
+    traceSamplePush(count);
+   }
+#endif
+  }
+  nbwait::Sample end{};end.version=nbwait::kVersion;end.bytes=sizeof(end);end.id=++samples;end.tid=tid;
+  end.beganUs=end.endedUs=nowUs();end.stop=nbwait::BudgetExhausted;traceWaitBytes(27,end.id,&end,sizeof(end),true);
+  snprintf(note,sizeof(note),"ui-wait end samples=%llu uptime_us=%llu",
+   (unsigned long long)samples,(unsigned long long)end.endedUs);native_bridge_metal_note(note);
+  mach_port_deallocate(mach_task_self(),port);
+ }).detach();
+}
diff --git a/NativeIconLibraryIndex.h b/NativeIconLibraryIndex.h
new file mode 100644
index 0000000..d7f5157
--- /dev/null
+++ b/NativeIconLibraryIndex.h
@@ -0,0 +1,172 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+
+#include <dlfcn.h>
+#include <mach-o/loader.h>
+#include <objc/message.h>
+#include <objc/runtime.h>
+#include <pthread.h>
+#include <atomic>
+#include <cstring>
+#if defined(__arm64e__)
+#include <ptrauth.h>
+#endif
+
+// The iPhone 24A446 App Library already has a diffable data source indexed by
+// the query's item identifier. Its original icon-view lookup instead asks the
+// query to collate the icon again and search its section and item arrays. Use
+// the data source's current index for view and visibility lookups; retain the
+// original path when the item is absent or the query changes during lookup.
+@interface NSObject (NBIconLibraryIndexMethods)
+- (id)dataSource;
+- (id)queryResult;
+- (id)itemIdentifierForIcon:(id)icon;
+- (id)indexPathForItemIdentifier:(id)identifier;
+- (id)itemIdentifierForIndexPath:(id)indexPath;
+- (id)_iconViewAtIndexPath:(id)indexPath;
+- (id)icon;
+- (BOOL)_isViewControllerVisible;
+- (BOOL)_isIndexPathVisible:(id)indexPath;
+@end
+
+namespace nbiconlibrary {
+using IconViewForIcon = id (*)(id, SEL, id);
+using IsDisplayingIconView = BOOL (*)(id, SEL, id);
+using MethodOrigin = bool (*)(Method, const uint8_t *);
+static IconViewForIcon originalIconViewForIcon;
+static IsDisplayingIconView originalIsDisplayingIconView;
+static Class iconViewClass;
+static Class dataSourceClass;
+static Class queryClass;
+static std::atomic<uint64_t> indexedViews{0}, indexedVisibility{0}, originalViews{0}, originalVisibility{0};
+
+constexpr uint8_t kSpringBoardHomeUUID[16] = {
+    0x2c,0xf7,0xa8,0xa1,0xe2,0xe3,0x35,0xb3,
+    0x81,0x25,0xd0,0x7d,0x6f,0x7d,0xd6,0x38
+};
+constexpr uint8_t kUIKitUUID[16] = {
+    0xaa,0xc8,0x4a,0x00,0x13,0xab,0x3b,0x06,
+    0xb6,0x22,0xa4,0xe6,0x76,0x97,0x1e,0xb8
+};
+
+static inline bool methodInImage(Method method, const uint8_t *uuid) {
+    if (!method) return false;
+    IMP implementation = method_getImplementation(method);
+#if defined(__arm64e__)
+    implementation = (IMP)ptrauth_strip(implementation, ptrauth_key_function_pointer);
+#endif
+    Dl_info info{};
+    if (!dladdr((const void *)implementation, &info) || !info.dli_fbase) return false;
+    const auto *header = (const mach_header_64 *)info.dli_fbase;
+    if (header->magic != MH_MAGIC_64) return false;
+    const auto *commands = (const uint8_t *)(header + 1);
+    size_t offset = 0;
+    for (uint32_t i = 0; i < header->ncmds && offset + sizeof(load_command) <= header->sizeofcmds; ++i) {
+        const auto *command = (const load_command *)(commands + offset);
+        if (command->cmdsize < sizeof(load_command) || command->cmdsize > header->sizeofcmds - offset) return false;
+        if (command->cmd == LC_UUID && command->cmdsize >= sizeof(uuid_command))
+            return !std::memcmp(((const uuid_command *)command)->uuid, uuid, 16);
+        offset += command->cmdsize;
+    }
+    return false;
+}
+
+struct CurrentIndex { id path = nil, dataSource = nil, query = nil; };
+static CurrentIndex currentIndexPath(id controller, id icon) {
+    CurrentIndex result;
+    if (!pthread_main_np() || !icon) return result;
+    id dataSource = [controller dataSource];
+    if (![dataSource isKindOfClass:dataSourceClass]) return result;
+    id query = [dataSource queryResult];
+    if (![query isKindOfClass:queryClass]) return result;
+    id identifier = [query itemIdentifierForIcon:icon];
+    if (identifier) {
+        id indexPath = [dataSource indexPathForItemIdentifier:identifier];
+        id indexedIdentifier = indexPath ? [dataSource itemIdentifierForIndexPath:indexPath] : nil;
+        if (indexPath && (indexedIdentifier == identifier || [indexedIdentifier isEqual:identifier]) &&
+            [controller dataSource] == dataSource && [dataSource queryResult] == query)
+            return {indexPath, dataSource, query};
+    }
+    return result;
+}
+
+static id iconViewForIcon(id controller, SEL command, id icon) {
+    CurrentIndex current = currentIndexPath(controller, icon);
+    if (current.path) {
+        id view = [controller _iconViewAtIndexPath:current.path];
+        if ([view isKindOfClass:iconViewClass] && [view icon] == icon &&
+            [controller dataSource] == current.dataSource && [current.dataSource queryResult] == current.query) {
+            indexedViews.fetch_add(1, std::memory_order_relaxed);
+            return view;
+        }
+    }
+    originalViews.fetch_add(1, std::memory_order_relaxed);
+    return originalIconViewForIcon(controller, command, icon);
+}
+
+static BOOL isDisplayingIconView(id controller, SEL command, id view) {
+    if (pthread_main_np() && [view isKindOfClass:iconViewClass]) {
+        // Preserve the original controller visibility gate and the original
+        // _isIndexPathVisible: test. Only the intervening index lookup changes.
+        if (![controller _isViewControllerVisible]) return NO;
+        CurrentIndex current = currentIndexPath(controller, [view icon]);
+        if (current.path) {
+            const BOOL visible = [controller _isIndexPathVisible:current.path];
+            if ([controller dataSource] == current.dataSource && [current.dataSource queryResult] == current.query) {
+                indexedVisibility.fetch_add(1, std::memory_order_relaxed);
+                return visible;
+            }
+        }
+    }
+    originalVisibility.fetch_add(1, std::memory_order_relaxed);
+    return originalIsDisplayingIconView(controller, command, view);
+}
+
+// The origin argument is supplied by the production image check. The existing
+// host fixture supplies its own method origins so the same installation and
+// lookup bodies can run with real Objective-C classes on macOS.
+static bool install(MethodOrigin origin = methodInImage) {
+    if (originalIconViewForIcon && originalIsDisplayingIconView) return true;
+    Class controller = objc_getClass("SBHIconLibraryTableViewController");
+    Class dataSource = objc_getClass("SBHIconTableViewDiffableDataSource");
+    Class query = objc_getClass("SBHIconLibraryQueryResult");
+    Class view = objc_getClass("SBIconView");
+    if (!controller || !dataSource || !query || !view) return false;
+    struct Required { Class owner; const char *name; unsigned arguments; const uint8_t *uuid; bool boolean = false; };
+    const Required required[] = {
+        {controller, "_iconViewForIcon:", 3, kSpringBoardHomeUUID},
+        {controller, "dataSource", 2, kSpringBoardHomeUUID},
+        {controller, "_iconViewAtIndexPath:", 3, kSpringBoardHomeUUID},
+        {controller, "isDisplayingIconView:", 3, kSpringBoardHomeUUID, true},
+        {controller, "_isViewControllerVisible", 2, kSpringBoardHomeUUID, true},
+        {controller, "_isIndexPathVisible:", 3, kSpringBoardHomeUUID, true},
+        {dataSource, "queryResult", 2, kSpringBoardHomeUUID},
+        {query, "itemIdentifierForIcon:", 3, kSpringBoardHomeUUID},
+        {dataSource, "indexPathForItemIdentifier:", 3, kUIKitUUID},
+        {dataSource, "itemIdentifierForIndexPath:", 3, kUIKitUUID},
+        {view, "icon", 2, kSpringBoardHomeUUID}
+    };
+    for (const auto &entry : required) {
+        Method method = class_getInstanceMethod(entry.owner, sel_registerName(entry.name));
+        char result[8]{};
+        if (!method || method_getNumberOfArguments(method) != entry.arguments || !origin(method, entry.uuid)) return false;
+        method_getReturnType(method, result, sizeof(result));
+        if (entry.boolean ? (result[0] != 'B' && result[0] != 'c' && result[0] != 'C') : result[0] != '@') return false;
+        if (entry.arguments == 3) {
+            char argument[8]{};
+            method_getArgumentType(method, 2, argument, sizeof(argument));
+            if (argument[0] != '@') return false;
+        }
+    }
+    Method method = class_getInstanceMethod(controller, sel_registerName("_iconViewForIcon:"));
+    iconViewClass = view;
+    dataSourceClass = dataSource;
+    queryClass = query;
+    originalIconViewForIcon = (IconViewForIcon)method_getImplementation(method);
+    Method visibility = class_getInstanceMethod(controller, sel_registerName("isDisplayingIconView:"));
+    originalIsDisplayingIconView = (IsDisplayingIconView)method_getImplementation(visibility);
+    method_setImplementation(method, (IMP)iconViewForIcon);
+    method_setImplementation(visibility, (IMP)isDisplayingIconView);
+    return true;
+}
+}
diff --git a/NativeLongLatency.h b/NativeLongLatency.h
new file mode 100644
index 0000000..b4cd552
--- /dev/null
+++ b/NativeLongLatency.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: MIT */
+// Slow command boundaries use the existing GPU problem channel. Times are the
+// current process's monotonic microseconds, not console print timestamps.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+
+namespace nblonglatency {
+constexpr uint64_t commandThresholdUs=100000;
+constexpr uint64_t apiThresholdUs=16000;
+
+template<class Emit> inline void producerGap(uint64_t id,uint32_t thread,
+ uint64_t previousCommit,uint64_t created,uint64_t committed,Emit emit) {
+ if(!previousCommit || previousCommit>created || created>committed ||
+    created-previousCommit<commandThresholdUs)return;
+ static std::atomic<unsigned> notes{0};
+ if(notes.fetch_add(1,std::memory_order_relaxed)>=4096)return;
+ char text[89];
+ snprintf(text,sizeof text,"lg0 i=%llu t=%u b=%llu c=%llu",(unsigned long long)id,thread,
+  (unsigned long long)previousCommit,(unsigned long long)created);emit(text);
+ snprintf(text,sizeof text,"lg1 i=%llu m=%llu",(unsigned long long)id,
+  (unsigned long long)committed);emit(text);
+}
+
+struct Command {
+ uint64_t id,created,committed,scheduled,callback,handlersBegan,handlersEnded;
+ uint32_t creator,committer,creatorCpu,commitCpu,passes,draws;
+};
+
+template<class Emit> inline void command(const Command &row,Emit emit) {
+ if(!row.created || row.created>row.committed || row.committed>row.callback ||
+    row.callback>row.handlersBegan || row.handlersBegan>row.handlersEnded ||
+    (row.scheduled && (row.scheduled<row.committed || row.scheduled>row.callback)) ||
+    row.handlersEnded-row.created<commandThresholdUs)return;
+ static std::atomic<unsigned> notes{0};
+ if(notes.fetch_add(1,std::memory_order_relaxed)>=4096)return;
+ char text[89];
+ snprintf(text,sizeof text,"lf0 i=%llu t=%u c=%u u=%llu",
+  (unsigned long long)row.id,row.creator,row.committer,(unsigned long long)row.created);emit(text);
+ snprintf(text,sizeof text,"lf1 i=%llu m=%llu s=%llu",
+  (unsigned long long)row.id,(unsigned long long)row.committed,(unsigned long long)row.scheduled);emit(text);
+ snprintf(text,sizeof text,"lf2 i=%llu g=%llu a=%llu",
+  (unsigned long long)row.id,(unsigned long long)row.callback,(unsigned long long)row.handlersBegan);emit(text);
+ snprintf(text,sizeof text,"lf3 i=%llu z=%llu p=%u d=%u",
+  (unsigned long long)row.id,(unsigned long long)row.handlersEnded,row.passes,row.draws);emit(text);
+ snprintf(text,sizeof text,"lf4 i=%llu x=%u y=%u",
+  (unsigned long long)row.id,row.creatorCpu,row.commitCpu);emit(text);
+}
+
+template<class Emit> inline void api(uint64_t id,uint32_t thread,uint64_t began,
+ uint64_t ended,uint64_t function,uint64_t cpu,bool cpuValid,Emit emit) {
+ if(!began || ended<began || ended-began<apiThresholdUs)return;
+ static std::atomic<unsigned> notes{0};
+ if(notes.fetch_add(1,std::memory_order_relaxed)>=4096)return;
+ char text[89];
+ snprintf(text,sizeof text,"ls0 i=%llu t=%u b=%llu e=%llu",(unsigned long long)id,thread,
+  (unsigned long long)began,(unsigned long long)ended);emit(text);
+ snprintf(text,sizeof text,"ls1 i=%llu f=%llx q=%llu v=%u",(unsigned long long)id,
+  (unsigned long long)function,(unsigned long long)cpu,unsigned(cpuValid));emit(text);
+ snprintf(text,sizeof text,"ls2 i=%llu n=%.54s",(unsigned long long)id,
+  function?reinterpret_cast<const char *>(uintptr_t(function)):"?");emit(text);
+}
+}
