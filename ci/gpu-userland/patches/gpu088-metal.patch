new file mode 100644
index 0000000..1a03b52
--- /dev/null
+++ b/NativeRenderWaitSample.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_RENDER_WAIT_SAMPLE_H
+#define NATIVE_RENDER_WAIT_SAMPLE_H
+
+#include <cstdint>
+#include <cstring>
+#if defined(__APPLE__)
+#include <mach/mach.h>
+#include <mach/thread_status.h>
+#include <pthread.h>
+// The iOS SDK hides mach_vm.h; use the same explicit Mach declaration pattern
+// as the frontend's existing mach_vm_region reader. Signature: mach_vm.defs.
+extern "C" kern_return_t mach_vm_read_overwrite(vm_map_read_t,mach_vm_address_t,
+                                               mach_vm_size_t,mach_vm_address_t,mach_vm_size_t *);
+#if defined(__arm64e__)
+#include <ptrauth.h>
+#endif
+#endif
+
+// Kept in the existing frame file. A sample is an observation, not a wait span:
+// thread_get_state temporarily stops the target internally, and stack reads
+// occur after it has resumed. Matching registers before/after are reported;
+// they do not make the intervening stack an atomic snapshot.
+namespace nbwait {
+constexpr unsigned kFrames=16;
+constexpr uint32_t kVersion=2;
+constexpr unsigned kIntegerRegisters=14;
+constexpr uint32_t kThresholdsUs[]={25000,60000,110000,180000};
+constexpr unsigned kSampleBudget=6144;
+// A process-lifetime budget was spent during startup, leaving the formal
+// gestures without display stacks. Keep the same records and thresholds, but
+// bound their rate over the existing 30-minute observer lifetime.
+struct WindowBudget {
+ uint64_t beganUs=0;
+ unsigned used=0;
+ bool initialized=false;
+ bool take(uint64_t now,unsigned limit) {
+  if(!initialized || now<beganUs || now-beganUs>=1000000) {initialized=true;beganUs=now;used=0;}
+  if(used>=limit)return false;
+  ++used;return true;
+ }
+};
+enum : uint32_t {
+ BasicValid=1,RegistersValid=2,StackBoundsValid=4,FramesRead=8,
+ RegistersMatched=16,SameCopyAtEnd=32,IntegerRegistersValid=64
+};
+enum : uint32_t {
+ NotAttempted=0,EndOfChain=1,FrameLimit=2,OutsideStack=3,
+ UnalignedFrame=4,ReadFailed=5,NonIncreasingFrame=6,NoRegisters=7,
+ RegistrationFull=8,BudgetExhausted=9
+};
+struct Registers {uint64_t pc=0,lr=0,fp=0,sp=0;};
+struct Frame {uint64_t fp=0,lr=0;};
+struct Sample {
+ uint32_t version=0,bytes=0;
+ uint64_t id=0,beganUs=0,infoEndedUs=0,stateEndedUs=0,endedUs=0;
+ uint64_t tid=0,lastCommand=0,lastCopyUs=0,stackLow=0,stackHigh=0,cpuUs=0;
+ Registers first{},last{};
+ uint32_t runState=0,flags=0,suspendCount=0,policy=0;
+ int32_t basicKr=-1,stateKr=-1,readKr=-1,recheckKr=-1;
+ uint32_t depth=0,stop=NotAttempted,thresholdUs=0,architecture=0;
+ Frame frames[kFrames]{};
+ // First ARM64 thread_get_state only: x0..x3, then x19..x28. These are raw
+ // integers from the same capture as first.pc, not dereferenced pointers.
+ // The recheck covers only PC/LR/FP/SP; it does not recheck these arguments.
+ uint64_t integers[kIntegerRegisters]{};
+};
+static_assert(sizeof(Sample)==576,"render-thread sample wire size");
+struct Image {
+ uint32_t version=1,bytes=168;
+ uint64_t header=0;
+ int64_t slide=0;
+ uint8_t uuid[16]{};
+ char path[128]{};
+};
+static_assert(sizeof(Image)==168,"render-thread image wire size");
+
+inline uint64_t codeAddress(uint64_t value) {
+#if defined(__arm64e__)
+ return (uintptr_t)ptrauth_strip((void *)(uintptr_t)value,ptrauth_key_function_pointer);
+#else
+ return value;
+#endif
+}
+inline kern_return_t registers(thread_t thread,Registers &out,uint32_t &architecture,uint64_t *integers=nullptr) {
+ (void)integers; // ARM64 arguments are unavailable in the Intel host capture.
+#if defined(__arm64__) || defined(__aarch64__)
+ arm_thread_state64_t state{};mach_msg_type_number_t count=ARM_THREAD_STATE64_COUNT;
+ const kern_return_t kr=thread_get_state(thread,ARM_THREAD_STATE64,(thread_state_t)&state,&count);
+ architecture=1;
+ if(kr==KERN_SUCCESS && count==ARM_THREAD_STATE64_COUNT) {
+  out.pc=codeAddress((uintptr_t)__darwin_arm_thread_state64_get_pc_fptr(state));
+  out.lr=codeAddress((uintptr_t)__darwin_arm_thread_state64_get_lr_fptr(state));
+  out.fp=__darwin_arm_thread_state64_get_fp(state);out.sp=__darwin_arm_thread_state64_get_sp(state);
+  if(integers) {
+   for(unsigned i=0;i<4;++i)integers[i]=state.__x[i];
+   for(unsigned i=19;i<29;++i)integers[i-15]=state.__x[i];
+  }
+  return KERN_SUCCESS;
+ }
+#elif defined(__x86_64__)
+ x86_thread_state64_t state{};mach_msg_type_number_t count=x86_THREAD_STATE64_COUNT;
+ const kern_return_t kr=thread_get_state(thread,x86_THREAD_STATE64,(thread_state_t)&state,&count);
+ architecture=2;
+ if(kr==KERN_SUCCESS && count==x86_THREAD_STATE64_COUNT) {
+  out.pc=state.__rip;out.fp=state.__rbp;out.sp=state.__rsp;return KERN_SUCCESS;
+ }
+#else
+#error Unsupported render-thread sample architecture
+#endif
+ return kr==KERN_SUCCESS?KERN_INVALID_ARGUMENT:kr;
+}
+// Keep the actual observation times and all Mach errors. There is no explicit
+// thread_suspend, thread_resume, signal delivery or scheduling-policy change.
+template<class Clock> inline void capture(thread_t thread,Sample &s,Clock now) {
+ s.version=kVersion;s.bytes=sizeof(Sample);s.beganUs=now();
+ thread_basic_info_data_t info{};mach_msg_type_number_t count=THREAD_BASIC_INFO_COUNT;
+ s.basicKr=thread_info(thread,THREAD_BASIC_INFO,(thread_info_t)&info,&count);
+ s.infoEndedUs=now();
+ if(s.basicKr==KERN_SUCCESS && count==THREAD_BASIC_INFO_COUNT) {
+  s.flags|=BasicValid;s.runState=info.run_state;s.suspendCount=info.suspend_count;s.policy=info.policy;
+  s.cpuUs=((uint64_t)info.user_time.seconds+(uint64_t)info.system_time.seconds)*1000000ull+
+          (uint64_t)info.user_time.microseconds+(uint64_t)info.system_time.microseconds;
+ }
+ s.stateKr=registers(thread,s.first,s.architecture,s.integers);s.stateEndedUs=now();
+ if(s.stateKr!=KERN_SUCCESS){s.stop=NoRegisters;s.endedUs=now();return;}
+ s.flags|=RegistersValid;
+ if(s.architecture==1)s.flags|=IntegerRegistersValid;
+ if(s.stackHigh>s.stackLow && s.first.sp>=s.stackLow && s.first.sp<s.stackHigh)s.flags|=StackBoundsValid;
+ uint64_t fp=s.first.fp;
+ s.stop=FrameLimit;
+ for(unsigned n=0;n<kFrames;++n) {
+  if(!fp){s.stop=EndOfChain;break;}
+  const uint64_t alignment=s.architecture==1?16:8;
+  if(fp&(alignment-1)){s.stop=UnalignedFrame;break;}
+  if(!(s.flags&StackBoundsValid) || s.stackHigh-s.stackLow<16 ||
+     fp<s.first.sp || fp<s.stackLow || fp>s.stackHigh-16){s.stop=OutsideStack;break;}
+  uint64_t pair[2]{};mach_vm_size_t copied=0;
+  s.readKr=mach_vm_read_overwrite(mach_task_self(),fp,sizeof(pair),(mach_vm_address_t)pair,&copied);
+  if(s.readKr!=KERN_SUCCESS || copied!=sizeof(pair)){s.stop=ReadFailed;break;}
+  s.frames[s.depth++]={fp,codeAddress(pair[1])};s.flags|=FramesRead;
+  if(!pair[0]){s.stop=EndOfChain;break;}
+  if(pair[0]<=fp){s.stop=NonIncreasingFrame;break;}
+  fp=pair[0];
+ }
+ uint32_t afterArchitecture=0;
+ s.recheckKr=registers(thread,s.last,afterArchitecture);
+ if(s.recheckKr==KERN_SUCCESS && afterArchitecture==s.architecture &&
+    s.first.pc==s.last.pc && s.first.lr==s.last.lr && s.first.fp==s.last.fp && s.first.sp==s.last.sp)
+  s.flags|=RegistersMatched;
+ s.endedUs=now();
+}
+// A late sampler takes the latest due threshold once, rather than issuing a
+// burst of stale 25/60/110ms observations at the same instant.
+inline int dueThreshold(uint64_t now,uint64_t copied,unsigned next) {
+ if(!copied || now<copied || next>=4)return -1;
+ int due=-1;for(unsigned i=next;i<4 && now-copied>=kThresholdsUs[i];++i)due=(int)i;
+ return due;
+}
+} // namespace nbwait
+#endif
