@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: MIT */
+#include "../NativeUIUpdateWaitState.h"
+#include <cassert>
+#include <cstdio>
+#include <vector>
+
+using namespace nbuiwait;
+constexpr uint64_t kCore=0x10000ULL,kOwner=0x20000ULL,kFP=0x3000ULL;
+struct Memory {
+ uint64_t words[16]{},ownerCore=kCore;
+ unsigned coreReads=0,allReads=0;
+ bool change=false,fail=false;
+ Memory() {
+  words[1]=(0x20000000ULL<<32)|0x20000000ULL;
+  words[5]=kOwner;words[6]=kMainSectionBegin+0x5b0000;
+  words[7]=kOwner;words[9]=1;words[10]=1050;words[11]=1050;
+ }
+ int read(uint64_t address,void *out,unsigned bytes) {
+  ++allReads;
+  if(address==kFP-8 && bytes==8){const uint64_t value=kCore;memcpy(out,&value,8);return 0;}
+  if(address==kCore && bytes==sizeof(words)) {
+   if(fail)return 5;
+   if(coreReads++ && change)++words[11];
+   memcpy(out,words,sizeof(words));return 0;
+  }
+  if(address==kOwner+0x2c0 && bytes==8){memcpy(out,&ownerCore,8);return 0;}
+  return 1;
+ }
+};
+static Layout layout() {return {kUIKitHeader+0x5b0000,kUpdateCycleHeader+0x5b0000,0x5b0000,0x5b0000};}
+static Binding bound(Memory &memory) {
+ Binding result{};const Anchor anchor{kFP,kContinueReturn+0x5b0000,0x1848c3928ULL+0x5b0000};
+ bind(result,layout(),&anchor,1,0x2000ULL,0x4000ULL,900,
+  [&](uint64_t a,void *out,unsigned n){return memory.read(a,out,n);});
+ assert(result.core==kCore && result.fp==kFP && result.sourceUs==900);return result;
+}
+static State captured(Memory &memory,Binding &binding,bool reverseClock=false) {
+ State result{};result.id=1;unsigned tickReads=0;
+ capture(result,binding,layout(),[&](uint64_t a,void *out,unsigned n){return memory.read(a,out,n);},
+  []{return uint64_t(1000);},[&]{return reverseClock && tickReads++?uint64_t(999):uint64_t(1000);});
+ return result;
+}
+int main(int argc,char **argv) {
+ unsigned cases=0;std::vector<State> wire;
+ {
+  Memory memory;Binding binding{};State state{};Layout wrong=layout();++wrong.uiHeader;
+  capture(state,binding,wrong,[&](uint64_t a,void *o,unsigned n){return memory.read(a,o,n);},[]{return uint64_t(1);},[]{return uint64_t(1);});
+  assert(!wrong.valid() && state.flags==ClockOrdered && memory.allReads==0);++cases;
+ }
+ {
+  uint8_t wrong[16];memcpy(wrong,kUIKitUUID,16);wrong[0]^=1;
+  assert(imageUUIDMatches(kUIKitUUID,true) && imageUUIDMatches(kUpdateCycleUUID,false));
+  assert(!imageUUIDMatches(wrong,true) && !imageUUIDMatches(kUIKitUUID,false));++cases;
+ }
+ {
+  Memory memory;Binding binding=bound(memory);State state=captured(memory,binding);
+  assert(state.flags==63 && state.core==kCore && state.owner==kOwner && state.mask==memory.words[1]);
+  assert(state.waitingWord==1 && state.requestedDeadline==1050 && state.installedDeadline==1050);
+  assert(state.firstOwnerCore==kCore && state.confirmOwnerCore==kCore && state.confirmInstalledDeadline==1050);
+  for(int status:state.reads)assert(status==0);
+  wire.push_back(state);++cases;
+ }
+ {
+  Memory memory;Binding binding{};Anchor anchor{kFP,kContinueReturn+0x5b0004,0x1848c3928ULL+0x5b0000};
+  auto read=[&](uint64_t a,void *o,unsigned n){return memory.read(a,o,n);};
+  bind(binding,layout(),&anchor,1,0x2000ULL,0x4000ULL,900,read);
+  assert(!binding.core && !memory.allReads);
+  anchor.returnPc=kContinueReturn+0x5b0000;
+  bind(binding,layout(),&anchor,1,kFP,kFP+16,900,read);
+  assert(!binding.core && !memory.allReads);++cases;
+ }
+ {
+  Memory memory;memory.ownerCore=kCore+8;Binding binding=bound(memory);State state=captured(memory,binding);
+  assert(!(state.flags&OwnerMatched) && !binding.core && state.firstOwnerCore==kCore+8);
+  wire.push_back(state);++cases;
+ }
+ {
+  Memory memory;memory.change=true;Binding binding=bound(memory);State state=captured(memory,binding);
+  assert((state.flags&OwnerMatched) && !(state.flags&RepeatedFieldsMatched));
+  assert(state.installedDeadline==1050 && state.confirmInstalledDeadline==1051);
+  wire.push_back(state);++cases;
+ }
+ {
+  Memory memory;Binding binding=bound(memory);memory.fail=true;State state=captured(memory,binding);
+  assert(!(state.flags&CoreRead) && state.reads[1]==5 && !binding.core);
+  wire.push_back(state);++cases;
+ }
+ {
+  Memory memory;memory.words[10]=memory.words[11]=0x7fffffffffffffffULL;Binding binding=bound(memory);State state=captured(memory,binding);
+  assert(state.flags==63 && state.installedDeadline==0x7fffffffffffffffULL);
+  wire.push_back(state);++cases;
+ }
+ {
+  Memory memory;memory.words[10]=memory.words[11]=950;Binding binding=bound(memory);State state=captured(memory,binding);
+  assert(state.flags==63 && state.installedDeadline<state.beganTicks);
+  assert((uint32_t(state.mask)&uint32_t(state.mask>>32))==0x20000000U);
+  wire.push_back(state);++cases;
+ }
+ {
+  Memory memory;Binding binding=bound(memory);State state=captured(memory,binding,true);
+  assert(!(state.flags&ClockOrdered) && state.endedTicks<state.beganTicks);
+  wire.push_back(state);++cases;
+ }
+ if(argc==2) {
+  FILE *file=fopen(argv[1],"wb");assert(file);
+  assert(fwrite(wire.data(),sizeof(State),wire.size(),file)==wire.size());assert(!fclose(file));
+ }
+ assert(cases==10);
+ printf("{\"passed\":true,\"cases\":%u,\"wire_bytes\":%zu,\"records\":%zu}\n",cases,sizeof(State),wire.size());
+}
