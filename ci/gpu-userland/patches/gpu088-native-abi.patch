+    const uint32_t before=memory[at/4];
+    int result=write32(cookie,at,value);
+    // The full program path clears FSR before enabling M. The original VM
+    // fixture skips programming, so add the register's actual W1C behavior.
+    if(!result && (at==0x48 || (at>=0x20000 && (at&0xfff)==0x58)))memory[at/4]=before&~value;
+    return result;
+}
