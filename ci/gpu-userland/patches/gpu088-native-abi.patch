+    CHECK(owned_context->bufferCount()==5 && owned_context->buffer(0).bytes()==0x20000);
+    CHECK(fixture.created>=5 && owned_context->vm()->objectCount()==5);
+    for(unsigned i=5;i<GpuBufferCount;++i)CHECK(!owned_context->buffer(i).backed());
+    CHECK(owned_context->bringUp(&io,0,2,slots,sids,nullptr,&report,&plan)==kIOReturnBusy);
