+/* SPDX-License-Identifier: MIT */
+/* Production helper is included by the host check after its fake IOKit peer.
+ * Its gate is a real mutex: another client must enter while close is waiting. */
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <thread>
+
+using IOReturn=int;
+constexpr IOReturn kIOReturnSuccess=0,kIOReturnBadArgument=1,kIOReturnIOError=7,kIOReturnTimeout=8;
+static std::mutex gate;
+static thread_local bool locked=false;
+static void IOLockLock(std::mutex *lock){assert(!locked);lock->lock();locked=true;}
+static void IOLockUnlock(std::mutex *lock){assert(locked);locked=false;lock->unlock();}
+static std::atomic<bool> closing{true},pending{false},peer_entered{false};
+static std::atomic<unsigned> checks{0},idle_calls{0};
+static IOReturn retirement_error=kIOReturnSuccess;
+struct NativeAdrenoUserClient {
+    bool ownRangeOutstanding() const {assert(locked && closing);++checks;return pending;}
+};
+struct Submit {
+    IOReturn retireCompleted(){assert(locked);return retirement_error;}
+};
+struct Clock {void *cookie;uint64_t (*now_us)(void *);int (*idle)(void *);};
+static Submit submit;
+static int cookie;
+static uint64_t logical_time=0;
+static bool real_clock=false,idle_error=false;
+static uint64_t now(void *p){
+    assert(p==&cookie && locked);
+    return real_clock?uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count()):logical_time;
+}
+static int idle(void *p){
+    assert(p==&cookie && !locked && closing);++idle_calls;
+    if(real_clock){
+        const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(1);
+        while(!peer_entered && std::chrono::steady_clock::now()<deadline)std::this_thread::yield();
+        assert(peer_entered);
+    } else logical_time+=1000;
+    return idle_error;
+}
+static struct {std::mutex *lock=&gate;Submit *submit=&::submit;Clock clock{&cookie,now,idle};} g;
+
+#include "NativeCloseDrainTest.inc"
+
+static void reset(){
+    assert(!locked);pending=false;peer_entered=false;checks=0;idle_calls=0;
+    retirement_error=kIOReturnSuccess;logical_time=0;real_clock=false;idle_error=false;
+    g.submit=&submit;g.clock={&cookie,now,idle};closing=true;
+}
+int main(){
+    NativeAdrenoUserClient core;unsigned cases=0;
+    reset();IOLockLock(g.lock);
+    assert(drainClosingJobs(&core,2000000)==kIOReturnSuccess && locked && !idle_calls);IOLockUnlock(g.lock);++cases;
+
+    reset();pending=true;real_clock=true;
+    std::thread peer([]{
+        while(!idle_calls)std::this_thread::yield();
+        std::lock_guard<std::mutex> lock(gate);
+        // The publishing wrapper still excludes the closing connection;
+        // this independent client can import/submit under the same gate.
+        assert(closing);pending=false;peer_entered=true;
+    });
+    IOLockLock(g.lock);
+    assert(drainClosingJobs(&core,2000000)==kIOReturnSuccess && locked && peer_entered && checks>=2);
+    IOLockUnlock(g.lock);peer.join();++cases;
+
+    reset();pending=true;IOLockLock(g.lock);
+    assert(drainClosingJobs(&core,3000)==kIOReturnTimeout && locked && pending && idle_calls==3);
+    IOLockUnlock(g.lock);++cases;
+
+    reset();pending=true;retirement_error=kIOReturnIOError;IOLockLock(g.lock);
+    assert(drainClosingJobs(&core,2000000)==kIOReturnIOError && locked && !idle_calls && !checks);
+    IOLockUnlock(g.lock);++cases;
+
+    reset();pending=true;idle_error=true;IOLockLock(g.lock);
+    assert(drainClosingJobs(&core,2000000)==kIOReturnTimeout && locked && pending && idle_calls==1);
+    IOLockUnlock(g.lock);++cases;
+
+    reset();IOLockLock(g.lock);
+    assert(drainClosingJobs(nullptr,2000000)==kIOReturnBadArgument && locked);IOLockUnlock(g.lock);++cases;
+    reset();g.submit=nullptr;IOLockLock(g.lock);
+    assert(drainClosingJobs(&core,2000000)==kIOReturnBadArgument && locked);IOLockUnlock(g.lock);++cases;
+    reset();g.clock.now_us=nullptr;IOLockLock(g.lock);
+    assert(drainClosingJobs(&core,2000000)==kIOReturnBadArgument && locked);IOLockUnlock(g.lock);++cases;
+    reset();g.clock.idle=nullptr;IOLockLock(g.lock);
+    assert(drainClosingJobs(&core,2000000)==kIOReturnBadArgument && locked);IOLockUnlock(g.lock);++cases;
+    std::printf("PASS close drain: %u cases; another client enters during idle; all job rechecks and exits hold the gate\n",cases);
+}
