+    CHECK(owned_context->createVm(&process)==kIOReturnSuccess && process);
+    CHECK(process->vm()->objectCount()==5 && owned_context->liveVms()==1);
+    CHECK(owned_context->destroyVm(process)==kIOReturnSuccess && owned_context->liveVms()==0);
