++/// Test both sides of device limits, including the real Vulkan minimum x limit.
++/// Every word is covered without a nearly empty extra row above that boundary.
++#[test]
++fn linear_word_grids_do_not_dispatch_a_nearly_empty_extra_row() {
++    use crate::texture::heap_tiled::tiled_word_grid;
++    for limits in [[1, 1], [3, 7], [64, 9], [65535, 65535]] {
++        let capacity = u64::from(limits[0]) * u64::from(limits[1]);
++        for groups in [
++            1,
++            2,
++            u64::from(limits[0]),
++            u64::from(limits[0]) + 1,
++            u64::from(limits[0]) * 2 - 1,
++            capacity,
++            capacity + 1,
++        ] {
++            for words in [groups * 64, groups * 64 - 63] {
++                let grid = tiled_word_grid(words, limits);
++                if groups > capacity {
++                    assert!(grid.is_none());
++                    continue;
++                }
++                let [x, y] = grid.expect("fits");
++                assert!(x > 0 && x <= limits[0] && y > 0 && y <= limits[1]);
++                let sent = u64::from(x) * u64::from(y);
++                assert!(sent >= groups);
++                assert!(sent - groups < u64::from(y), "{groups} groups in {grid:?}");
++            }
++        }
++    }
++    assert_eq!(
++        tiled_word_grid(65536 * 64, [65535, 65535]),
++        Some([32768, 2])
++    );
++    assert_eq!(tiled_word_grid(0, [65535, 65535]), Some([1, 1]));
++    assert_eq!(tiled_word_grid(1, [0, 65535]), None);
++    assert_eq!(tiled_word_grid(1, [65535, 0]), None);
++    assert_eq!(tiled_word_grid(u64::MAX, [65535, 65535]), None);
++}
