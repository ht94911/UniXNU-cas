++fn morton(x: u32, y: u32, tw: u32, th: u32) -> u32 {
++    let (mut word, mut at) = (0, 0);
++    for bit in 0..tw.trailing_zeros().max(th.trailing_zeros()) {
++        if bit < tw.trailing_zeros() {
++            word |= ((x >> bit) & 1) << at;
++            at += 1;
++        }
++        if bit < th.trailing_zeros() {
++            word |= ((y >> bit) & 1) << at;
++            at += 1;
++        }
++    }
++    word
++}
++
++fn expected(level: &TiledLevelMove, into: bool, tight: &[u8], tiled: &[u8]) -> (Vec<u8>, Vec<u8>) {
++    let (mut t, mut p) = (tight.to_vec(), tiled.to_vec());
++    let [tw, th] = level.tile;
++    for image in 0..level.images {
++        for y in 0..level.extent[1] {
++            for x in 0..level.extent[0] {
++                let tile = y / th * level.across + x / tw;
++                let element = tile * tw * th + morton(x % tw, y % th, tw, th);
++                let a = (level.tiled_first + image * level.chain_stride + element * level.unit)
++                    as usize;
++                let b = (level.tight_first
++                    + ((image * level.extent[1] + y) * level.extent[0] + x) * level.unit)
++                    as usize;
++                let n = level.unit as usize;
++                if into {
++                    t[b..b + n].copy_from_slice(&p[a..a + n]);
++                } else {
++                    p[a..a + n].copy_from_slice(&t[b..b + n]);
++                }
++            }
++        }
++    }
++    (t, p)
++}
++
++fn assert_bytes(label: &str, buffer: &Buffer, want: &[u8]) {
++    // SAFETY: Shared storage of the given length; the internal submission has
++    // completed and its compute writes were made visible to HOST_READ.
++    let got =
++        unsafe { std::slice::from_raw_parts(buffer.contents().unwrap().as_ptr(), want.len()) };
++    let mismatch = got.iter().zip(want).position(|(a, b)| a != b);
++    assert_eq!(mismatch, None, "{label}: first unequal byte");
++}
++
++fn run_plan(
++    device: &Device,
++    shape: &[u8],
++    grid: [u32; 3],
++    inputs: (&[u8], &[u8]),
++    want: (&[u8], &[u8]),
++    label: &str,
++) {
++    let (tight, tiled) = inputs;
++    let a = device
++        .new_buffer_with_bytes(tight, ResourceOptions::shared())
++        .unwrap();
++    let b = device
++        .new_buffer_with_bytes(tiled, ResourceOptions::shared())
++        .unwrap();
++    let s = device
++        .new_buffer_with_bytes(shape, ResourceOptions::shared())
++        .unwrap();
++    let kernel = device.owned_kernel(OwnedModule::TiledTexels).unwrap();
++    let binding = |buffer: &Buffer, len: usize| {
++        let (raw, at) = buffer.at(0);
++        (raw, at, len as u64)
++    };
++    let sets = OwnedSets::write(
++        device,
++        &kernel,
++        &[vec![
++            binding(&a, tight.len()),
++            binding(&b, tiled.len()),
++            binding(&s, shape.len()),
++        ]],
++    )
++    .unwrap();
++    let mut elapsed = Vec::new();
++    for _ in 0..3 {
++        let start = Instant::now();
++        device
++            .submit_internal(|raw, cb| {
++                let before = vk::MemoryBarrier::default()
++                    .src_access_mask(vk::AccessFlags::HOST_WRITE)
++                    .dst_access_mask(vk::AccessFlags::SHADER_READ | vk::AccessFlags::SHADER_WRITE);
++                let after = vk::MemoryBarrier::default()
++                    .src_access_mask(vk::AccessFlags::SHADER_WRITE)
++                    .dst_access_mask(vk::AccessFlags::HOST_READ);
++                // SAFETY: the existing runtime records and waits for this command;
++                // every bound range is live, aligned by the buffer allocator and fits.
++                unsafe {
++                    raw.cmd_pipeline_barrier(
++                        cb,
++                        vk::PipelineStageFlags::HOST,
++                        vk::PipelineStageFlags::COMPUTE_SHADER,
++                        vk::DependencyFlags::empty(),
++                        &[before],
++                        &[],
++                        &[],
++                    );
++                    raw.cmd_bind_pipeline(cb, vk::PipelineBindPoint::COMPUTE, kernel.pipeline);
++                    raw.cmd_bind_descriptor_sets(
++                        cb,
++                        vk::PipelineBindPoint::COMPUTE,
++                        kernel.layout,
++                        0,
++                        &[sets.sets[0]],
++                        &[],
++                    );
++                    raw.cmd_dispatch(cb, grid[0], grid[1], grid[2]);
++                    raw.cmd_pipeline_barrier(
++                        cb,
++                        vk::PipelineStageFlags::COMPUTE_SHADER,
++                        vk::PipelineStageFlags::HOST,
++                        vk::DependencyFlags::empty(),
++                        &[after],
++                        &[],
++                        &[],
++                    );
++                }
++            })
++            .unwrap();
++        elapsed.push(start.elapsed().as_secs_f64() * 1000.0);
++        assert_bytes("tight", &a, want.0);
++        assert_bytes("tiled and padding", &b, want.1);
++        assert_bytes("shape is read only", &s, shape);
++    }
++    eprintln!(
++        "TILED-DEVICE {label}: {} grid {grid:?} submitted-and-waited-ms {elapsed:?}",
++        device.name()
++    );
++}
