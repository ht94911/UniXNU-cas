+// Original24A446 option76 is CA_EMIT_DEBUG_SIGNPOSTS. Its env-name getter
+// verifies the option before the stock API is used. Run once on the existing
+// diagnostic sampler, outside rendering and device-initialization locks.
+static void enableOriginalContextSignposts() {
+#if defined(NATIVE_METAL_IPHONE24A446)
+ if(!diagOn() || !NBTraceSwapTimingOn() ||
+    (strcmp(getprogname(),"SpringBoard") && strcmp(getprogname(),"backboardd")))return;
+ using OptionName=const char *(*)(unsigned);
+ using GetOption=bool (*)(unsigned);
+ using SetOption=void (*)(unsigned,bool);
+ const auto name=(OptionName)dlsym(RTLD_DEFAULT,"CAGetDebugOptionEnvVariableName");
+ const auto get=(GetOption)dlsym(RTLD_DEFAULT,"CAGetDebugOption");
+ const auto set=(SetOption)dlsym(RTLD_DEFAULT,"CASetDebugOption");
+ const char *option=name?name(76):nullptr;
+ if(!option || strcmp(option,"CA_EMIT_DEBUG_SIGNPOSTS") || !get || !set) {
+  native_bridge_metal_note("context-signposts original option unavailable");return;
+ }
+ const bool previous=get(76);
+ if(!previous)set(76,true);
+ char note[112];snprintf(note,sizeof(note),"context-signposts option=76 previous=%u enabled=%u",
+  (unsigned)previous,(unsigned)get(76));native_bridge_metal_note(note);
+#endif
+}
