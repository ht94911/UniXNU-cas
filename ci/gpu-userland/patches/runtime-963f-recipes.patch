+diff --git a/src/freedreno/vulkan/tu_cpu_profile.cc b/src/freedreno/vulkan/tu_cpu_profile.cc
+new file mode 100644
+index 0000000..d9784a6
+--- /dev/null
++++ b/src/freedreno/vulkan/tu_cpu_profile.cc
+@@ -0,0 +1,136 @@
++/* SPDX-License-Identifier: MIT */
++#include "tu_cpu_profile.h"
++#include <atomic>
++#include <pthread.h>
++#include <time.h>
++#ifdef __APPLE__
++#include <mach/mach.h>
++#else
++#include <sys/syscall.h>
++#include <unistd.h>
++#endif
++
++static std::atomic<TuCpuProfileHook> profile_hook{nullptr};
++static std::atomic<uint64_t> profile_group{0};
++static std::atomic<uint32_t> profile_written{0};
++static thread_local TuCpuProfileState *profile_current;
++static thread_local TuCpuProfileState profile_storage;
++static constexpr uint64_t slow_ns = 8000000; /* one120Hz frame budget */
++static constexpr uint32_t max_groups = 4096;
++
++static uint64_t wall_ns() noexcept {
++#ifdef __APPLE__
++   return clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
++#else
++   timespec value{};
++   if (clock_gettime(CLOCK_MONOTONIC, &value)) return 0;
++   return uint64_t(value.tv_sec) * 1000000000 + uint64_t(value.tv_nsec);
++#endif
++}
++
++static bool cpu_ns(uint64_t &value) noexcept {
++#ifdef __APPLE__
++   /* Same public Mach time query as the existing frontend CPU measurements. */
++   const mach_port_t thread = mach_thread_self();
++   thread_basic_info_data_t info{};
++   mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
++   const kern_return_t result = thread_info(thread, THREAD_BASIC_INFO,
++                                            reinterpret_cast<thread_info_t>(&info), &count);
++   mach_port_deallocate(mach_task_self(), thread);
++   if (result != KERN_SUCCESS)
++      return false;
++   value = (uint64_t(info.user_time.seconds) + uint64_t(info.system_time.seconds)) * 1000000000 +
++           (uint64_t(info.user_time.microseconds) + uint64_t(info.system_time.microseconds)) * 1000;
++#else
++   timespec info{};
++   if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &info)) return false;
++   value = uint64_t(info.tv_sec) * 1000000000 + uint64_t(info.tv_nsec);
++#endif
++   return true;
++}
++
++static uint32_t thread_id() noexcept {
++#ifdef __APPLE__
++   uint64_t value = 0;
++   pthread_threadid_np(nullptr, &value);
++   return uint32_t(value);
++#else
++   return uint32_t(syscall(SYS_gettid));
++#endif
++}
++
++extern "C" void tu_cpu_profile_set_hook(TuCpuProfileHook hook) {
++   profile_hook.store(hook, std::memory_order_release);
++}
++
++TuCpuCall::TuCpuCall(TuCpuApi api, uintptr_t command) noexcept {
++   hook_ = profile_hook.load(std::memory_order_acquire);
++   if (!hook_ || profile_current || profile_written.load(std::memory_order_relaxed) >= max_groups)
++      return;
++   state_ = &profile_storage;
++   *state_ = {};
++   state_->began = wall_ns();
++   state_->cpu_valid = cpu_ns(state_->cpu_began);
++   state_->group = profile_group.fetch_add(1, std::memory_order_relaxed) + 1;
++   state_->command = command;
++   state_->api = api;
++   state_->thread = thread_id();
++   profile_current = state_;
++   owns_ = true;
++}
++
++TuCpuCall::~TuCpuCall() noexcept {
++   if (!owns_) return;
++   uint64_t cpu_ended = 0;
++   const bool cpu_ok = cpu_ns(cpu_ended);
++   const uint64_t ended = wall_ns();
++   profile_current = nullptr;
++   if (!state_->began || ended < state_->began || ended - state_->began < slow_ns)
++      return;
++   const uint32_t ordinal = profile_written.fetch_add(1, std::memory_order_relaxed);
++   if (ordinal >= max_groups) return;
++   TuCpuProfileRecord records[TU_CPU_PHASE_COUNT]{};
++   uint32_t count = 1;
++   uint64_t measured_self = 0;
++   for (uint32_t phase = 1; phase < TU_CPU_PHASE_COUNT; ++phase) {
++      const auto &bucket = state_->buckets[phase];
++      if (!bucket.count) continue;
++      auto &record = records[count++];
++      record = {state_->group, state_->command, state_->began, bucket.inclusive_ns,
++                0, bucket.self_ns, phase, state_->api, state_->thread, bucket.count, 0, 1};
++      measured_self += bucket.self_ns;
++   }
++   const uint64_t elapsed = ended - state_->began;
++   const bool valid_cpu = state_->cpu_valid && cpu_ok && cpu_ended >= state_->cpu_began;
++   const uint64_t consumed = valid_cpu ? cpu_ended - state_->cpu_began : 0;
++   const uint32_t flags = (valid_cpu ? 1u : 0u) | (consumed > elapsed ? 2u : 0u) |
++                          (measured_self > elapsed ? 4u : 0u) | (ordinal + 1 == max_groups ? 8u : 0u);
++   records[0] = {state_->group, state_->command, state_->began, elapsed, consumed,
++                 measured_self <= elapsed ? elapsed - measured_self : 0,
++                 TU_CPU_SUMMARY, state_->api, state_->thread, count - 1, flags, 1};
++   hook_(records, count, sizeof(records[0]));
++}
++
++TuCpuPhase::TuCpuPhase(TuCpuPhaseId id) noexcept : id_(id) {
++   state_ = profile_current;
++   if (!state_ || id == TU_CPU_SUMMARY || id >= TU_CPU_PHASE_COUNT) {
++      state_ = nullptr;
++      return;
++   }
++   parent_ = state_->phase;
++   state_->phase = this;
++   began_ = wall_ns();
++}
++
++TuCpuPhase::~TuCpuPhase() noexcept {
++   if (!state_) return;
++   const uint64_t ended = wall_ns();
++   state_->phase = parent_;
++   if (!began_ || ended < began_) return;
++   const uint64_t elapsed = ended - began_;
++   auto &bucket = state_->buckets[id_];
++   bucket.inclusive_ns += elapsed;
++   bucket.self_ns += elapsed >= children_ ? elapsed - children_ : 0;
++   ++bucket.count;
++   if (parent_) parent_->children_ += elapsed;
++}
