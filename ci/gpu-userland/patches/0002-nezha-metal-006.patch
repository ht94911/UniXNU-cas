+                                               options: *const NmbPipelineOptions) -> *mut NmbRenderPipeline {
+    guard(std::ptr::null_mut(), || {
+        let d = get(descriptor)?;
+        let mut out = TileRenderPipelineDescriptor::new(StageSource::Function(get(d.function)?.0.function_descriptor()));
+        for (slot, value) in out.color_attachment_formats.iter_mut().zip(d.colors) {
+            *slot = optional_format(value)?;
