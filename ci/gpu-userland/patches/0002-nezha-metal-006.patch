+        out.raster_sample_count = u32::try_from(d.samples.max(1)).map_err(e("tile samples"))?;
+        out.threadgroup_size_matches_tile_size = d.matches_tile != 0;
+        if d.max_threads != 0 { out.max_total_threads_per_threadgroup = Some(u32::try_from(d.max_threads).map_err(e("tile max threads"))?); }
+        out.max_call_stack_depth = u32::try_from(d.max_stack.max(1)).map_err(e("tile max stack"))?;
+        let options = unsafe { pipeline_options(options)? };
+        let state = get(device)?.0.new_tile_render_pipeline_state(&out, &options).map_err(e("tile pipeline"))?;
+        Ok(boxed(NmbRenderPipeline(state)))
