+/* Busy can mean that a different VM owns the A840 ring. Once this
+ * connection's oldest fence completed it must leave the retry history; polling
+ * that already-retired fence cannot make the other VM drain. Sleep briefly
+ * when no local job remains, without holding the connection or retirement lock.
+ * The kernel still proves real RPTR/RBBM idle before changing TTBR0. */
+static VkResult
+darwin_wait_submit_room(struct tu_device *dev)
+{
+   struct dw_connection &dw = dw_device(dev);
+   pthread_mutex_lock(&dw.lock);
+   const uint32_t oldest = dw.inflight_count ? dw.inflight[0] : 0;
+   pthread_mutex_unlock(&dw.lock);
+   if (!oldest) {
+      usleep(200);
+      return VK_SUCCESS;
+   }
+   VkResult result = dw_wait_fence_locked_free(dev, oldest, UINT64_MAX);
+   if (result != VK_SUCCESS)
+      return result;
+   pthread_mutex_lock(&dw.lock);
+   if (dw.inflight_count && dw.inflight[0] == oldest) {
+      --dw.inflight_count;
+      memmove(dw.inflight, dw.inflight + 1,
+              dw.inflight_count * sizeof(dw.inflight[0]));
+   }
+   pthread_mutex_unlock(&dw.lock);
+   return VK_SUCCESS;
+}
+
 /* One kernel submission of up to NativeAdrenoAbiMaxBuffers indirect buffers; while the kernel's ring has no room (kIOReturnBusy, as msm
  * waits for ring space) it waits for this client's oldest job, or yields when none is in flight. */
 static VkResult
