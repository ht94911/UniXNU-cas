diff --git a/bridge/upstream_interfaces_host.mm b/bridge/upstream_interfaces_host.mm
new file mode 100644
index 0000000..72aa8c0
--- /dev/null
+++ b/bridge/upstream_interfaces_host.mm
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: MIT
+// Exercise the production descriptor bridge and missing-function fallback.
+#define main retained_extern_function_checks
+#include "extern_function_host.mm"
+#undef main
+#include <cstddef>
+
+static_assert(sizeof(NmbTextureDescriptor) == 120);
+static_assert(offsetof(NmbTextureDescriptor, allow_gpu_optimized_contents) == 112);
+
+int main() {
+    @autoreleasepool {
+        unsigned checks = 0;
+        for (bool optimized : {false, true}) {
+            auto descriptor = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA16Float
+                width:242 height:242 mipmapped:NO];
+            descriptor.storageMode = MTLStorageModePrivate;
+            descriptor.usage = MTLTextureUsageShaderRead;
+            descriptor.allowGPUOptimizedContents = optimized;
+            NmbTextureDescriptor wire{};
+            assert(textureDescriptor(descriptor, &wire));
+            assert(wire.allow_gpu_optimized_contents == uint64_t(optimized)); ++checks;
+            NBTexture *texture = [NBTexture new];
+            texture.descriptor = wire;
+            assert([(id<MTLTexture>)texture allowGPUOptimizedContents] == optimized); ++checks;
+        }
+
+        NSMutableData *storage = kernelLibraryFixture();
+        NBLibrary *library = [NBLibrary new];
+        library.storage = storage;
+        library.bytes = (const uint8_t *)storage.bytes;
+        library.length = storage.length;
+        auto descriptor = [MTLFunctionDescriptor new];
+        descriptor.name = @"absent_kernel";
+        NSError *error = nil;
+        assert(![library newFunctionWithDescriptor:descriptor error:&error]);
+        assert([error.domain isEqualToString:MTLLibraryErrorDomain] && error.code == MTLLibraryErrorFunctionNotFound); ++checks;
+        auto constants = [MTLFunctionConstantValues new];
+        error = nil;
+        assert(![library newFunctionWithName:@"absent_kernel" constantValues:constants error:&error]);
+        assert([error.domain isEqualToString:MTLLibraryErrorDomain] && error.code == MTLLibraryErrorFunctionNotFound); ++checks;
+        descriptor.name = @"kernel_fixture";
+        NBFunction *function = (NBFunction *)[library newFunctionWithDescriptor:descriptor error:&error];
+        assert(function && !error && function.library == library && function.functionType == 4); ++checks;
+        NSError *declared = functionLookupError(library, @"kernel_fixture", @"specialization failed");
+        assert(![declared.domain isEqualToString:MTLLibraryErrorDomain] && declared.code == -1); ++checks;
+        NBLibrary *malformed = [NBLibrary new];
+        NSError *invalid = functionLookupError(malformed, @"absent_kernel", @"invalid library");
+        assert(![invalid.domain isEqualToString:MTLLibraryErrorDomain]); ++checks;
+
+        id<MTLDevice> original = MTLCreateSystemDefaultDevice();
+        bool originalCompared = false;
+        if (original) {
+            NSString *source = @"#include <metal_stdlib>\nusing namespace metal; kernel void present_kernel(uint i [[thread_position_in_grid]]) {(void)i;}";
+            error = nil;
+            id<MTLLibrary> real = [original newLibraryWithSource:source options:nil error:&error];
+            assert(real && !error);
+            error = nil;
+            assert(![real newFunctionWithName:@"absent_kernel" constantValues:constants error:&error]);
+            assert([error.domain isEqualToString:MTLLibraryErrorDomain] && error.code == MTLLibraryErrorFunctionNotFound);
+            originalCompared = true;
+        }
+        printf("PASS upstream interfaces: %u; originalMetalCompared=%d descriptorBytes=%zu\n",
+            checks, int(originalCompared), sizeof(NmbTextureDescriptor));
+    }
+    return 0;
+}
