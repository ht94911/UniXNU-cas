+// A compute filter selects the first COUNT matching command buffers, using the
+// same dump range and readback path. Startup work cannot spend that budget.
+static NSString *dumpComputeFilter() {
+ static NSString *const filter=[]{const char *v=getenv("NATIVE_METAL_DUMP_COMPUTE_MATCH");return v?@(v):nil;}();
+ return filter;
+}
+static void dumpSelectCompute(NBCommandBuffer *command,NBComputePipeline *pipeline) {
+ const auto range=dumpRange();NSString *filter=dumpComputeFilter();
+ if(!range.first || !filter.length || command.dumpReadback || command.dumpComputeSelected ||
+    ![pipeline.dumpInfo containsString:filter])return;
+ static std::atomic<uint32_t> selected{0};
+ uint32_t count=selected.load();
+ while(count<range.second) {
+  if(selected.compare_exchange_weak(count,count+1)) {command.dumpComputeSelected=YES;return;}
+ }
+}
 // Whether a command buffer being encoded now may be one to dump: its number is not known until it commits, and others may commit first.
