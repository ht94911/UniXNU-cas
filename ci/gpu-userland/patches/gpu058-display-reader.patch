  if(!gDiscoveryDisplayCount)return discoveryFailed(nbdisplaywait::EmptyDisplayCollection);
  bool candidateSeen=false;
- const NSUInteger n=std::min<NSUInteger>(gDiscoveryDisplayCount,4);
