diff --git a/NativeDisplayWaitState.h b/NativeDisplayWaitState.h
index 0658321..798ea93 100644
--- a/NativeDisplayWaitState.h
+++ b/NativeDisplayWaitState.h
@@ -18,6 +18,10 @@ constexpr uint8_t kQuartzUUID[16]={0x76,0xce,0x2a,0x6e,0xdb,0xa4,0x33,0x5d,0xa5,
 constexpr uint64_t kServerVtable=0x1e900aec8ULL;
 constexpr uint64_t kAccelServerVtable=0x1e8fff298ULL;
 constexpr uint64_t kDisplayVtable=0x1e900dea8ULL;
+// The observed056 AppleWirelessDisplay destructor reaches the original
+// IOMFBDisplay destructor with unadjusted this. This reader only checks the
+// display identity; it reads no fields from the derived display object.
+constexpr uint64_t kWirelessDisplayVtable=0x1e8ffbce8ULL;
 constexpr uint64_t kTimerCallback=0x1843f05b4ULL;
 constexpr unsigned kServerTailOffset=0x480,kServerTailBytes=0x1a0;
 constexpr unsigned kTimerTailOffset=0x78,kTimerTailBytes=0x98;
@@ -85,6 +89,11 @@ inline bool serverLayoutMatches(uint64_t p,int64_t slide){
  return address==uint64_t(int64_t(kServerVtable)+slide) ||
         address==uint64_t(int64_t(kAccelServerVtable)+slide);
 }
+inline bool displayLayoutMatches(uint64_t p,int64_t slide){
+ const uint64_t address=stripped(p);
+ return address==uint64_t(int64_t(kDisplayVtable)+slide) ||
+        address==uint64_t(int64_t(kWirelessDisplayVtable)+slide);
+}
 
 // Read returns the actual Mach status and rejects short reads. The caller has
 // already verified the loaded UUID and retained this display object. Samples
@@ -103,7 +112,7 @@ template<class Read,class Clock> inline void capture(State &s,int64_t slide,Read
  if(!take(3,s.server+0x60,&s.display,8) || !s.display || !take(4,s.display,&s.displayVtable,8)){
   finish(ReadFailed);return;
  }
- if(stripped(s.displayVtable)!=uint64_t(int64_t(kDisplayVtable)+slide)){finish(WrongDisplayVtable);return;}
+ if(!displayLayoutMatches(s.displayVtable,slide)){finish(WrongDisplayVtable);return;}
  s.flags|=LayoutMatched;
  if(!take(5,s.server+kServerTailOffset,s.serverTail,sizeof(s.serverTail))){finish(ReadFailed);return;}
  s.flags|=ServerRead;s.timer=s.serverTail[(0x4b0-kServerTailOffset)/8];
