+// The current CPU bytes of a planar video surface, before dispatch and after
+// completion. Its Metal texture can expose converted texels, so keep the two
+// plane codes separately from the existing GPU readback.
+static NSString *dumpSurfaceCodes(NBTexture *texture) {
+ IOSurfaceRef surface=texture.surface;
+ const uint32_t format=surface?IOSurfaceGetPixelFormat(surface):0;
+ if(!surface || (format!=0x34323066 && format!=0x34323076) || IOSurfaceGetPlaneCount(surface)!=2)return nil;
+ const size_t width=IOSurfaceGetWidth(surface),height=IOSurfaceGetHeight(surface),allocation=IOSurfaceGetAllocSize(surface);
+ const uintptr_t base=(uintptr_t)IOSurfaceGetBaseAddress(surface);
+ const uintptr_t y=(uintptr_t)IOSurfaceGetBaseAddressOfPlane(surface,0),uv=(uintptr_t)IOSurfaceGetBaseAddressOfPlane(surface,1);
+ const size_t yrow=IOSurfaceGetBytesPerRowOfPlane(surface,0),uvrow=IOSurfaceGetBytesPerRowOfPlane(surface,1);
+ if(width<2 || height<2 || !base || y<base || uv<base || y-base>=allocation || uv-base>=allocation || !yrow || !uvrow)return nil;
+ const size_t x=(width/2)&~size_t(1),row=height/2;
+ if(x>=yrow || x>=uvrow || uvrow-x<2)return nil;
+ if(row>(allocation-(y-base))/yrow || row/2>(allocation-(uv-base))/uvrow)return nil;
+ const size_t ya=(y-base)+row*yrow,ua=(uv-base)+(row/2)*uvrow;
+ if(x>=allocation-ya || x>=allocation-ua || allocation-ua-x<2)return nil;
+ const auto *luma=(const uint8_t *)y,*chroma=(const uint8_t *)uv;
+ return [NSString stringWithFormat:@"surface %u format %08x CPU center %u/%u/%u rows %zu/%zu",
+     IOSurfaceGetID(surface),format,luma[row*yrow+x],chroma[(row/2)*uvrow+x],chroma[(row/2)*uvrow+x+1],yrow,uvrow];
+}
