++    /// Backing made on a foreground pool miss. On iOS Turnip a 64 MiB
++    /// allocation spent 113 ms in IOKit prepare inside a 128 ms texture call;
++    /// its tight conversion buffer needed a pooled range, not a whole reserve.
++    /// Keep at least the initial block and round requests up to a power of two
++    /// so nearby allocations still share it. Existing blocks and the room
++    /// keeper retain their original sizes, age and pressure handling.
++    fn foreground_block_bytes(&self, pool: (Holds, u32), size: u64) -> u64 {
++        let grown = self.next_block_bytes(pool, size);
++        if self.demand_sized_foreground {
++            grown.min(FIRST_BLOCK_BYTES.max(size.next_power_of_two()))
++        } else {
++            grown
++        }
++    }
