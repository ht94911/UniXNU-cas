++    #[test]
++    fn foreground_backing_uses_request_size_and_preserves_room_refill() {
++        let _serial = lock(&SERIAL);
++        ALLOCATED.store(0, Ordering::Relaxed);
++        FREED.store(0, Ordering::Relaxed);
++        lock(&REQUESTED_BYTES).clear();
++        lock(&ALLOC_RESULTS).clear();
++        let driver = driver();
++        let mut state = allocator();
++        // Select only this policy for a host model; no Vulkan device identity
++        // or real driver timing is claimed by the test.
++        state.demand_sized_foreground = true;
++        state.kept = Some(vec![(Holds::Buffers, 0)]);
++        state
++            .pool(Holds::Buffers, 0)
++            .add(BLOCK_BYTES, false, block(1, BLOCK_BYTES), 43 << 20);
++        let memory = Mutex::new(state);
++        let requirements = vk::MemoryRequirements {
++            size: 24 << 20,
++            alignment: 4096,
++            memory_type_bits: 1,
++        };
++        let placement = place(
++            &memory,
++            &driver,
++            &requirements,
++            MemoryClass::Private,
++            None,
++            Holds::Buffers,
++            Fit::Pooled,
++        )
++        .unwrap();
++        assert_eq!(*lock(&REQUESTED_BYTES), vec![32 << 20]);
++        assert_eq!(placement.size, requirements.size);
++        assert_eq!(placement.offset, 0);
++        assert_eq!(placement.memory.as_raw(), 1000);
++        assert_eq!(lock(&memory).pool(Holds::Buffers, 0).room(), 21 << 20);
++
++        // The background reserve stays 64 MiB, with enough free range for
++        // the largest pooled placement. The next foreground request uses it.
++        keep_room(&memory, &driver, &Counters::default());
++        assert_eq!(*lock(&REQUESTED_BYTES), vec![32 << 20, BLOCK_BYTES]);
++        let next = place(
++            &memory,
++            &driver,
++            &requirements,
++            MemoryClass::Private,
++            None,
++            Holds::Buffers,
++            Fit::Pooled,
++        )
++        .unwrap();
++        assert_eq!(next.memory.as_raw(), 1001);
++        assert_eq!(ALLOCATED.load(Ordering::Relaxed), 2);
++        let mut state = lock(&memory);
++        state.free(&driver, &placement);
++        state.free(&driver, &next);
++        drop(state.destroy(&driver));
++        assert_eq!(FREED.load(Ordering::Relaxed), 3);
++    }
