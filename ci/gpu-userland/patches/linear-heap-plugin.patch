++//! Execute linear heap shadow construction, copies and merges on a real Vulkan
++//! device. Select the Turnip plan explicitly; the device keeps its real identity.
++
++use super::*;
++use crate::device::functions::Vk;
++use crate::shadow::{ShadowCopy, Step};
++use crate::shadow_merge::ShadowMerge;
++use crate::texture::kept_image::KeptImages;
++use crate::{DeviceKind, DeviceOptions, HazardTrackingMode, HeapDescriptor, ShaderCacheOptions};
++use std::path::PathBuf;
++
++struct Scratch(PathBuf);
++
++impl Drop for Scratch {
++    fn drop(&mut self) {
++        std::fs::remove_dir_all(&self.0).unwrap();
++    }
++}
++
++fn copy(
++    copies: &Arc<ShadowCopies>,
++    step: Step<Arc<ShadowMerge>>,
++    area: Option<[u32; 4]>,
++) -> ShadowCopy {
++    ShadowCopy {
++        copies: Arc::clone(copies),
++        step,
++        kept: false,
++        area,
++        cause: None,
++        moves: None,
++    }
++}
++
++fn assert_bytes(buffer: &Buffer, expected: &[u8], label: &str) {
++    // SAFETY: the shared buffer has this length; submission completed and made
++    // its writes available to HOST_READ before this comparison.
++    let actual =
++        unsafe { std::slice::from_raw_parts(buffer.contents().unwrap().as_ptr(), expected.len()) };
++    assert_eq!(
++        actual.iter().zip(expected).position(|(a, b)| a != b),
++        None,
++        "{label}"
++    );
++}
++
++unsafe fn barrier(raw: &Vk, cb: vk::CommandBuffer) {
++    let all = vk::MemoryBarrier::default()
++        .src_access_mask(vk::AccessFlags::MEMORY_READ | vk::AccessFlags::MEMORY_WRITE)
++        .dst_access_mask(vk::AccessFlags::MEMORY_READ | vk::AccessFlags::MEMORY_WRITE);
++    // SAFETY: the caller owns a live command buffer recording outside a pass.
++    unsafe {
++        raw.cmd_pipeline_barrier(
++            cb,
++            vk::PipelineStageFlags::ALL_COMMANDS,
++            vk::PipelineStageFlags::ALL_COMMANDS,
++            vk::DependencyFlags::empty(),
++            &[all],
++            &[],
++            &[],
++        );
++    }
++}
++
++unsafe fn host_read(raw: &Vk, cb: vk::CommandBuffer) {
++    let host = vk::MemoryBarrier::default()
++        .src_access_mask(vk::AccessFlags::MEMORY_WRITE)
++        .dst_access_mask(vk::AccessFlags::HOST_READ);
++    // SAFETY: as barrier; every writer in the submission precedes this call.
++    unsafe {
++        raw.cmd_pipeline_barrier(
++            cb,
++            vk::PipelineStageFlags::ALL_COMMANDS,
++            vk::PipelineStageFlags::HOST,
++            vk::DependencyFlags::empty(),
++            &[host],
++            &[],
++            &[],
++        );
++    }
++}
