+/// iOS checks the rotated storage width. The same plane still has to cover every
+/// stored row, fit the buffer, and keep the existing offset and pitch alignment.
+#[test]
+fn ios_rotated_surface_pitch_covers_the_stored_extent() {
+    for (width, height, pitch) in [(64, 16, 64), (2608, 1200, 4864)] {
+        for rotation in [1, 3, 4] {
+            let texture = over_a_plane(width, height, pitch);
+            let length = pitch * u64::from(width);
+            let buffer = BufferFacts { length };
+            let (_, placed) = turned_plane("t", &texture, rotation, &buffer, true).unwrap();
+            assert_eq!(placed.gpu.row_bytes, u64::from(height) * 4);
+            assert_eq!(placed.gpu.rows, u64::from(width));
+            assert_eq!(placed.gpu.row_pitch, pitch);
+            assert!(placed.gpu.end() <= length);
+            assert_eq!(placed.gpu.shared_bytes(), 0);
+            assert!(matches!(
+                turned_plane("t", &texture, rotation, &buffer, false),
+                Err(Error::Invalid(Invalid {
+                    problem: Problem::BufferTexture(BufferTextureProblem::RowPitch { .. }),
+                    ..
+                }))
+            ));
+        }
+    }
+    for (rotation, width, height, pitch) in [(1, 16, 64, 64), (2, 64, 16, 64)] {
+        let texture = over_a_plane(width, height, pitch);
+        assert!(matches!(
+            turned_plane("t", &texture, rotation, &BufferFacts { length: 4096 }, true),
+            Err(Error::Invalid(Invalid {
+                problem: Problem::BufferTexture(BufferTextureProblem::RowPitch { .. }),
+                ..
+            }))
+        ));
+    }
+    let texture = over_a_plane(64, 16, 64);
+    assert!(turned_plane("t", &texture, 1, &BufferFacts { length: 4095 }, true).is_err());
+    for texture in [
+        BufferTexture {
+            bytes_per_row: 63,
+            ..texture
+        },
+        BufferTexture {
+            offset: 1,
+            ..texture
+        },
+    ] {
+        assert_eq!(
+            turned_plane("t", &texture, 1, &BufferFacts { length: 8192 }, true),
+            Err(Error::NotImplemented(RuntimeGap::RotatedTexture))
+        );
+    }
+}
