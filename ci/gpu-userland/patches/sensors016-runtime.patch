+/// A landscape iOS drawable uses the portrait plane's pitch. Exercise the actual
+/// render and resolve copies at that pitch, then read the stored frame through a view.
+#[test]
+fn ios_landscape_surface_stores_and_resolves_at_the_portrait_pitch() {
+    let cache = ScratchCache::new().unwrap();
+    let messages = Messages::default();
+    let device = validated_device(TEST_DEVICE, &messages, cache.path()).unwrap();
+    let lane = Lane::new(&device);
+    let (w, h) = (64, 16);
+    let source = lane.naming(w, h);
+    for rotation in [1, 3, 4] {
+        let bpr = h * TEXEL;
+        let plane = plane(&lane, rotation, (w, h), bpr);
+        let mut descriptor = TextureDescriptor::texture_2d(PF, w, h, false);
+        descriptor.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        descriptor.resource_options = plane.resource_options();
+        descriptor.rotation = rotation;
+        descriptor.framebuffer_only = true;
+        let texture = plane
+            .new_texture_with_iosurface_plane(
+                &descriptor,
+                IoSurfacePlane::new(0, bpr, false).with_stored_rotation_rows(),
+            )
+            .unwrap();
+        for resolve in [false, true] {
+            let before = bytes_of(&plane);
+            lane.pass(&texture, LoadAction::Clear, resolve, &source, (w, h));
+            let want = expected(rotation, (w, h), bpr, (w, h), &before, |_, _| [0; 4]);
+            assert_eq!(
+                bytes_of(&plane),
+                want,
+                "rotation {rotation}, resolve {resolve}"
+            );
+        }
+        let view = texture.new_texture_view(PixelFormat::RGBA8Unorm).unwrap();
+        let mut output = TextureDescriptor::texture_2d(PF, h, w, false);
+        output.usage = TextureUsage::RENDER_TARGET;
+        let output = device.new_texture(&output).unwrap();
+        lane.pass(&output, LoadAction::Clear, false, &view, (h, w));
+        let mut pixels = vec![0; (w * h * TEXEL) as usize];
+        output
+            .get_bytes(&mut pixels, h * TEXEL, 0, Region::new_2d(0, 0, h, w), 0, 0)
+            .unwrap();
+        // Interpreting the BGRA plane as RGBA swaps its red and blue channels.
+        let physical = bytes_of(&plane);
+        for (got, want) in pixels
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .zip(physical.as_chunks::<4>().0)
+        {
+            assert_eq!(
+                got,
+                &[want[2], want[1], want[0], want[3]],
+                "rotation {rotation} view"
+            );
+        }
+        lane.kept(&texture);
+        assert_eq!(bytes_of(&plane), physical, "rotation {rotation} empty pass");
+        eprintln!("IOS-ROTATED-PASS rotation {rotation}: portrait pitch, render, resolve and view readback");
+    }
+    quiet(&messages);
+}
+
+/// The device's 2608x1200 landscape frame fits its 1200x2608 IOSurface at
+/// 4864 bytes per row. Check the actual copied pixel bytes and every padding byte.
+#[test]
+fn ios_phone_landscape_frame_preserves_pixels_and_row_padding() {
+    let cache = ScratchCache::new().unwrap();
+    let messages = Messages::default();
+    let device = validated_device(TEST_DEVICE, &messages, cache.path()).unwrap();
+    let lane = Lane::new(&device);
+    let (w, h, bpr) = (2608, 1200, 4864);
+    let source = lane.naming(w, h);
+    for rotation in [1, 3] {
+        let plane = plane(&lane, rotation, (w, h), bpr);
+        let mut descriptor = TextureDescriptor::texture_2d(PF, w, h, false);
+        descriptor.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        descriptor.resource_options = plane.resource_options();
+        descriptor.rotation = rotation;
+        descriptor.framebuffer_only = true;
+        let texture = plane
+            .new_texture_with_iosurface_plane(
+                &descriptor,
+                IoSurfacePlane::new(0, bpr, false).with_stored_rotation_rows(),
+            )
+            .unwrap();
+        let before = bytes_of(&plane);
+        lane.pass(&texture, LoadAction::Clear, false, &source, (w, h));
+        let want = expected(rotation, (w, h), bpr, (w, h), &before, |_, _| [0; 4]);
+        let got = bytes_of(&plane);
+        if let Some(at) = first_difference(&got, &want, bpr) {
+            panic!("phone rotation {rotation}: {at}");
+        }
+        eprintln!(
+            "IOS-PHONE-ROTATION {rotation}: {} pixel and padding bytes matched",
+            got.len()
+        );
+    }
+    quiet(&messages);
+}
