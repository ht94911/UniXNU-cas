 }
 
+fn function_reflection_handle(reflection: Option<metal2vulkan::reflection::FunctionReflection>) -> Result<*mut NmbReflection, String> {
+    let Some(reflection) = reflection else { return Ok(std::ptr::null_mut()); };
+    let mut json = String::from("{");
+    reflection_json::stage(&mut json, "bindings", reflection.bindings());
+    json.push('}');
+    reflection_handle(json)
+}
+
+/// # Safety
+/// `bytes` holds `length` bytes, `name` is a C string, and `out` is writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_library_function_reflection(bytes: *const c_void, length: usize, name: *const c_char,
+                                                        out: *mut *mut NmbReflection) -> bool {
+    guard(false, || {
+        // SAFETY: the caller's contract.
+        let out = unsafe { out.as_mut() }.ok_or("null reflection output")?;
+        *out = std::ptr::null_mut();
+        if name.is_null() || bytes.is_null() || length == 0 { return Err("library bytes and function name are required".into()); }
+        // SAFETY: the caller's contract.
+        let name = unsafe { CStr::from_ptr(name) }.to_str().map_err(e("function name"))?;
+        // The compile-layer metadata needs no Vulkan device or submission.
+        let bytes = unsafe { std::slice::from_raw_parts(bytes.cast::<u8>(), length) };
+        let library = metal2vulkan::library::Library::parse(bytes).map_err(e("reflection library"))?;
+        let function = library.function(name).map_err(e("reflection function"))?;
+        let reflection = function.reflection(&metal2vulkan::Budget::standard()).map_err(e("function reflection"))?;
+        *out = function_reflection_handle(reflection)?;
+        Ok(true)
+    })
+}
+
