@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: MIT
+// Metal's public ARGR table describes value parameters of external functions.
+// It is separate from RFLT, which describes resource bindings in compiled stages.
+#pragma once
+#import <Foundation/Foundation.h>
+#include <cstring>
+
+struct NBPublicMetadataReader {
+ const uint8_t *bytes;
+ size_t length,at=0;
+ bool take(size_t count,const uint8_t **out) {
+  if(count>length-at)return false;
+  *out=bytes+at;at+=count;return true;
+ }
+ template<class T> bool word(T *out) {
+  const uint8_t *p;if(!take(sizeof(T),&p))return false;
+  memcpy(out,p,sizeof(T));return true;
+ }
+ NSString *string() {
+  const void *end=memchr(bytes+at,0,length-at);if(!end)return nil;
+  const size_t count=(const uint8_t *)end-(bytes+at);
+  NSString *answer=[[NSString alloc] initWithBytes:bytes+at length:count encoding:NSUTF8StringEncoding];
+  at+=count+1;return answer;
+ }
+ NSDictionary *type(uint8_t kind,unsigned depth=0) {
+  if(depth>length)return nil;
+  NSMutableDictionary *json=[NSMutableDictionary dictionaryWithObject:@(kind) forKey:@"dataType"];
+  if(kind==1) {
+   uint8_t count;if(!word(&count))return nil;
+   NSMutableArray *members=[NSMutableArray array];
+   for(unsigned i=0;i<count;i++) {
+    NSString *name=string();uint8_t memberKind;uint32_t index;
+    if(!name || !word(&memberKind) || !word(&index))return nil;
+    NSDictionary *details=type(memberKind,depth+1);if(!details)return nil;
+    NSMutableDictionary *member=[NSMutableDictionary dictionaryWithDictionary:@{
+     @"name":name,@"dataType":@(memberKind),@"offset":@0,@"argumentIndex":@(index),@"details":details}];
+    attach(member,details);[members addObject:member];
+   }
+   json[@"members"]=members;
+  } else if(kind==2) {
+   uint32_t count,stride;uint8_t element;
+   if(!word(&count) || !word(&stride) || !word(&element))return nil;
+   NSDictionary *details=type(element,depth+1);if(!details)return nil;
+   json[@"length"]=@(count);json[@"stride"]=@(stride);json[@"elementType"]=@(element);
+   attach(json,details);
+  } else if(kind==58) {
+   uint8_t element,flags;uint32_t count;
+   if(!word(&element) || !word(&count) || !word(&flags))return nil;
+   json[@"elementType"]=@(element);json[@"textureType"]=@(flags&31);
+   json[@"access"]=@((flags>>5)&3);json[@"depth"]=@((flags>>7)!=0);
+   if(count>=2)return @{@"dataType":@2,@"elementType":@58,@"length":@(count),@"stride":@0,@"texture":json};
+  } else if(kind==60) {
+   uint8_t access,alignment,element;uint64_t size;
+   if(!word(&access) || !word(&alignment) || !word(&size) || !word(&element))return nil;
+   NSDictionary *details=type(element,depth+1);if(!details)return nil;
+   json[@"elementType"]=@(element);json[@"access"]=@(access);json[@"alignment"]=@(alignment);
+   // Original24A446's typeFromBuffer reserves eight bytes and reads the low u16.
+   json[@"size"]=@(size&0xffff);json[@"argumentBuffer"]=@(indirectArguments(details));
+   attach(json,details);
+  }
+  return json;
+ }
+ static void attach(NSMutableDictionary *json,NSDictionary *details) {
+  switch([details[@"dataType"] unsignedIntValue]) {
+   case 1:json[@"struct"]=details;break;
+   case 2:json[@"array"]=details;break;
+   case 58:json[@"texture"]=details;break;
+   case 60:json[@"pointer"]=details;break;
+  }
+ }
+ static bool indirectArguments(NSDictionary *type) {
+  const unsigned kind=[type[@"dataType"] unsignedIntValue];
+  if(kind==1) {
+   for(NSDictionary *member in type[@"members"])if(indirectArguments(member[@"details"]))return true;
+   return false;
+  }
+  if(kind==2) {
+   NSDictionary *element=type[@"struct"]?:type[@"array"];
+   return element?indirectArguments(element):indirectArguments(@{@"dataType":type[@"elementType"]});
+  }
+  return (kind>=57 && kind<=60) || (kind>=78 && kind<=80) || (kind>=139 && kind<=141);
+ }
+};
+
+// found distinguishes an absent ARGR tag from a malformed table. Only a
+// complete table is published; an explicit zero count is a real empty array.
+static NSDictionary *nbPublicFunctionArguments(const uint8_t *file,size_t length,
+                                               NSString *wanted,bool *found) {
+ *found=false;
+ if(!file || !wanted || length<88 || memcmp(file,"MTLB",4))return nil;
+ uint64_t list,listSize,publicAt,publicSize;
+ memcpy(&list,file+24,8);memcpy(&listSize,file+32,8);
+ memcpy(&publicAt,file+40,8);memcpy(&publicSize,file+48,8);
+ if(list>length || length-list<4 || listSize>length-list-4 || publicAt>length || publicSize>length-publicAt)return nil;
+ const size_t listEnd=list+4+listSize;uint32_t count;memcpy(&count,file+list,4);
+ size_t at=list+4;
+ for(uint32_t i=0;i<count;i++) {
+  if(listEnd-at<4)return nil;
+  uint32_t size;memcpy(&size,file+at,4);if(size<8 || size>listEnd-at)return nil;
+  NBPublicMetadataReader entry{file+at+4,size-4};NSString *name=nil;uint64_t metadataOffset=0;bool placed=false,ended=false;
+  while(entry.at<entry.length) {
+   const uint8_t *tag;if(!entry.take(4,&tag))return nil;
+   if(!memcmp(tag,"ENDT",4)){ended=true;break;}
+   uint16_t bytes;const uint8_t *value;if(!entry.word(&bytes) || !entry.take(bytes,&value))return nil;
+   if(!memcmp(tag,"NAME",4)) {
+    const void *end=memchr(value,0,bytes);if(!end)return nil;
+    name=[[NSString alloc] initWithBytes:value length:(const uint8_t *)end-value encoding:NSUTF8StringEncoding];
+   } else if(!memcmp(tag,"OFFT",4) && bytes==24) {memcpy(&metadataOffset,value,8);placed=true;}
+  }
+  if(!ended)return nil;
+  if([name isEqualToString:wanted]) {
+   if(!placed || metadataOffset>publicSize || publicSize-metadataOffset<4)return nil;
+   const uint8_t *block=file+publicAt+metadataOffset;uint32_t blockSize;memcpy(&blockSize,block,4);
+   if(blockSize<8 || blockSize>publicSize-metadataOffset)return nil;
+   NBPublicMetadataReader metadata{block+4,blockSize-4};NSMutableDictionary *answer=nil;
+   while(metadata.at<metadata.length) {
+    const uint8_t *tag;if(!metadata.take(4,&tag))return nil;
+    if(!memcmp(tag,"ENDT",4))return answer;
+    uint16_t bytes;const uint8_t *value;if(!metadata.word(&bytes) || !metadata.take(bytes,&value))return nil;
+    if(!memcmp(tag,"RETR",4)) {
+     *found=true;if(answer[@"returnType"])return nil;
+     NBPublicMetadataReader result{value,bytes};uint8_t kind;if(!result.word(&kind))return nil;
+     NSDictionary *type=result.type(kind);if(!type || result.at!=result.length)return nil;
+     if(!answer)answer=[NSMutableDictionary dictionary];answer[@"returnType"]=type;continue;
+    }
+    if(memcmp(tag,"ARGR",4))continue;
+    *found=true;if(answer[@"bindings"])return nil;
+    NBPublicMetadataReader arguments{value,bytes};uint8_t argumentCount;if(!arguments.word(&argumentCount))return nil;
+    NSMutableArray *bindings=[NSMutableArray array];
+    for(unsigned j=0;j<argumentCount;j++) {
+     NSString *argumentName=arguments.string();uint8_t kind;
+     if(!argumentName || !arguments.word(&kind))return nil;
+     NSDictionary *details=arguments.type(kind);if(!details)return nil;
+     [bindings addObject:@{@"name":argumentName,@"type":@18,@"index":@0,@"access":@0,
+                          @"used":@YES,@"argument":@NO,@"publicType":details}];
+    }
+    if(arguments.at!=arguments.length)return nil;
+    if(!answer)answer=[NSMutableDictionary dictionary];answer[@"bindings"]=bindings;
+   }
+   return nil;
+  }
+  at+=size;
+ }
+ return nil;
+}
