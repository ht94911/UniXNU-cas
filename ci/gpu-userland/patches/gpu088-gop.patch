+// A single IOSurface plane is a bounded view of the descriptor, not the
+// surface-wide row pitch. Extended-pixel origins require a separate contract;
+// accept only a data base equal to the plane offset for now.
+static inline int native_legacy_plane_bounds(uint32_t width,uint32_t height,
+    uint32_t pixelBytes,uint64_t planeWidth,uint64_t planeHeight,uint64_t stride,
+    uint64_t offset,uint64_t base,uint64_t bytes,uint64_t descriptorBytes) {
+    if ((pixelBytes!=4 && pixelBytes!=8) || planeWidth<width || planeHeight<height ||
+        offset!=base || offset>descriptorBytes || bytes>descriptorBytes-offset ||
+        stride<(uint64_t)width*pixelBytes) return 0;
+    return native_legacy_surface_bounds(width,height,stride,bytes,bytes);
+}
