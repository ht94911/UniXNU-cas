+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include <stdint.h>
+/* CPU-only cumulative metrics, individually atomic. Differences over a
+ * measured interval are meaningful; this is not one hardware-atomic sample.
+ * jobs: submit,retire,last submit us,last retire us,GPU ticks,total valid
+ * stamps,max GPU ticks,total submit wall us,max submit wall us,total lifetime
+ * us,max lifetime us,last issued fence,last retired fence,reserved.
+ * GPU timestamps count CP_ALWAYS_ON ticks at 19.2 MHz, not CPU ticks.
+ */
+struct NativeAdrenoPerfSample {
+    uint64_t jobs[14],cache[5],reassert_ticks,cpu_us;
+    uint32_t cpu_valid,cpu[8][4];
+};
+extern "C" {
+extern uint64_t native_adreno_perf_jobs[14];
+bool native_adreno_perf_sample(NativeAdrenoPerfSample *);
+void native_adreno_perf_calls(uint64_t out[18][4]);
+}
diff --git a/NativeAdrenoPollLog.h b/NativeAdrenoPollLog.h
new file mode 100644
index 0000000..62daa85
--- /dev/null
+++ b/NativeAdrenoPollLog.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include <stdint.h>
+
+/* A timeout is also the normal answer to a pending fence/frame poll. Keep
+ * every occurrence in an atomic counter, and print the first four and powers
+ * of two. The independent observer reports changing totals every two seconds.
+ * This only decides whether to repeat a log line; it cannot alter an RPC.
+ */
+struct NativeAdrenoPollLog {
+    uint64_t counts[2]{};
+    bool keep(unsigned kind) {
+        if(kind>=2)return true;
+        const uint64_t n=__atomic_add_fetch(&counts[kind],uint64_t(1),__ATOMIC_RELAXED);
+        return n<=4 || (n && !(n&(n-1)));
+    }
+    uint64_t count(unsigned kind) const {
+        return kind<2?__atomic_load_n(&counts[kind],__ATOMIC_RELAXED):0;
+    }
+};
