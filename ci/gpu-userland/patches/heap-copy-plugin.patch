++/// Feasibility only: fixed, separately owned buffers, with no pending merge or
++/// rebound host pages. This does not change how an encoder records a shadow.
++#[test]
++fn direct_tiled_output_runs_real_vulkan() {
++    use crate::texture::heap_tiled::{Elements, TiledLayout};
++    use metal2vulkan::metal::TextureType;
++    let scratch = Scratch::new("direct-tiled-output");
++    let device = device(&scratch.0);
++    for (extent, count, kind, slices) in [
++        ([64, 64, 1], 1, TextureType::Type2D, 1),
++        ([129, 97, 2], 3, TextureType::Type3D, 1),
++        ([191, 132, 1], 3, TextureType::Type2DArray, 2),
++        ([1204, 2328, 1], 1, TextureType::Type2D, 1),
++    ] {
++        let layout = TiledLayout::of(8, Elements::Texels, kind, extent, count, slices).unwrap();
++        let mut tight_len = 0_u32;
++        let levels: Vec<_> = layout
++            .levels
++            .iter()
++            .map(|level| {
++                let images = if layout.volume {
++                    level.depth
++                } else {
++                    layout.chains
++                } as u32;
++                let item = TiledLevelMove::new(
++                    8,
++                    level.extent.map(|v| v as u32),
++                    images,
++                    level.tile.map(|v| v as u32),
++                    level.across as u32,
++                    level.base as u32,
++                    layout.stride as u32,
++                    tight_len,
++                    level.bytes as u32,
++                );
++                tight_len += level.extent[0] as u32 * level.extent[1] as u32 * images * 8;
++                item
++            })
++            .collect();
++        let heap: Vec<u8> = (0..layout.size)
++            .map(|i| (i * 13 + i / 251 + 5) as u8)
++            .collect();
++        let tight: Vec<u8> = (0..tight_len)
++            .map(|i| (i * 7 + i / 257 + 3) as u8)
++            .collect();
++        let mut wanted = heap.clone();
++        for level in &levels {
++            wanted = expected(level, false, &tight, &wanted).1;
++        }
++        let (shape, grid) = match levels.as_slice() {
++            [level] => TiledTexelsModule::tiled_dispatch(level, false).unwrap(),
++            _ => {
++                let groups = TiledTexelsModule::invocations(&levels, false).div_ceil(64);
++                let y = groups.div_ceil(65535);
++                let x = groups.div_ceil(y);
++                (
++                    TiledTexelsModule::shape(&levels, false, x * 64).unwrap(),
++                    [x, y, 1],
++                )
++            }
++        };
++        let output = device
++            .new_buffer_with_bytes(&heap, ResourceOptions::shared())
++            .unwrap();
++        let input = device
++            .new_buffer_with_bytes(&tight, ResourceOptions::shared())
++            .unwrap();
++        let shape_buffer = device
++            .new_buffer_with_bytes(&shape, ResourceOptions::shared())
++            .unwrap();
++        let kernel = device.owned_kernel(OwnedModule::TiledTexels).unwrap();
++        let binding = |b: &Buffer, len: usize| {
++            let (raw, offset) = b.at(0);
++            (raw, offset, len as u64)
++        };
++        let sets = OwnedSets::write(
++            &device,
++            &kernel,
++            &[vec![
++                binding(&input, tight.len()),
++                binding(&output, heap.len()),
++                binding(&shape_buffer, shape.len()),
++            ]],
++        )
++        .unwrap();
++        let mut times = Vec::new();
++        for _ in 0..4 {
++            let begin = Instant::now();
++            device
++                .submit_internal(|raw, cb| {
++                    let before = vk::MemoryBarrier::default()
++                        .src_access_mask(vk::AccessFlags::HOST_WRITE)
++                        .dst_access_mask(
++                            vk::AccessFlags::SHADER_READ | vk::AccessFlags::SHADER_WRITE,
++                        );
++                    let after = vk::MemoryBarrier::default()
++                        .src_access_mask(vk::AccessFlags::SHADER_WRITE)
++                        .dst_access_mask(vk::AccessFlags::HOST_READ);
++                    // SAFETY: every descriptor names live, separately owned buffers;
++                    // the shape limits every write, and submit_internal waits.
++                    unsafe {
++                        raw.cmd_pipeline_barrier(
++                            cb,
++                            vk::PipelineStageFlags::HOST,
++                            vk::PipelineStageFlags::COMPUTE_SHADER,
++                            vk::DependencyFlags::empty(),
++                            &[before],
++                            &[],
++                            &[],
++                        );
++                        raw.cmd_bind_pipeline(cb, vk::PipelineBindPoint::COMPUTE, kernel.pipeline);
++                        raw.cmd_bind_descriptor_sets(
++                            cb,
++                            vk::PipelineBindPoint::COMPUTE,
++                            kernel.layout,
++                            0,
++                            &[sets.sets[0]],
++                            &[],
++                        );
++                        raw.cmd_dispatch(cb, grid[0], grid[1], grid[2]);
++                        raw.cmd_pipeline_barrier(
++                            cb,
++                            vk::PipelineStageFlags::COMPUTE_SHADER,
++                            vk::PipelineStageFlags::HOST,
++                            vk::DependencyFlags::empty(),
++                            &[after],
++                            &[],
++                            &[],
++                        );
++                    }
++                })
++                .unwrap();
++            times.push(begin.elapsed().as_secs_f64() * 1000.0);
++            assert_bytes("direct heap, including untouched padding", &output, &wanted);
++            assert_bytes("direct input unchanged", &input, &tight);
++        }
++        eprintln!(
++            "DIRECT-VULKAN {extent:?} levels{count} {kind:?}: zero buffer copies; submit-wait-ms {times:?}"
++        );
++    }
++}
