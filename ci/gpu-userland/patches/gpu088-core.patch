++   rec.fence = fence;
++   if (darwin_submit_trace_on()) {
++      const uint32_t seq = p_atomic_inc_return(&darwin_submit_seq);
++      rec.seq = seq;
++      darwin_submit_ring[seq % 512] = rec;
++   }
++
++   for (uint32_t i = 0; i < signal_count; i++) {
++      struct vk_darwin_sync *s = container_of(signals[i].sync, struct vk_darwin_sync, vk);
++      tu_frame_event(43,(uintptr_t)submit,1,(uintptr_t)s,s->state,fence,signals[i].signal_value);
++      s->fence = fence;
++      p_atomic_set(&s->state, fence ? DARWIN_SYNC_FENCE : DARWIN_SYNC_SIGNALED);
++   }
++   if (dev->darwin_retire)
++      ((struct darwin_retire_state *)dev->darwin_retire)->timeline_seq++;
++   pthread_cond_broadcast(&dev->timeline_cond);
++
++   if (u_trace_submission_data)
++      u_trace_submission_data->gpu_ts_offset = 0;
++   return VK_SUCCESS;
++}
