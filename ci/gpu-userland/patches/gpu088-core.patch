++static void *
++darwin_fence_watcher_main(void *arg)
++{
++   struct darwin_retire_state *retire = (struct darwin_retire_state *)arg;
++   struct tu_device *dev = retire->fence_watcher_dev;
++   pthread_mutex_lock(&dev->submit_mutex);
++   while (!retire->fence_watcher_stop) {
++      uint32_t target = retire->fence_watcher_target;
++      if (!target || (retire->fence_watcher_has_done &&
++                      (int32_t)(retire->fence_watcher_done - target) >= 0)) {
++         pthread_cond_wait(&retire->fence_watcher_cond, &dev->submit_mutex);
++         continue;
++      }
++      pthread_mutex_unlock(&dev->submit_mutex);
++      /* Sleep in kernel on GPU fence interrupt with a 50 ms slice so device teardown joins promptly. */
++      uint64_t slice_deadline = os_time_get_nano() + 50000000ull;
++      VkResult res = dw_wait_fence_locked_free(dev, target, slice_deadline);
++      pthread_mutex_lock(&dev->submit_mutex);
++      if (res == VK_SUCCESS) {
++         if (!retire->fence_watcher_has_done ||
++             (int32_t)(target - retire->fence_watcher_done) > 0) {
++            retire->fence_watcher_done = target;
++            retire->fence_watcher_has_done = true;
++         }
++         retire->fence_watcher_error = VK_SUCCESS;
++         if (retire->fence_watcher_target == target)
++            retire->fence_watcher_target = 0;
++         retire->timeline_seq++;
++         pthread_cond_broadcast(&dev->timeline_cond);
++      } else if (res != VK_TIMEOUT) {
++         /* Keep the watcher alive until device teardown so fence_watcher_started stays accurate
++          * and future waits never strand; propagate the error immediately to waiting callers. */
++         retire->fence_watcher_error = res;
++         retire->fence_watcher_target = 0;
++         retire->timeline_seq++;
++         pthread_cond_broadcast(&dev->timeline_cond);
++      }
++   }
++   pthread_mutex_unlock(&dev->submit_mutex);
++   return NULL;
++}
