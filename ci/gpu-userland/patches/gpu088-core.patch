++static VkResult
++vk_darwin_timeline_wait_many(struct vk_device *_device, uint32_t wait_count,
++                             const struct vk_sync_wait *waits,
++                             enum vk_sync_wait_flags wait_flags, uint64_t abs_timeout_ns)
++{
++   struct tu_device *device = container_of(_device, struct tu_device, vk);
++   struct darwin_retire_state *retire = (struct darwin_retire_state *)device->darwin_retire;
++
++   if (!(wait_flags & VK_SYNC_WAIT_ANY) || wait_count <= 1 || !retire) {
++      for (uint32_t i = 0; i < wait_count; i++) {
++         VkResult result = darwin_timeline_wait_orig(_device, waits[i].sync, waits[i].wait_value,
++                                                     (enum vk_sync_wait_flags)(wait_flags & ~VK_SYNC_WAIT_ANY), abs_timeout_ns);
++         if (result != VK_SUCCESS)
++            return result;
++      }
++      return VK_SUCCESS;
++   }
++
++   for (;;) {
++      if (vk_device_is_lost(_device))
++         return VK_ERROR_DEVICE_LOST;
++
++      pthread_mutex_lock(&device->submit_mutex);
++      uint64_t seq = retire->timeline_seq;
++      bool has_done = retire->fence_watcher_has_done;
++      uint32_t done_fence = retire->fence_watcher_done;
++      pthread_mutex_unlock(&device->submit_mutex);
++
++      bool has_fence = false;
++      bool has_unsubmitted = false;
++      uint32_t min_fence = 0;
++      uint32_t fence_wait_index = 0;
++
++      for (uint32_t i = 0; i < wait_count; i++) {
++         if (waits[i].wait_value == 0)
++            return VK_SUCCESS;
++         struct vk_sync_timeline *tl = vk_sync_as_timeline(waits[i].sync);
++         if (!tl) {
++            VkResult r = darwin_timeline_wait_orig(_device, waits[i].sync, waits[i].wait_value,
++                                                   (enum vk_sync_wait_flags)(wait_flags & ~VK_SYNC_WAIT_ANY), 0);
++            if (r != VK_TIMEOUT)
++               return r;
++            has_unsubmitted = true;
++            continue;
++         }
++         struct vk_sync_timeline_state *state = tl->state;
++         bool ready_now = false;
++         bool check_fence_now = false;
++         bool found_fence = false;
++         uint32_t found_fence_val = 0;
++
++         mtx_lock(&state->mutex);
++         if (state->highest_past >= waits[i].wait_value) {
++            ready_now = true;
++         } else if ((wait_flags & VK_SYNC_WAIT_PENDING) &&
++                    state->highest_pending >= waits[i].wait_value) {
++            ready_now = true;
++         } else {
++            bool matched = false;
++            bool blocked_unsubmitted = false;
++            bool need_fence = false;
++            uint32_t max_fence = 0;
++            list_for_each_entry(struct vk_sync_timeline_point, pt, &state->pending_points, link) {
++               struct vk_darwin_sync *s = container_of(&pt->sync, struct vk_darwin_sync, vk);
++               enum darwin_sync_state st = (enum darwin_sync_state)p_atomic_read(&s->state);
++               if (st == DARWIN_SYNC_UNSIGNALED) {
++                  blocked_unsubmitted = true;
++               } else if (st == DARWIN_SYNC_FENCE) {
++                  if (!need_fence || (int32_t)(s->fence - max_fence) > 0) {
++                     max_fence = s->fence;
++                     need_fence = true;
++                  }
++               }
++               if (pt->value >= waits[i].wait_value) {
++                  matched = true;
++                  break;
++               }
++            }
++            if (!matched || blocked_unsubmitted) {
++               has_unsubmitted = true;
++            } else if (!need_fence) {
++               check_fence_now = true;
++            } else {
++               found_fence = true;
++               found_fence_val = max_fence;
++               if (has_done && (int32_t)(done_fence - found_fence_val) >= 0)
++                  check_fence_now = true;
++            }
++         }
++         mtx_unlock(&state->mutex);
++
++         if (ready_now)
++            return VK_SUCCESS;
++         if (check_fence_now) {
++            VkResult r = darwin_timeline_wait_orig(_device, waits[i].sync, waits[i].wait_value,
++                                                   (enum vk_sync_wait_flags)(wait_flags & ~VK_SYNC_WAIT_ANY), 0);
++            if (r != VK_TIMEOUT)
++               return r;
++         }
++         if (found_fence && (!has_fence || (int32_t)(found_fence_val - min_fence) < 0)) {
++            has_fence = true;
++            min_fence = found_fence_val;
++            fence_wait_index = i;
++         }
++      }
++
++      if (abs_timeout_ns == 0) {
++         if (has_fence) {
++            VkResult r = darwin_timeline_wait_orig(_device, waits[fence_wait_index].sync,
++                                                   waits[fence_wait_index].wait_value,
++                                                   (enum vk_sync_wait_flags)(wait_flags & ~VK_SYNC_WAIT_ANY), 0);
++            if (r != VK_TIMEOUT)
++               return r;
++         }
++         return VK_TIMEOUT;
++      }
++
++      if (abs_timeout_ns != UINT64_MAX && os_time_get_nano() >= abs_timeout_ns)
++         return VK_TIMEOUT;
++
++      if (has_fence && !has_unsubmitted) {
++         VkResult r = dw_wait_fence_locked_free(device, min_fence, abs_timeout_ns);
++         if (r == VK_SUCCESS) {
++            pthread_mutex_lock(&device->submit_mutex);
++            if (!retire->fence_watcher_has_done ||
++                (int32_t)(min_fence - retire->fence_watcher_done) > 0) {
++               retire->fence_watcher_done = min_fence;
++               retire->fence_watcher_has_done = true;
++            }
++            pthread_mutex_unlock(&device->submit_mutex);
++            continue;
++         }
++         return r;
++      }
++
++      pthread_mutex_lock(&device->submit_mutex);
++      if (retire->timeline_seq != seq) {
++         pthread_mutex_unlock(&device->submit_mutex);
++         continue;
++      }
++      if (has_fence) {
++         if (retire->fence_watcher_error != VK_SUCCESS) {
++            VkResult watcher_err = retire->fence_watcher_error;
++            retire->fence_watcher_error = VK_SUCCESS;
++            pthread_mutex_unlock(&device->submit_mutex);
++            VkResult r = darwin_timeline_wait_orig(_device, waits[fence_wait_index].sync,
++                                                   waits[fence_wait_index].wait_value,
++                                                   (enum vk_sync_wait_flags)(wait_flags & ~VK_SYNC_WAIT_ANY), 0);
++            return r != VK_TIMEOUT ? r : watcher_err;
