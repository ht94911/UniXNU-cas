++static VkResult
++vk_darwin_sync_wait_many(struct vk_device *_device, uint32_t wait_count,
++                         const struct vk_sync_wait *waits,
++                         enum vk_sync_wait_flags wait_flags, uint64_t abs_timeout_ns)
++{
++   struct tu_device *device = container_of(_device, struct tu_device, vk);
++
++   if (wait_flags & VK_SYNC_WAIT_PENDING)
++      return VK_SUCCESS;
++
++   if ((wait_flags & VK_SYNC_WAIT_ANY) && wait_count > 1) {
++      for (;;) {
++         bool all_fences = true;
++         uint32_t min_fence = 0;
++         bool have_min = false;
++         for (uint32_t i = 0; i < wait_count; i++) {
++            struct vk_darwin_sync *s = container_of(waits[i].sync, struct vk_darwin_sync, vk);
++            enum darwin_sync_state st = (enum darwin_sync_state)p_atomic_read(&s->state);
++            if (st == DARWIN_SYNC_SIGNALED)
++               return VK_SUCCESS;
++            if (st == DARWIN_SYNC_FENCE) {
++               if (!have_min || (int32_t)(s->fence - min_fence) < 0) {
++                  min_fence = s->fence;
++                  have_min = true;
++               }
++            } else {
++               all_fences = false;
++            }
++         }
++         if (all_fences && have_min)
++            return dw_wait_fence_locked_free(device, min_fence, abs_timeout_ns);
++         if (have_min && dw_wait_fence_locked_free(device, min_fence, 0) == VK_SUCCESS)
++            return VK_SUCCESS;
++         if (abs_timeout_ns == 0 ||
++             (abs_timeout_ns != UINT64_MAX && os_time_get_nano() >= abs_timeout_ns))
++            return VK_TIMEOUT;
++         usleep(200);
++      }
++   }
++
++   for (uint32_t i = 0; i < wait_count; i++) {
++      struct vk_darwin_sync *s = container_of(waits[i].sync, struct vk_darwin_sync, vk);
++      VkResult result = darwin_sync_wait(device, s, abs_timeout_ns);
++      if (result != VK_SUCCESS)
++         return result;
++   }
++   return VK_SUCCESS;
++}
