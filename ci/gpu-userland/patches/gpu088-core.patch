++#ifdef __APPLE__
++/* The clock every trace of the stack uses (CLOCK_UPTIME_RAW: the kernel's mach_absolute_time and the frontend's nowUs()), so rows join by time. */
++static inline uint64_t tu_trace_clock_ns(void) {return clock_gettime_nsec_np(CLOCK_UPTIME_RAW);}
++#else
++static inline uint64_t tu_trace_clock_ns(void) {return os_time_get_nano();}
++#endif
++
++/* The last 512 kernel submissions of this process (tu_darwin_submit_ring_read): when each was handed to the kernel, which fence it got,
++ * and where its time went before and inside the call (waiting for an unsubmitted sync, the kernel's ring having no room).
++ */
++struct tu_darwin_submit_rec {
++   uint64_t ns;            /* os_time_get_nano() when darwin_queue_submit began */
++   uint32_t seq;
++   uint32_t fence;         /* the kernel fence of the last chunk, 0 when nothing was run */
++   uint32_t sync_wait_us;  /* waiting for a sync that was not yet submitted */
++   uint32_t call_us;       /* the kernel calls, ring-space waits included */
++   uint32_t space_wait_us; /* of call_us, waiting for ring space */
++   uint16_t busy;          /* kIOReturnBusy answers */
++   uint8_t chunks;         /* kernel submissions; bit 7: one of the cuts fell inside a command stream */
++   uint8_t buffers;        /* indirect buffers in all chunks, 255 at most */
++};
++static_assert(sizeof(struct tu_darwin_submit_rec) == 32, "submit record");
++static struct tu_darwin_submit_rec darwin_submit_ring[512];
++static uint32_t darwin_submit_seq;
++
++/* The host's diagnostics switch (SHENG_DIAG, set by the plugin from diag=1): without it no submission is kept in the ring. */
++static bool
++darwin_submit_trace_on(void)
++{
++   static int on = -1;
++   if (on < 0)
++      on = getenv("SHENG_DIAG") != NULL;
++   return on;
++}
++
++extern "C" __attribute__((visibility("default"))) uint32_t tu_darwin_submit_ring_read(uint32_t from, struct tu_darwin_submit_rec *out,
++                                                                                    uint32_t max, uint32_t *newest);
++extern "C" __attribute__((visibility("default"))) uint32_t
++tu_darwin_submit_ring_read(uint32_t from, struct tu_darwin_submit_rec *out, uint32_t max, uint32_t *newest)
++{
++   const uint32_t last = p_atomic_read(&darwin_submit_seq);
++   *newest = last;
++   uint32_t first = from ? from : 1;
++   if (first > last)
++      return 0;
++   if (last - first >= 512)
++      first = last - 511;
++   uint32_t n = 0;
++   for (uint32_t s = first; s <= last && n < max; s++) {
++      const struct tu_darwin_submit_rec rec = darwin_submit_ring[s % 512];
++      if (rec.seq == s)
++         out[n++] = rec;
++   }
++   return n;
++}
++
++/* Busy can mean that a different VM owns the A840 ring. Once this
++ * connection's oldest fence completed it must leave the retry history; polling
++ * that already-retired fence cannot make the other VM drain. Sleep briefly
++ * when no local job remains, without holding the connection or retirement lock.
++ * The kernel still proves real RPTR/RBBM idle before changing TTBR0. */
++static VkResult
++darwin_wait_submit_room(struct tu_device *dev)
++{
++   struct dw_connection &dw = dw_device(dev);
++   pthread_mutex_lock(&dw.lock);
++   const uint32_t oldest = dw.inflight_count ? dw.inflight[0] : 0;
++   pthread_mutex_unlock(&dw.lock);
++   if (!oldest) {
++      usleep(200);
++      return VK_SUCCESS;
++   }
++   VkResult result = dw_wait_fence_locked_free(dev, oldest, UINT64_MAX);
++   if (result != VK_SUCCESS)
++      return result;
++   pthread_mutex_lock(&dw.lock);
++   if (dw.inflight_count && dw.inflight[0] == oldest) {
++      --dw.inflight_count;
++      memmove(dw.inflight, dw.inflight + 1,
++              dw.inflight_count * sizeof(dw.inflight[0]));
++   }
++   pthread_mutex_unlock(&dw.lock);
++   return VK_SUCCESS;
++}
++
++/* One kernel submission of up to NativeAdrenoAbiMaxBuffers indirect buffers; while the kernel's ring has no room (kIOReturnBusy, as msm
++ * waits for ring space) it waits for this client's oldest job, or yields when none is in flight. */
++static VkResult
++darwin_submit_chunk(struct tu_queue *queue, const NativeAdrenoAbiSubmitBuffer *entries,
++                    unsigned count, uint32_t *fence, struct tu_darwin_submit_rec *rec)
++{
++   struct tu_device *dev = queue->device;
++   struct dw_connection &dw = dw_device(dev);
++   NativeAdrenoAbiSubmit req = {};
++   req.buffer_count = count;
++   req.queue = 0;
++   for (unsigned i = 0; i < count; i++)
++      req.buffers[i] = entries[i];
++
++   for (;;) {
++      NativeAdrenoAbiSubmitReply reply = {};
++      const uint64_t began = tu_trace_clock_ns();
++      kern_return_t kr = dw_call(dw, NativeAdrenoMethodSubmit, &req, sizeof(req), &reply, sizeof(reply));
++      rec->call_us += (uint32_t)MIN2((tu_trace_clock_ns() - began) / 1000, 0xffffffffull - rec->call_us);
++      if (kr == KERN_SUCCESS) {
++         *fence = (uint32_t)reply.fence;
++         return VK_SUCCESS;
++      }
++      if (kr != kIOReturnBusy)
++         return vk_device_set_lost(&dev->vk, "submit failed: 0x%x", kr);
++      rec->busy++;
++
++      const uint64_t waited = tu_trace_clock_ns();
++      if (darwin_wait_submit_room(dev) != VK_SUCCESS)
++         return vk_device_set_lost(&dev->vk, "submit: waiting for ring space failed");
++      rec->space_wait_us += (uint32_t)((tu_trace_clock_ns() - waited) / 1000);
++   }
++}
++
++static VkResult
++darwin_submit_whole(struct tu_queue *queue, const NativeAdrenoAbiSubmitBuffer *entries,
++                    unsigned count, uint32_t *fence, struct tu_darwin_submit_rec *rec)
++{
++   struct tu_device *dev = queue->device;
++   struct dw_connection &dw = dw_device(dev);
++   *fence = 0;
++   if (!entries || !count || count > NativeAdrenoAbiMaxBatchBuffers)
++      return vk_device_set_lost(&dev->vk, "complete submit exceeds atomic IB limit: %u", count);
++   if (count <= NativeAdrenoAbiMaxBuffers)
++      return darwin_submit_chunk(queue, entries, count, fence, rec);
++   if (!(dw.params.flags & NativeAdrenoParamsSubmitBatch))
++      return vk_device_set_lost(&dev->vk, "kernel cannot preserve complete %u-IB submit", count);
++
++   /* IB allocation boundaries are not render/BR-BV synchronization boundaries.
++    * Stage transport-sized pieces; only COMMIT may publish the whole GPU job.
++    * The device's submit_mutex serializes this sequence with all Vulkan queues.
++    * Do not retry a failed/ambiguous upload or fall back to framed chunks. */
++   NativeAdrenoAbiSubmitBatch req = {};
++   NativeAdrenoAbiSubmitBatchReply reply = {};
++   req.total_buffers = count;
++   req.action = NativeAdrenoBatchBegin;
++   auto call = [&]() {
++      reply = {};
++      const uint64_t began = tu_trace_clock_ns();
++      kern_return_t kr = dw_call(dw, NativeAdrenoMethodSubmitBatch, &req, sizeof(req), &reply, sizeof(reply));
++      rec->call_us += (uint32_t)MIN2((tu_trace_clock_ns() - began) / 1000, 0xffffffffull - rec->call_us);
++      if (kr == KERN_SUCCESS && (!reply.batch || (req.batch && reply.batch != req.batch) ||
++          (req.action == NativeAdrenoBatchCommit ? (!reply.fence || reply.fence > UINT32_MAX) : reply.fence != 0)))
++         return (kern_return_t)kIOReturnError;
++      return kr;
++   };
++   kern_return_t kr = call();
++   if (kr != KERN_SUCCESS)
++      return vk_device_set_lost(&dev->vk, "atomic submit begin failed: 0x%x", kr);
++   req.batch = reply.batch;
++   req.action = NativeAdrenoBatchAppend;
++   for (unsigned at = 0; at < count;) {
++      req.offset = at;
++      req.buffer_count = MIN2(count - at, (unsigned)NativeAdrenoAbiMaxBuffers);
++      memcpy(req.buffers, entries + at, req.buffer_count * sizeof(req.buffers[0]));
++      kr = call();
++      if (kr != KERN_SUCCESS)
++         return vk_device_set_lost(&dev->vk, "atomic submit append at %u failed: 0x%x", at, kr);
++      at += req.buffer_count;
++   }
++   req.offset = count;
++   req.buffer_count = 0;
++   req.action = NativeAdrenoBatchCommit;
++   for (;;) {
++      kr = call();
++      if (kr == KERN_SUCCESS) {
++         *fence = (uint32_t)reply.fence;
++         return VK_SUCCESS;
++      }
++      if (kr != kIOReturnBusy)
++         return vk_device_set_lost(&dev->vk, "atomic submit commit failed: 0x%x", kr);
++      rec->busy++;
++      const uint64_t waited = tu_trace_clock_ns();
++      if (darwin_wait_submit_room(dev) != VK_SUCCESS)
++         return vk_device_set_lost(&dev->vk, "atomic submit: waiting for ring space failed");
++      rec->space_wait_us += (uint32_t)((tu_trace_clock_ns() - waited) / 1000);
++   }
++}
++
++static VkResult
++darwin_queue_submit(struct tu_queue *queue, void *_submit,
++                    struct vk_sync_wait *waits, uint32_t wait_count,
++                    struct vk_sync_signal *signals, uint32_t signal_count,
++                    struct tu_u_trace_submission_data *u_trace_submission_data)
++{
++   struct tu_darwin_queue_submit *submit = (struct tu_darwin_queue_submit *)_submit;
++   struct tu_device *dev = queue->device;
++   struct dw_connection &dw = dw_device(dev);
++
++   /* Syncs belong to this client, whose Vulkan queues all use kernel queue 0.
++    * That queue stays on one ring until its outstanding prefix completes, including
++    * when its priority changes. A resolved fence therefore precedes this submission.
++    * Wait-before-signal still waits until the producer has submitted. */
++   struct tu_darwin_submit_rec rec = {};
++   rec.ns = tu_trace_clock_ns();
++   for (uint32_t i = 0; i < wait_count; i++) {
++      struct vk_darwin_sync *s = container_of(waits[i].sync, struct vk_darwin_sync, vk);
++      /* tu_queue_submit() holds submit_mutex here (tu_queue.cc), which the wait releases while it sleeps. */
++      tu_frame_event(43,(uintptr_t)submit,0,(uintptr_t)s,s->state,s->fence,waits[i].wait_value);
++      while (s->state == DARWIN_SYNC_UNSIGNALED)
++         pthread_cond_wait(&dev->timeline_cond, &dev->submit_mutex);
++   }
++   rec.sync_wait_us = (uint32_t)((tu_trace_clock_ns() - rec.ns) / 1000);
++
++   uint32_t fence = 0;
++   const unsigned total = util_dynarray_num_elements(&submit->commands, NativeAdrenoAbiSubmitBuffer);
++   if (total) {
++      const NativeAdrenoAbiSubmitBuffer *all =
++         util_dynarray_element(&submit->commands, NativeAdrenoAbiSubmitBuffer, 0);
++      VkResult result = darwin_submit_whole(queue, all, total, &fence, &rec);
++      if (result != VK_SUCCESS)
++         return result;
++      rec.chunks = 1; /* GPU jobs, not transport messages */
++      pthread_mutex_lock(&dw.lock);
++      darwin_note_fence(dw, fence);
++      pthread_mutex_unlock(&dw.lock);
++      tu_frame_event(38,(uintptr_t)submit,fence,0,total,rec.busy,rec.space_wait_us,wait_count,signal_count);
