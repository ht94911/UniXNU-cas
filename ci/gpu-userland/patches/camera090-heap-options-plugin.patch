 pub struct NmbHeap(Heap);
 
+/// The original iPhone24A446 heap driver accepts bits21/22 as allocation
+/// granularity hints and reports resourceOptions without them. Our owned
+/// Vulkan heap uses the allocator's measured alignment; retain the ordinary
+/// storage, cache, hazard and private read-only fields.
+fn heap_options(value: u64) -> Result<ResourceOptions, String> {
+    const GRANULARITY_HINTS: u64 = (1 << 21) | (1 << 22);
+    options(value & !GRANULARITY_HINTS)
+}
+
+#[cfg(test)]
+#[path = "heap_options_host.rs"]
+mod heap_options_tests;
+
