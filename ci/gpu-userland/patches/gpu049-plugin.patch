diff --git a/bridge/icon_library_trace_host.mm b/bridge/icon_library_trace_host.mm
new file mode 100644
index 0000000..77baade
--- /dev/null
+++ b/bridge/icon_library_trace_host.mm
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: MIT
+// Exercise the production diagnostic decisions without opening a GPU or using
+// private libraries. The external-kernel fixture is authored by this project.
+#define main external_lookup_fixture_main
+#import "extern_function_host.mm"
+#undef main
+
+static std::vector<std::string> records;
+static bool captureIconText(uint32_t method,const void *bytes,uint32_t length) {
+    assert(method==NativeGpuTraceMethod && length==sizeof(NativeGpuTraceRecord));
+    const auto &record=*static_cast<const NativeGpuTraceRecord *>(bytes);
+    assert(record.event==GpuTraceProblem && record.value[0]==0);
+    const char *text=reinterpret_cast<const char *>(&record.value[1]);
+    const size_t bound=sizeof(record.value)-sizeof(record.value[0]);
+    assert(memchr(text,0,bound));
+    records.emplace_back(text);
+    return true;
+}
+
+static bool hasRecord(const char *text) {
+    for(const std::string &record:records)
+        if(record.find(text)!=std::string::npos)return true;
+    return false;
+}
+
+int main(int argc,char **) {
+    if(argc!=2)return 2;
+    @autoreleasepool {
+        gFrameTransport=captureIconText;
+        const bool enabled=getenv("SHENG_GPU_TRACE")!=nullptr;
+        unsigned checks=0;
+        const char *prior=getprogname();
+        setprogname("unselected-client");
+        iconLibraryNote("not selected");
+        assert(records.empty() && gIconLibraryNotes.load()==0);++checks;
+        setprogname("iconservicesagent");
+        gFrameTransport=nullptr;
+        iconLibraryNote("no transport");
+        assert(records.empty() && gIconLibraryNotes.load()==0);++checks;
+        gFrameTransport=captureIconText;
+        NSMutableData *storage=kernelLibraryFixture();
+        NBLibrary *library=[NBLibrary new];
+        library.storage=storage;
+        library.bytes=static_cast<const uint8_t *>(storage.bytes);
+        library.length=storage.length;
+        assert([[library externFunctionNames] isEqualToArray:@[@"kernel_fixture"]]);++checks;
+        NBFunction *function=(NBFunction *)[library newExternFunctionWithName:@"kernel_fixture"];
+        assert(function && function.library==library && function.functionType==4);++checks;
+        assert(ciKernelFunction(library,@"missing_fixture")==nil);++checks;
+        assert(functionBitcode(function).length==8);++checks;
+        NBDeviceMethods *device=[NBDeviceMethods new];
+        NSError *error=nil;
+        assert([(id<MTLDevice>)device newLibraryWithFile:@"/__missing_ci_fixture__/missing.metallib" error:&error]==nil);
+        assert(error!=nil);++checks;
+        error=nil;
+        MTLStitchedLibraryDescriptor *empty=[MTLStitchedLibraryDescriptor new];
+        assert([(id<MTLDevice>)device newLibraryWithStitchedDescriptor:empty error:&error]==nil);
+        assert(error!=nil);++checks;
+        if(enabled) {
+            assert(hasRecord("kind=extern n=1 valid=1"));++checks;
+            assert(hasRecord("hit=1 name=kernel_fixture"));++checks;
+            assert(hasRecord("hit=0 name=missing_fixture"));++checks;
+            assert(hasRecord("read=0 file=missing.metallib"));++checks;
+            assert(hasRecord("ci-stitch graphs=0 functions=0"));++checks;
+            for(unsigned i=0;i<120;++i)iconLibraryNote("bounded %u",i);
+            assert(records.size()==96);++checks;
+        } else {
+            assert(records.empty() && gIconLibraryNotes.load()==0);++checks;
+        }
+        setprogname(prior);
+        printf("PASS icon library trace: enabled=%d checks=%u records=%lu\n",
+               enabled,checks,(unsigned long)records.size());
+    }
+    return 0;
+}
