++//! Submission handlers start while the pass continues, and keep their submission order.
++//! Completions that precede those handlers keep their queue position behind a gate without
++//! taking a handler thread. A caller's pass runs its own handler before submitting later work.
++//! Test-only boundaries force the interleavings on a real Vulkan device.
++
++use crate::command_buffer::completion::trace;
++use crate::{
++    Buffer, CommandBuffer, CommandBufferStatus, CommandQueue, Device, DeviceKind, DeviceOptions,
++    ResourceOptions,
++};
++use metal2vulkan::device::CompletionPolicy;
++use std::sync::{mpsc, Arc, Mutex};
++use std::time::{Duration, Instant};
++
++const FILL: u64 = 64 << 10;
++const WAIT: Duration = Duration::from_secs(10);
++const PAUSE: Duration = Duration::from_millis(200);
++
++fn device(completion: CompletionPolicy) -> Device {
++    let mut options = DeviceOptions {
++        kinds: if cfg!(m2v_cpu_icd) {
++            vec![DeviceKind::Cpu]
++        } else {
++            vec![
++                DeviceKind::Discrete,
++                DeviceKind::Integrated,
++                DeviceKind::Virtual,
++            ]
++        },
++        ..DeviceOptions::default()
++    };
++    options.policy.completion = completion;
++    Device::system_default_with(&options).unwrap()
++}
++
++fn fill(queue: &CommandQueue, target: &Buffer, value: u8) -> CommandBuffer {
++    let buffer = queue.command_buffer().unwrap();
++    let mut blit = buffer.blit_command_encoder().unwrap();
++    blit.fill_buffer(target, 0..FILL, value).unwrap();
++    blit.end_encoding().unwrap();
++    buffer
++}
++
++fn completes(buffer: &CommandBuffer) {
++    buffer.wait_until_completed_for(WAIT).unwrap();
++    assert_eq!(buffer.status(), CommandBufferStatus::Completed);
++}
++
++fn warm(queue: &CommandQueue, target: &Buffer) {
++    let buffer = fill(queue, target, 0);
++    buffer.commit().unwrap();
++    completes(&buffer);
++}
++
++fn timely_handoff(completion: CompletionPolicy) {
++    let device = device(completion);
++    let first = device.new_command_queue().unwrap();
++    let second = device.new_command_queue().unwrap();
++    let targets = [(); 2].map(|()| device.new_buffer(FILL, ResourceOptions::private()).unwrap());
++    warm(&first, &targets[0]);
++    warm(&second, &targets[1]);
++    let held = fill(&first, &targets[0], 1);
++    trace::hold_at(trace::Point::FirstWork);
++    held.commit().unwrap();
++    let reached = trace::reached(trace::Point::FirstWork, WAIT);
++    let started = Arc::new(Mutex::new(None));
++    let earlier = fill(&first, &targets[0], 2);
++    let noted = Arc::clone(&started);
++    earlier
++        .add_submission_handler(Box::new(move |_: &CommandBuffer| {
++            *noted.lock().unwrap() = Some(crate::gpu_time::host_nanos());
++        }))
++        .unwrap();
++    let later = fill(&second, &targets[1], 3);
++    if reached {
++        earlier.commit().unwrap();
++        later.commit().unwrap();
++        trace::start();
++        trace::pause_after_submit(Some(PAUSE));
++    }
++    trace::release(trace::Point::FirstWork);
++    assert!(reached, "the scheduler never reached the held submission");
++    for buffer in [&held, &earlier, &later] {
++        completes(buffer);
++    }
++    trace::pause_after_submit(None);
++    let records = trace::stop();
++    let later_id = trace::buffer_id(&later);
++    let (at, ended) = records
++        .iter()
++        .find_map(|record| match record {
++            trace::Traced::BatchReturn {
++                buffer,
++                at,
++                pause_ended,
++            } if *buffer == later_id => Some((*at, *pause_ended)),
++            _ => None,
++        })
++        .expect("the later batch was submitted or held, with the test pause");
++    let started = started
++        .lock()
++        .unwrap()
++        .expect("the earlier submission handler ran");
++    println!(
++        "{completion:?}: handler began {} us before the later batch's pause ended; pause {} us",
++        (ended as i128 - started as i128) / 1000,
++        (ended - at) / 1000
++    );
++    assert!(
++        started < ended,
++        "the pass postponed its earlier handler until after the later batch"
++    );
++}
++
++#[test]
++fn handlers_start_while_the_pass_continues_exact() {
++    timely_handoff(CompletionPolicy::Exact);
++}
++
++#[test]
++fn handlers_start_while_the_pass_continues_grouped() {
++    timely_handoff(CompletionPolicy::Grouped);
++}
