+Function-constant objects expose both `required` and `isRequired`. Both read
+the same runtime-supplied flag. Original24A446 Core Image calls `required`;
+providing only `isRequired` caused the camera service to terminate during
+program setup. The selector consumer test checks true/false changes through
+the public Metal type and native Objective-C message without creating a GPU.
+
 In a diagnostic boot, the existing icon-service trace also records the first
 96 library loads, function-name queries and external-kernel lookups. File-read
 failure is recorded before it returns nil, and stitching requests report their
@@ -251,3 +257,8 @@ the query wall microseconds in cpu0, and validity bit0 in tid2. These query
 brackets are part of the observation cost; CPU deltas are not GPU duration.
 Type31 reports the actual profile-hook policy. Rendering calls and synchronization
 are unchanged; performance and display scheduling still require device evidence.
+
+Freed runtime-owned buffer backing uses the existing spare cache, with its
+64 MiB buffer budget, ten-second expiry and pressure release. Foreground
+allocations can reuse the original mapping and address object before another
+native allocation. Imported resources retain their owner and release ordering.
diff --git a/bridge/function_constant_selector_host.mm b/bridge/function_constant_selector_host.mm
new file mode 100644
index 0000000..ce363e5
--- /dev/null
+++ b/bridge/function_constant_selector_host.mm
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: MIT
+// Exercise the actual Objective-C constant object returned by the frontend.
+#import "../NativeBridgeMetalFrontend.mm"
+#include <cassert>
+
+int main() {
+    @autoreleasepool {
+        NBFunctionConstant *constant=[NBFunctionConstant new];
+        SEL selector=sel_registerName("required");
+        if (![constant respondsToSelector:selector]) {
+            puts("FAIL missing production MTLFunctionConstant required selector");
+            return 1;
+        }
+        unsigned cases=0;
+        for (BOOL required : {NO,YES,NO}) {
+            constant.required=required;
+            assert([(MTLFunctionConstant *)constant required]==required);++cases;
+            assert(constant.isRequired==required);++cases;
+            assert(((BOOL (*)(id,SEL))objc_msgSend)(constant,selector)==required);++cases;
+        }
+        constant.name=@"real_constant";constant.index=7;constant.type=MTLDataTypeInt;
+        assert([constant.name isEqual:@"real_constant"] && constant.index==7 && constant.type==MTLDataTypeInt);++cases;
+        printf("PASS function constant selector: %u production getter and native message cases\n",cases);
+    }
+    return 0;
+}
