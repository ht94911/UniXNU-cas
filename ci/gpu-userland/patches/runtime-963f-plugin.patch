+struct Registers {uint64_t pc=0,lr=0,fp=0,sp=0;};
+struct Frame {uint64_t fp=0,lr=0;};
+struct Sample {
+ uint32_t version=0,bytes=0;
+ uint64_t id=0,beganUs=0,infoEndedUs=0,stateEndedUs=0,endedUs=0;
+ uint64_t tid=0,lastCommand=0,lastCopyUs=0,stackLow=0,stackHigh=0,cpuUs=0;
+ Registers first{},last{};
