+  s.cpuUs=((uint64_t)info.user_time.seconds+(uint64_t)info.system_time.seconds)*1000000ull+
+          (uint64_t)info.user_time.microseconds+(uint64_t)info.system_time.microseconds;
+ }
+ s.stateKr=registers(thread,s.first,s.architecture,s.integers);s.stateEndedUs=now();
+ if(s.stateKr!=KERN_SUCCESS){s.stop=NoRegisters;s.endedUs=now();return;}
+ s.flags|=RegistersValid;
+ if(s.architecture==1)s.flags|=IntegerRegistersValid;
+ if(s.stackHigh>s.stackLow && s.first.sp>=s.stackLow && s.first.sp<s.stackHigh)s.flags|=StackBoundsValid;
+ uint64_t fp=s.first.fp;
+ s.stop=FrameLimit;
+ for(unsigned n=0;n<kFrames;++n) {
+  if(!fp){s.stop=EndOfChain;break;}
+  const uint64_t alignment=s.architecture==1?16:8;
+  if(fp&(alignment-1)){s.stop=UnalignedFrame;break;}
+  if(!(s.flags&StackBoundsValid) || s.stackHigh-s.stackLow<16 ||
+     fp<s.first.sp || fp<s.stackLow || fp>s.stackHigh-16){s.stop=OutsideStack;break;}
+  uint64_t pair[2]{};mach_vm_size_t copied=0;
+  s.readKr=mach_vm_read_overwrite(mach_task_self(),fp,sizeof(pair),(mach_vm_address_t)pair,&copied);
+  if(s.readKr!=KERN_SUCCESS || copied!=sizeof(pair)){s.stop=ReadFailed;break;}
+  s.frames[s.depth++]={fp,codeAddress(pair[1])};s.flags|=FramesRead;
+  if(!pair[0]){s.stop=EndOfChain;break;}
+  if(pair[0]<=fp){s.stop=NonIncreasingFrame;break;}
+  fp=pair[0];
+ }
+ uint32_t afterArchitecture=0;
+ s.recheckKr=registers(thread,s.last,afterArchitecture);
+ if(s.recheckKr==KERN_SUCCESS && afterArchitecture==s.architecture &&
+    s.first.pc==s.last.pc && s.first.lr==s.last.lr && s.first.fp==s.last.fp && s.first.sp==s.last.sp)
+  s.flags|=RegistersMatched;
+ s.endedUs=now();
+}
+// A late sampler takes the latest due threshold once, rather than issuing a
+// burst of stale 25/60/110ms observations at the same instant.
+inline int dueThreshold(uint64_t now,uint64_t copied,unsigned next) {
+ if(!copied || now<copied || next>=4)return -1;
+ int due=-1;for(unsigned i=next;i<4 && now-copied>=kThresholdsUs[i];++i)due=(int)i;
+ return due;
+}
