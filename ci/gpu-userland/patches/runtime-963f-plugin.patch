--- /dev/null
+++ b/bridge/icon_library_index_host.mm
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: MIT
+// Exercise the actual lookup and installation with Objective-C objects.
+#if defined(__APPLE__)
+#import <Foundation/Foundation.h>
+#include <objc/runtime.h>
+#else
+#include <objc/runtime.h>
+#include <objc/message.h>
+#include <pthread.h>
+static pthread_t fixtureMainThread = pthread_self();
+static int pthread_main_np() { return pthread_equal(pthread_self(), fixtureMainThread); }
+__attribute__((objc_root_class))
+@interface NSObject { Class isa; }
++ (id)new;
+- (BOOL)isKindOfClass:(Class)other;
+- (BOOL)isEqual:(id)other;
+@end
+@implementation NSObject
++ (id)new { return class_createInstance(self, 0); }
+- (BOOL)isKindOfClass:(Class)other {
+    for (Class c = object_getClass(self); c; c = class_getSuperclass(c)) if (c == other) return 1;
+    return 0;
+}
+- (BOOL)isEqual:(id)other { return self == other; }
+@end
+#endif
+
+#include <cassert>
+#include <cstdio>
+#include <thread>
+#include <unordered_map>
+static unsigned originalCalls, indexedCalls, lookupCalls, originalVisibleCalls, visibleCalls;
+static bool missingIndex, wrongItem, changeQuery, changeSource, hiddenController, hiddenIndex, changeDuringVisibility;
+
+@interface NBFixtureIdentifier : NSObject { @public unsigned value; }
+@end
+@implementation NBFixtureIdentifier
+- (BOOL)isEqual:(id)other {
+    return [other isKindOfClass:objc_getClass("NBFixtureIdentifier")] &&
+           value == ((NBFixtureIdentifier *)other)->value;
+}
+@end
+
+@interface SBHIconLibraryQueryResult : NSObject { @public id identifier; }
+- (id)itemIdentifierForIcon:(id)icon;
+@end
+@implementation SBHIconLibraryQueryResult
+- (id)itemIdentifierForIcon:(id)icon { return icon ? identifier : nil; }
+@end
+
+@interface SBIconView : NSObject { @public id representedIcon; }
+- (id)icon;
+@end
+@implementation SBIconView
+- (id)icon { return representedIcon; }
+@end
+
+@interface SBHIconTableViewDiffableDataSource : NSObject {
+@public id query, alternateQuery, indexPath, returnedIdentifier;
+    unsigned queryReads;
+}
+- (id)queryResult;
+- (id)indexPathForItemIdentifier:(id)identifier;
+- (id)itemIdentifierForIndexPath:(id)indexPath;
+@end
+@implementation SBHIconTableViewDiffableDataSource
+- (id)queryResult { return changeQuery && ++queryReads > 1 ? alternateQuery : query; }
+- (id)indexPathForItemIdentifier:(id)identifier {
+    (void)identifier; ++lookupCalls; return missingIndex ? nil : indexPath;
+}
+- (id)itemIdentifierForIndexPath:(id)path { (void)path; return wrongItem ? nil : returnedIdentifier; }
+@end
+
+@interface SBHIconLibraryTableViewController : NSObject {
+@public id source, alternateSource, indexedView, originalView;
+    unsigned sourceReads;
+}
+- (id)dataSource;
+- (id)_iconViewForIcon:(id)icon;
+- (id)_iconViewAtIndexPath:(id)indexPath;
+- (BOOL)isDisplayingIconView:(id)view;
+- (BOOL)_isViewControllerVisible;
+- (BOOL)_isIndexPathVisible:(id)indexPath;
+@end
+@implementation SBHIconLibraryTableViewController
+- (id)dataSource { return changeSource && ++sourceReads > 1 ? alternateSource : source; }
+- (id)_iconViewForIcon:(id)icon { (void)icon; ++originalCalls; return originalView; }
+- (id)_iconViewAtIndexPath:(id)path { (void)path; ++indexedCalls; return indexedView; }
+- (BOOL)isDisplayingIconView:(id)view { (void)view; ++originalVisibleCalls; return NO; }
+- (BOOL)_isViewControllerVisible { return !hiddenController; }
+- (BOOL)_isIndexPathVisible:(id)path {
+    (void)path; ++visibleCalls;
+    if (changeDuringVisibility) source = alternateSource;
+    return !hiddenIndex;
+}
+@end
+
+#include "../NativeIconLibraryIndex.h"
+static std::unordered_map<Method, unsigned> origins;
+static bool originMatches(Method method, const uint8_t *uuid) {
+    const auto found = origins.find(method);
+    return found != origins.end() && found->second == uuid[0];
+}
+
+int main() {
+#if defined(__APPLE__)
+    @autoreleasepool {
+#endif
+    unsigned cases = 0;
+    Class controllerClass = objc_getClass("SBHIconLibraryTableViewController");
+    Class dataSourceClass = objc_getClass("SBHIconTableViewDiffableDataSource");
+    Class queryClass = objc_getClass("SBHIconLibraryQueryResult");
+    Class viewClass = objc_getClass("SBIconView");
+    const struct { Class owner; const char *name; unsigned origin; } required[] = {
+        {controllerClass,"_iconViewForIcon:",0x2c}, {controllerClass,"dataSource",0x2c},
+        {controllerClass,"_iconViewAtIndexPath:",0x2c}, {dataSourceClass,"queryResult",0x2c},
+        {controllerClass,"isDisplayingIconView:",0x2c}, {controllerClass,"_isViewControllerVisible",0x2c},
+        {controllerClass,"_isIndexPathVisible:",0x2c},
+        {queryClass,"itemIdentifierForIcon:",0x2c}, {dataSourceClass,"indexPathForItemIdentifier:",0xaa},
+        {dataSourceClass,"itemIdentifierForIndexPath:",0xaa}, {viewClass,"icon",0x2c}
+    };
+    for (const auto &r : required) origins[class_getInstanceMethod(r.owner,sel_registerName(r.name))] = r.origin;
+    Method target = class_getInstanceMethod(controllerClass,sel_registerName("_iconViewForIcon:"));
+    IMP original = method_getImplementation(target);
+    origins[target] = 0;
+    assert(!nbiconlibrary::install(originMatches) && method_getImplementation(target) == original); ++cases;
+    origins[target] = 0x2c;
+    assert(nbiconlibrary::install(originMatches) && method_getImplementation(target) != original); ++cases;
+    IMP installed = method_getImplementation(target);
+    assert(nbiconlibrary::install(originMatches) && method_getImplementation(target) == installed); ++cases;
+
+    id icon = [NSObject new], path = [NSObject new];
+    auto *identifier = (NBFixtureIdentifier *)[NBFixtureIdentifier new]; identifier->value = 7;
+    auto *equalIdentifier = (NBFixtureIdentifier *)[NBFixtureIdentifier new]; equalIdentifier->value = 7;
+    auto *query = (SBHIconLibraryQueryResult *)[SBHIconLibraryQueryResult new]; query->identifier = identifier;
+    auto *view = (SBIconView *)[SBIconView new]; view->representedIcon = icon;
+    auto *source = (SBHIconTableViewDiffableDataSource *)[SBHIconTableViewDiffableDataSource new];
+    source->query = query; source->alternateQuery = [SBHIconLibraryQueryResult new];
+    source->indexPath = path; source->returnedIdentifier = identifier;
+    auto *controller = (SBHIconLibraryTableViewController *)[SBHIconLibraryTableViewController new];
+    controller->source = source; controller->alternateSource = [SBHIconTableViewDiffableDataSource new];
+    controller->indexedView = view; controller->originalView = [NSObject new];
+    auto reset = [&] {
+        originalCalls = indexedCalls = lookupCalls = 0;
+        originalVisibleCalls = visibleCalls = 0;
+        missingIndex = wrongItem = changeQuery = changeSource = false;
+        hiddenController = hiddenIndex = changeDuringVisibility = false;
+        source->queryReads = controller->sourceReads = 0; source->returnedIdentifier = identifier;
+        query->identifier = identifier; view->representedIcon = icon;
+        controller->source = source; controller->indexedView = view;
+    };
+    reset(); assert([controller _iconViewForIcon:icon] == view && !originalCalls && indexedCalls == 1); ++cases;
+    reset(); source->returnedIdentifier = equalIdentifier;
+    assert([controller _iconViewForIcon:icon] == view && !originalCalls); ++cases;
+    reset(); for (unsigned i = 0; i < 1000; ++i) assert([controller _iconViewForIcon:icon] == view);
+    assert(!originalCalls && lookupCalls == 1000); ++cases;
+    reset(); missingIndex = true;
+    assert([controller _iconViewForIcon:icon] == controller->originalView && originalCalls == 1 && !indexedCalls); ++cases;
+    reset(); wrongItem = true;
+    assert([controller _iconViewForIcon:icon] == controller->originalView && originalCalls == 1); ++cases;
+    reset(); changeQuery = true;
+    assert([controller _iconViewForIcon:icon] == controller->originalView && originalCalls == 1); ++cases;
+    reset(); changeSource = true;
+    assert([controller _iconViewForIcon:icon] == controller->originalView && originalCalls == 1); ++cases;
+    reset(); view->representedIcon = [NSObject new];
+    assert([controller _iconViewForIcon:icon] == controller->originalView && originalCalls == 1); ++cases;
+    reset(); controller->indexedView = nil;
+    assert([controller _iconViewForIcon:icon] == controller->originalView && originalCalls == 1); ++cases;
+    reset(); query->identifier = nil;
+    assert([controller _iconViewForIcon:icon] == controller->originalView && originalCalls == 1 && !lookupCalls); ++cases;
+    reset(); controller->source = nil;
+    assert([controller _iconViewForIcon:icon] == controller->originalView && originalCalls == 1); ++cases;
+    reset(); assert([controller _iconViewForIcon:nil] == controller->originalView && originalCalls == 1); ++cases;
+    reset(); std::thread worker([&] { assert([controller _iconViewForIcon:icon] == controller->originalView); });
+    worker.join(); assert(originalCalls == 1 && !lookupCalls); ++cases;
+    reset(); assert([controller isDisplayingIconView:view] && visibleCalls == 1 && !originalVisibleCalls); ++cases;
+    reset(); hiddenIndex = true;
+    assert(![controller isDisplayingIconView:view] && visibleCalls == 1 && !originalVisibleCalls); ++cases;
+    reset(); hiddenController = true;
+    assert(![controller isDisplayingIconView:view] && !visibleCalls && !lookupCalls && !originalVisibleCalls); ++cases;
+    reset(); missingIndex = true;
+    assert(![controller isDisplayingIconView:view] && originalVisibleCalls == 1 && !visibleCalls); ++cases;
+    reset(); wrongItem = true;
+    assert(![controller isDisplayingIconView:view] && originalVisibleCalls == 1 && !visibleCalls); ++cases;
+    reset(); changeQuery = true;
+    assert(![controller isDisplayingIconView:view] && originalVisibleCalls == 1); ++cases;
+    reset(); changeSource = true;
+    assert(![controller isDisplayingIconView:view] && originalVisibleCalls == 1); ++cases;
+    reset(); changeDuringVisibility = true;
+    assert(![controller isDisplayingIconView:view] && originalVisibleCalls == 1 && visibleCalls == 1); ++cases;
+    reset(); assert(![controller isDisplayingIconView:nil] && originalVisibleCalls == 1 && !lookupCalls); ++cases;
+    reset(); std::thread visibilityWorker([&] { assert(![controller isDisplayingIconView:view]); });
+    visibilityWorker.join(); assert(originalVisibleCalls == 1 && !lookupCalls); ++cases;
+    reset(); for (unsigned i = 0; i < 1000; ++i) assert([controller isDisplayingIconView:view]);
+    assert(visibleCalls == 1000 && lookupCalls == 1000 && !originalVisibleCalls); ++cases;
+    printf("PASS %u actual App Library index cases; original fallback preserved; 1000 indexed lookups\n", cases);
+#if defined(__APPLE__)
+    }
+#endif
+}
diff --git a/bridge/icon_library_trace_host.mm b/bridge/icon_library_trace_host.mm
new file mode 100644
index 0000000..77baade
--- /dev/null
+++ b/bridge/icon_library_trace_host.mm
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: MIT
+// Exercise the production diagnostic decisions without opening a GPU or using
+// private libraries. The external-kernel fixture is authored by this project.
+#define main external_lookup_fixture_main
+#import "extern_function_host.mm"
+#undef main
+
+static std::vector<std::string> records;
+static bool captureIconText(uint32_t method,const void *bytes,uint32_t length) {
+    assert(method==NativeGpuTraceMethod && length==sizeof(NativeGpuTraceRecord));
+    const auto &record=*static_cast<const NativeGpuTraceRecord *>(bytes);
+    assert(record.event==GpuTraceProblem && record.value[0]==0);
+    const char *text=reinterpret_cast<const char *>(&record.value[1]);
+    const size_t bound=sizeof(record.value)-sizeof(record.value[0]);
+    assert(memchr(text,0,bound));
+    records.emplace_back(text);
+    return true;
+}
+
+static bool hasRecord(const char *text) {
+    for(const std::string &record:records)
+        if(record.find(text)!=std::string::npos)return true;
+    return false;
+}
+
+int main(int argc,char **) {
+    if(argc!=2)return 2;
+    @autoreleasepool {
+        gFrameTransport=captureIconText;
+        const bool enabled=getenv("SHENG_GPU_TRACE")!=nullptr;
+        unsigned checks=0;
+        const char *prior=getprogname();
+        setprogname("unselected-client");
+        iconLibraryNote("not selected");
+        assert(records.empty() && gIconLibraryNotes.load()==0);++checks;
+        setprogname("iconservicesagent");
+        gFrameTransport=nullptr;
+        iconLibraryNote("no transport");
+        assert(records.empty() && gIconLibraryNotes.load()==0);++checks;
+        gFrameTransport=captureIconText;
+        NSMutableData *storage=kernelLibraryFixture();
+        NBLibrary *library=[NBLibrary new];
+        library.storage=storage;
+        library.bytes=static_cast<const uint8_t *>(storage.bytes);
+        library.length=storage.length;
+        assert([[library externFunctionNames] isEqualToArray:@[@"kernel_fixture"]]);++checks;
+        NBFunction *function=(NBFunction *)[library newExternFunctionWithName:@"kernel_fixture"];
+        assert(function && function.library==library && function.functionType==4);++checks;
+        assert(ciKernelFunction(library,@"missing_fixture")==nil);++checks;
+        assert(functionBitcode(function).length==8);++checks;
+        NBDeviceMethods *device=[NBDeviceMethods new];
+        NSError *error=nil;
+        assert([(id<MTLDevice>)device newLibraryWithFile:@"/__missing_ci_fixture__/missing.metallib" error:&error]==nil);
+        assert(error!=nil);++checks;
+        error=nil;
+        MTLStitchedLibraryDescriptor *empty=[MTLStitchedLibraryDescriptor new];
+        assert([(id<MTLDevice>)device newLibraryWithStitchedDescriptor:empty error:&error]==nil);
+        assert(error!=nil);++checks;
+        if(enabled) {
+            assert(hasRecord("kind=extern n=1 valid=1"));++checks;
+            assert(hasRecord("hit=1 name=kernel_fixture"));++checks;
+            assert(hasRecord("hit=0 name=missing_fixture"));++checks;
+            assert(hasRecord("read=0 file=missing.metallib"));++checks;
+            assert(hasRecord("ci-stitch graphs=0 functions=0"));++checks;
+            for(unsigned i=0;i<120;++i)iconLibraryNote("bounded %u",i);
+            assert(records.size()==96);++checks;
+        } else {
+            assert(records.empty() && gIconLibraryNotes.load()==0);++checks;
+        }
+        setprogname(prior);
+        printf("PASS icon library trace: enabled=%d checks=%u records=%lu\n",
+               enabled,checks,(unsigned long)records.size());
+    }
+    return 0;
+}
