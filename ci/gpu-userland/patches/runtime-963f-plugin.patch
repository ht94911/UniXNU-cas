++fn typed_image_module(view: ShadowTexelView) -> BResult<TypedModule> {
++    let mut b = ModuleBuilder::new();
++    let u32_ = b.ty(Type::Int {
++        width: 32,
++        signed: false,
++    })?;
++    let uvec2 = b.ty(Type::Vector { elem: u32_, len: 2 })?;
++    let uvec3 = b.ty(Type::Vector { elem: u32_, len: 3 })?;
++    let image_type = b.ty(Type::Image(ImageType {
++        sampled_type: u32_,
++        dim: Dim::D2,
++        depth: false,
++        arrayed: false,
++        multisampled: false,
++        usage: ImageUsage::Sampled,
++        format: crate::spv::ImageFormat::Unknown,
++    }))?;
++    let image = b.resource(IMAGE, StorageClass::UniformConstant, image_type)?;
++    let tiled = words_buffer(&mut b, TILED, u32_)?;
++    let shape = words_buffer(&mut b, SHAPE, u32_)?;
++    let invocation = b.builtin(crate::spv::BuiltIn::GlobalInvocationId, IoDir::Input, uvec3)?;
++    let void = b.ty(Type::Void)?;
++    let mut f = b.function(void)?;
++    let zero = u32_value(&mut f, 0)?;
++    let two = u32_value(&mut f, 2)?;
++    let invocation = f.module().global_value(invocation)?;
++    let invocation = f.load(invocation, MemAccess::default())?;
++    let gx = f.composite_extract(invocation, &[0])?;
++    let gy = f.composite_extract(invocation, &[1])?;
++    let gz = f.composite_extract(invocation, &[2])?;
++    let image = f.module().global_value(image)?;
++    let tiled = f.module().global_value(tiled)?;
++    let shape = f.module().global_value(shape)?;
++    let TileWord {
++        level,
++        texel: [x, y],
++        byte,
++        word,
++        inside,
++    } = tile_word(&mut f, shape, [gx, gy, gz])?;
++    let copy: ArmFn<'_, ()> = Box::new(move |f, _| {
++        let coordinates = f.composite_construct(uvec2, &[x, y])?;
++        let image = f.load(image, MemAccess::default())?;
++        let operands = ImageOperands {
++            lod: Some(zero),
++            ..ImageOperands::default()
++        };
++        let texel = f.fetch(image, coordinates, &operands)?;
++        let words = fetched_words(f, texel, view)?;
++        let lane_mask = u32_value(f, view.words() - 1)?;
++        let lane = f.binary(BinOp::ShiftRightLogical, byte, two)?;
++        let lane = f.binary(BinOp::BitwiseAnd, lane, lane_mask)?;
++        let mut value = words[0];
++        for (index, &next) in words.iter().enumerate().skip(1) {
++            let index = u32_value(f, index as u32)?;
++            let is_lane = f.binary(BinOp::IEqual, lane, index)?;
++            value = f.select(is_lane, next, value)?;
++        }
++        let first = f.binary(BinOp::ShiftRightLogical, level.tiled_first, two)?;
++        let at = f.binary(BinOp::IAdd, first, word)?;
++        let destination = f.access_chain(tiled, &[zero, at])?;
++        f.store(destination, value, MemAccess::default())?;
++        Ok(ArmEnd::FallThrough(Vec::new()))
++    });
++    f.if_(&mut (), inside, copy, None)?;
++    f.ret(None)?;
++    let id = f.finish()?;
++    b.entry(
++        ExecModel::GLCompute,
++        id,
++        vec![ExecMode::LocalSize {
++            x: TiledTexelsModule::LOCAL_SIZE,
++            y: 1,
++            z: 1,
++        }],
++    )?;
++    b.finalize()
++}
++
++/// Build and verify the raw image-to-tiled-buffer kernel for one integer view.
++/// The caller orders sampled reads and storage writes, retains both resources,
++/// and uses the shape/grid returned by TiledImageCopyModule::tiled_dispatch.
++pub fn tiled_image_copy_module(
++    device: &Device,
++    view: ShadowTexelView,
++) -> Result<TiledImageCopyModule, Error> {
++    let profile = device.profile();
++    let module = typed_image_module(view)?;
++    let mut meter = Meter::new(&Budget::default());
++    crate::spirv::verify::verify(&module, profile, &mut meter)?;
++    let result = crate::spirv::serialize::serialize(module)?;
++    profile.check(&result.requirements).map_err(|cause| {
++        Error::Internal(InternalError::new(
++            InternalKind::RequirementsExceedProfile,
++            format!("the tiled image copy module needs {cause:?}"),
++        ))
++    })?;
++    let words = crate::spirv::serialize::relocate(&result, &binding_of)?;
++    Ok(TiledImageCopyModule {
++        spirv: words.into(),
++        requirements: result.requirements,
++    })
++}
