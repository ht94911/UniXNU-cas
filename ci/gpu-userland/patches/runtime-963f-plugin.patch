+static void registerRenderWaitThread(uint64_t command) {
+ if(!renderWaitOn())return;
+ static thread_local RenderWaitTarget *target=nullptr;
+ static thread_local bool tried=false;
+ if(!tried) {
+  tried=true;
+  for(auto &slot:gRenderWaitTargets) {
+   unsigned empty=0;if(!slot.ready.compare_exchange_strong(empty,1))continue;
+   slot.port=mach_thread_self();pthread_threadid_np(nullptr,&slot.tid);
+   slot.high=(uintptr_t)pthread_get_stackaddr_np(pthread_self());
+   const uint64_t size=pthread_get_stacksize_np(pthread_self());
+   slot.low=size<=slot.high?slot.high-size:0;
+   TraceRec name{};name.type=4;name.tid=(uint32_t)slot.tid;
+   pthread_getname_np(pthread_self(),(char *)&name.t0,24);tracePush(name);
+   target=&slot;slot.ready.store(2,std::memory_order_release);break;
+  }
+  if(!target) {
+   static std::atomic<bool> reported{false};
+   if(!reported.exchange(true)) {
+    nbwait::Sample s{};s.version=nbwait::kVersion;s.bytes=sizeof(s);s.stop=nbwait::RegistrationFull;
+    s.beganUs=s.endedUs=nowUs();traceWaitBytes(27,0,&s,sizeof(s));
