+        let _ = self.0.file.lock().unwrap_or_else(|e| e.into_inner()).write_all(&frame);
+    }
+
+    fn take_earlier(&self) -> Vec<metal2vulkan_runtime::PipelineRecord> {
+        std::mem::take(&mut *self.0.earlier.lock().unwrap_or_else(|e| e.into_inner()))
+    }
