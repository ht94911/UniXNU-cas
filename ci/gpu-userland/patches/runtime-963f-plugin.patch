++/// A single-sample 2D image's raw texel bits stored directly in Metal's tiled bytes.
++///
++/// Set 0 binds an unsigned sampled image in GENERAL at 0, the destination storage
++/// buffer at 1, and the existing tiled shape at 2. Consecutive invocations store
++/// consecutive words; each fetch takes the chosen word through an integer view.
++/// No intermediate image-to-buffer copy is needed. Padding is never written.
++#[non_exhaustive]
++#[derive(Clone, Debug, PartialEq, Eq)]
++pub struct TiledImageCopyModule {
++    /// SPIR-V 1.5, entry main, local size 64 by 1 by 1.
++    pub spirv: Arc<[u32]>,
++    /// The module's checked device requirements.
++    pub requirements: Requirements,
++}
++
++impl TiledImageCopyModule {
++    /// Descriptor set of every binding.
++    pub const SET: u32 = 0;
++    /// The raw unsigned-integer sampled image.
++    pub const IMAGE_BINDING: u32 = 0;
++    /// The destination buffer, in aligned words.
++    pub const TILED_BINDING: u32 = 1;
++    /// The same shape buffer as TiledTexelsModule uses.
++    pub const SHAPE_BINDING: u32 = 2;
++
++    /// Shape and grid for one image layer and level with the view's texel width.
++    /// Other shapes keep using the existing buffer conversion.
++    pub fn tiled_dispatch(
++        level: &TiledLevelMove,
++        view: ShadowTexelView,
++    ) -> Option<(Vec<u8>, [u32; 3])> {
++        if level.images != 1 || level.unit != 4 * view.words() {
++            return None;
++        }
++        TiledTexelsModule::tiled_dispatch(level, false)
++    }
++}
