-+        address: None,
-+        bytes: vec![0; 32 * 4],
-+    };
-+    let out = run(
-+        &module,
-+        &Config {
-+            workgroups: [32, 1, 1],
-+            ..Config::default()
-+        },
-+        Resources {
-+            buffers: vec![buffer(0), buffer(1)],
-+            push: vec![0; 128],
-+            spec: Default::default(),
-+        },
-+    )
-+    .expect("execution");
-+    for i in 0..32usize {
