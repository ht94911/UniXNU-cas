++/// Begin a selected driver's recording call, on the existing host uptime clock.
++/// No clock read where the process has not installed the diagnostic hook.
++#[inline]
++pub(crate) fn diagnostic_recording_began() -> u64 {
++    if DIAGNOSTIC_HOOK.get().is_some() {
++        now_nanos()
++    } else {
++        0
++    }
++}
++
++/// Complete one existing Begin/EndRenderPass record. Its formerly unused detail
++/// words carry driver-call wall microseconds and the entry's uptime microseconds.
++/// This is not CPU execution time or GPU duration. MAX denotes a capped duration;
++/// a zero entry denotes an unavailable clock. The frontend retains its ordinary
++/// post-call timestamp, command identity, recording thread and bounded budget.
++#[inline]
++pub(crate) fn diagnostic_recording_ended(command: u64, kind: u32, began: u64) {
++    let ended = if began != 0 { now_nanos() } else { 0 };
++    let (elapsed, entry) = if began != 0 && ended >= began {
++        (
++            ((ended - began) / 1000).min(u32::MAX as u64) as u32,
++            began / 1000,
++        )
++    } else {
++        (0, 0)
++    };
++    diagnostic_vulkan(command, kind, elapsed, entry);
++}
