+-      tu_frame_event(44,(uintptr_t)cmd,seq,a,(uintptr_t)iv,(uintptr_t)iv->image,iv->vk.format,iv->view.color_swap,iv->view.is_mutable,iv->image->layout[0].tile_mode,att->load,att->store,att->samples);
++   /* The GMEM swap trace (tu_swap_trace_on): the first 3000 passes and the first 1000 passes of 3000 px or wider, in order, each with
++    * its attachments (event 44: index, mode, image, format, swap, mutability, tile mode, load | store << 1 | unpadded << 2, samples,
