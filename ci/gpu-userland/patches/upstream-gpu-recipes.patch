+@@ -4209,10 +4213,24 @@ tu_note_pass(struct tu_cmd_buffer *cmd, bool sysmem, unsigned slot, uint64_t kpx
+    const uint32_t seq = p_atomic_inc_return(&tu_pass_seq);
+    rec.seq = seq;
+    tu_pass_ring[seq % 512] = rec;
+-   tu_frame_event(36,(uintptr_t)cmd,seq,rec.mode,rec.width,rec.height,rec.colors,rec.samples,rec.flags,rec.format,rec.swap,rec.draws,rec.ns);
+-   for(uint32_t a=0;a<cmd->state.pass->attachment_count;++a)if(cmd->state.attachments[a]) {
