+@@ -14,6 +14,7 @@
+ #include "util/format_rgb9e5.h"
+ #include "util/format_srgb.h"
+ #include "util/half_float.h"
++#include "util/simple_mtx.h"
+ 
+ #include "common/freedreno_gpu_event.h"
+ #include "common/freedreno_lrz.h"
+@@ -211,14 +212,58 @@ format_to_ifmt(enum pipe_format format)
+  * it with the identity swap. Per site (tu_gmem_side_stats): [0] transfers, [1] of them with a swap other than WZYX on the tile
+  * side, [2] with MUTABLEEN, [3] of a linear image in memory. [1] is the counter that must stay zero for linear images.
+  */
+-static uint64_t tu_gmem_side_counts[4][4];
++static uint64_t tu_gmem_side_counts[6][4];
++
++/* The GMEM swap trace (tu_swap_trace_on): one event 37 per distinct transfer (site, image, format, linearity, MUTABLEEN, tile side
++ * swap, the view's swap and mutability, and the memory side's own registers: RB_MRT_BUF_INFO for a 3D transfer,
++ * RB_A2D_DEST_BUFFER_INFO for a 2D one, RB_RESOLVE_SYSTEM_BUFFER_INFO for a blit event), sent again at each power of two of its
++ * count, so a frame's thousands of transfers fit the kernel's ring. */
++struct tu_swap_trace_slot {uint64_t key[3];uint64_t count;};
++static struct tu_swap_trace_slot tu_swap_trace_slots[256];
++static simple_mtx_t tu_swap_trace_lock = SIMPLE_MTX_INITIALIZER;
++
++static uint64_t
++tu_swap_trace_count(const uint64_t key[3])
++{
++   const uint64_t hash = (key[0] * 0x9e3779b97f4a7c15ull) ^ (key[1] * 0xc2b2ae3d27d4eb4full) ^ key[2];
++   uint64_t count = 0;
++   simple_mtx_lock(&tu_swap_trace_lock);
++   for (unsigned probe = 0; probe < 256; probe++) {
++      struct tu_swap_trace_slot *slot = &tu_swap_trace_slots[(hash + probe) % 256];
++      if (!slot->count || !memcmp(slot->key, key, sizeof(slot->key))) {
++         memcpy(slot->key, key, sizeof(slot->key));
++         count = ++slot->count;
++         break;
++      }
++   }
++   simple_mtx_unlock(&tu_swap_trace_lock);
++   return count;   /* 0: the table is full, nothing is sent */
++}
++
++static bool
++tu_swap_trace_due(uint64_t count)
++{
++   return count && !(count & (count - 1));
++}
+ 
+ void
+ tu_note_gmem_side(struct tu_cmd_buffer *cmd, const struct tu_image_view *iview, unsigned site, bool linear, bool mutableen, unsigned swap)
+ {
+-   tu_frame_event(37,(uintptr_t)cmd,site,(uintptr_t)iview,(uintptr_t)iview->image,iview->vk.format,linear,mutableen,swap,iview->view.color_swap,iview->view.is_mutable);
++   if (tu_swap_trace_on()) {
++      const uint32_t memory_side = site == 2 ? iview->view.RB_A2D_DEST_BUFFER_INFO :
++                                   site >= 4 ? iview->view.RB_RESOLVE_SYSTEM_BUFFER_INFO : iview->view.RB_MRT_BUF_INFO;
++      const uint64_t key[3] = {(uint64_t)site | (uint64_t)iview->vk.format << 8 | (uint64_t)linear << 40 | (uint64_t)mutableen << 41 |
++                                  (uint64_t)iview->view.is_mutable << 42 | (uint64_t)(swap & 0xff) << 48 |
++                                  (uint64_t)iview->view.color_swap << 56,
++                               (uintptr_t)iview->image, memory_side};
++      const uint64_t count = tu_swap_trace_count(key);
++      if (tu_swap_trace_due(count))
++         tu_frame_event(37,count,site,(uintptr_t)iview->image,iview->vk.format,linear,mutableen,swap,iview->view.color_swap,
++                        iview->view.is_mutable,iview->view.RB_MRT_BUF_INFO,iview->view.RB_A2D_DEST_BUFFER_INFO,
++                        iview->view.RB_RESOLVE_SYSTEM_BUFFER_INFO);
++   }
+    p_atomic_inc(&tu_gmem_side_counts[site][0]);
+-   if (swap != WZYX)
++   if (swap != WZYX && swap != 0xff)
+       p_atomic_inc(&tu_gmem_side_counts[site][1]);
+    if (mutableen)
+       p_atomic_inc(&tu_gmem_side_counts[site][2]);
+@@ -5572,6 +5617,8 @@ tu_emit_blit(struct tu_cmd_buffer *cmd,
+ {
+    assert(blit_event_type != BLIT_EVENT_CLEAR);
+    uint32_t clear_mask = 0;
++   tu_note_gmem_side(cmd, iview, blit_event_type == BLIT_EVENT_LOAD ? 4 : 5,
++                     iview->image->layout[0].tile_mode == TILE6_LINEAR, false, 0xff);
+ 
+    /* BLIT_EVENT_STORE_AND_CLEAR would presumably swallow the
+     * BLIT_EVENT_CLEAR at the start of a renderpass, and be more efficient.
+diff --git a/src/freedreno/vulkan/tu_clear_blit.h b/src/freedreno/vulkan/tu_clear_blit.h
+--- a/src/freedreno/vulkan/tu_clear_blit.h
++++ b/src/freedreno/vulkan/tu_clear_blit.h
+@@ -104,7 +104,8 @@ bool
+ tu_attachment_unpadded(struct tu_cmd_buffer *cmd, const struct tu_image_view *iview);
+ 
