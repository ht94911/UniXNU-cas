 extern void sleep_token_buffer_init(void);
@@ -353,6 +354,8 @@
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+	vm_offset_t cas_trace = 0x9f960000;
+	cas_vm_trace(0x50, cas_trace);
 	arm_setup_pre_sign();
 
 	arm_slide_rebase_and_sign_image();
@@ -369,6 +372,7 @@
 #endif /* defined(HAS_APPLE_PAC) */
 
 	PE_init_platform(FALSE, args); /* Get platform expert set up */
+	cas_vm_trace(0x51, cas_trace);
 
 #if __arm64__
 	configure_timer_apple_regs();
@@ -529,7 +533,12 @@
 	__builtin_arm_wsr("pan", 1);
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
+	cas_vm_trace(0x52, cas_trace);
 	arm_vm_init(xmaxmem, args);
+	/* arm_vm_init removes TTBR0; acquire a permanent IO VA before writing. */
+	cas_trace = ml_io_map(0x9f960000, 0x1000);
+	if (cas_trace == 0) { for (;;) { __asm__ volatile ("wfe"); } }
+	cas_vm_trace(0x53, cas_trace);
 
 	if (debug_boot_arg) {
 		patch_low_glo();
@@ -598,6 +607,10 @@
 	cpu_machine_idle_init(TRUE);
 
 	PE_init_platform(TRUE, &BootCpuData);
+	cas_vm_trace(0x54, cas_trace);
+	/* Early CPU/platform boundary only, before clocks/storage/machine_startup. */
+	cas_vm_trace(0x55, cas_trace);
+	for (;;) { __asm__ volatile ("wfe"); }
 
 #if __arm64__
 	extern bool cpu_config_correct;
