@@ -90,6 +90,7 @@
 #include <IOKit/IOPlatformExpert.h>
 #endif /* HIBERNATION */
 
+extern void cas_vm_trace(unsigned long phase, unsigned long mapped_mailbox);
 extern void     patch_low_glo(void);
