+	    SecureDTGetProperty(intc, "reg", &value, &size) == kSuccess && size == 32) {
+		uint64_t reg[4];
+		for (unsigned int i = 0; i < 4; ++i) { reg[i] = cas_dt_u64((unsigned char const *)value + i * 8); }
