+static uint32_t cas_dt_u32(void const *p) {
+	unsigned char const *b = p; uint32_t v = 0;
+	for (unsigned int i = 0; i < 4; ++i) { v |= (uint32_t)b[i] << (i * 8); }
+	return v;
+}
+static uint64_t cas_dt_u64(void const *p) {
+	unsigned char const *b = p; uint64_t v = 0;
+	for (unsigned int i = 0; i < 8; ++i) { v |= (uint64_t)b[i] << (i * 8); }
+	return v;
+}
