+	    SecureDTGetProperty(cpu, "state", &value, &size) == kSuccess && size == 8 &&
+	    memcmp(value, "running", 8) == 0) { mask |= 8; }
+	if (SecureDTLookupEntry(NULL, "/arm-io", &bus) == kSuccess &&
+	    SecureDTGetProperty(bus, "ranges", &value, &size) == kSuccess && size == 24) {
+		uint64_t ranges[3];
+		for (unsigned int i = 0; i < 3; ++i) { ranges[i] = cas_dt_u64((unsigned char const *)value + i * 8); }
