+p=subprocess.run(cmd,capture_output=True,text=True);results.append(dict(command=cmd,returncode=p.returncode,stdout=p.stdout,stderr=p.stderr));print('arm64e',p.returncode,p.stderr[:2500])
+(O/'topology-v3-check.json').write_text(json.dumps(results,indent=2))
+assert all(r['returncode']==0 for r in results)
