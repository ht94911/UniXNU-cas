++/* Optional Darwin 27 consumer view of the native v2 CPU topology.
++ * The canonical scheduler/ArmCpu structures keep their original ABI.
++ * soc_die_id follows the ADT property, whose documented parser default is 0.
++ * Updated only during serialized bootstrap, before late read-only lockdown.
++ */
++#ifndef _ARM_TOPOLOGY_V3_COMPAT_H_
++#define _ARM_TOPOLOGY_V3_COMPAT_H_
++typedef struct {
++    unsigned int cpu_id;
++    uint32_t phys_id;
++    unsigned int cluster_id, die_id, soc_die_id;
++    cluster_type_t cluster_type;
++    uint32_t l2_access_penalty, l2_cache_size, l2_cache_id;
++    uint32_t l3_cache_size, l3_cache_id;
++    vm_offset_t cpu_IMPL_regs;
++    uint64_t cpu_IMPL_pa, cpu_IMPL_len;
++    vm_offset_t cpu_UTTDBG_regs;
++    uint64_t cpu_UTTDBG_pa, cpu_UTTDBG_len;
++    vm_offset_t coresight_regs;
++    uint64_t coresight_pa, coresight_len;
++    unsigned int die_cluster_id, cluster_core_id;
++    pset_id_t cpu_pset_id;
++} unixnu_topology_cpu_v3_t;
++typedef struct {
++    unsigned int cluster_id;
++    cluster_type_t cluster_type;
++    unsigned int num_cpus, first_cpu_id;
++    uint64_t cpu_mask;
++    unsigned int die_id, soc_die_id, die_cluster_id;
++    vm_offset_t acc_IMPL_regs;
++    uint64_t acc_IMPL_pa, acc_IMPL_len;
++    vm_offset_t cpm_IMPL_regs;
++    uint64_t cpm_IMPL_pa, cpm_IMPL_len;
++} unixnu_topology_cluster_v3_t;
++typedef struct {
