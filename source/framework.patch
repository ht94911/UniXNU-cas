+"""Check the optional v3 view against a real selected XNU v2 source tree.
+
+Compiles and executes the conversion with ASan/UBSan, checks byte offsets used
+by retained PMGR, and compiles the same conversion for arm64e. This does not
+enable the patch, map a donor symbol, or qualify a complete kernel image.
+"""
+import argparse,json,pathlib,re,subprocess,tempfile
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--source',type=pathlib.Path,required=True,help='selected XNU v2 source tree')
+parser.add_argument('--clang',default='/opt/unixnu-linux/llvm/bin/clang')
+parser.add_argument('--cc',default='gcc')
+parser.add_argument('--output-dir',type=pathlib.Path)
+args=parser.parse_args()
+S=args.source.resolve()
+temporary=tempfile.TemporaryDirectory(prefix='unixnu-topology-v3-')
+O=args.output_dir or pathlib.Path(temporary.name)
+O.mkdir(parents=True,exist_ok=True)
+patch=(pathlib.Path(__file__).resolve().parents[1]/'patches/xnu-12377/native-topology-v3-compat.patch').read_text()
+added=patch.split('+++ b/osfmk/arm/topology_v3_compat.h\n',1)[1].splitlines()
+header='\n'.join(line[1:] for line in added if line.startswith('+'))+'\n'
+(O/'topology_v3_compat.h').write_text(header)
+
+old=(S/'osfmk/arm/cpu_topology.h').read_text();old='\n'.join(x for x in old.splitlines() if not x.startswith('#include'))
+machine=(S/'osfmk/arm/machine_routines.h').read_text();enum=re.search(r'typedef enum \{\s*CLUSTER_TYPE_INVALID.*?\} cluster_type_t;',machine,re.S).group()
+assert 'typedef uint8_t pset_id_t;' in (S/'osfmk/kern/kern_types.h').read_text()
+prefix='''#include <stdint.h>
+#include <stddef.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+typedef uintptr_t vm_offset_t;
+typedef uint8_t pset_id_t;
+#define MAX_CPUS 64
+#define MAX_CPU_CLUSTERS 32
+'''
+test=r'''
+static unsigned char *bytes(void *p) {return p;}
+int main(void) {
+  ml_topology_cpu_t oldcpu[MAX_CPUS]; ml_topology_cluster_t oldcluster[MAX_CPU_CLUSTERS];
+  unixnu_topology_cpu_v3_t newcpu[MAX_CPUS]; unixnu_topology_cluster_v3_t newcluster[MAX_CPU_CLUSTERS];
+  unsigned int soc[MAX_CPUS]; unsigned cases=0;
+  for(unsigned count=1;count<=MAX_CPUS;count++) for(unsigned boot=0;boot<count;boot++) {
+    memset(oldcpu,0,sizeof(oldcpu));memset(oldcluster,0,sizeof(oldcluster));
+    memset(newcpu,0,sizeof(newcpu));memset(newcluster,0,sizeof(newcluster));
+    unsigned nc=(count+3)/4;
+    ml_topology_info_t source={.version=2,.cpus=oldcpu,.clusters=oldcluster,
+      .num_cpus=count,.num_clusters=nc,.max_cpu_id=count-1,.max_cluster_id=nc-1,.max_die_id=2,
+      .chip_revision=0x12345678,.cluster_types=15,.cluster_power_down=1};
+    source.boot_cpu=&oldcpu[boot];source.boot_cluster=&oldcluster[boot/4];
+    for(unsigned i=0;i<count;i++) {
+      for(unsigned j=0;j<sizeof(oldcpu[i]);j++) bytes(&oldcpu[i])[j]=(unsigned char)(i*13+j*7);
+      oldcpu[i].cpu_id=i;oldcpu[i].cluster_id=i/4;oldcpu[i].die_id=i/32;
+      oldcpu[i].cluster_type=(cluster_type_t)((i/4)%4);oldcpu[i].phys_id=0x100+(i/4)*0x100+i%4;
+      soc[i]=i/16;
+    }
+    for(unsigned i=0;i<nc;i++) {
+      for(unsigned j=0;j<sizeof(oldcluster[i]);j++) bytes(&oldcluster[i])[j]=(unsigned char)(i*31+j*3);
+      oldcluster[i].cluster_id=i;oldcluster[i].first_cpu_id=i*4;
+      oldcluster[i].num_cpus=count-i*4<4?count-i*4:4;oldcluster[i].cpu_mask=0;
+      for(unsigned j=i*4;j<count && j<i*4+4;j++)oldcluster[i].cpu_mask|=1ULL<<j;
+    }
+    for(unsigned i=0;i<MAX_CPU_TYPES;i++) {source.cluster_type_num_cpus[i]=100+i;source.cluster_type_num_clusters[i]=200+i;}
+    unsigned char beforecpu[sizeof(oldcpu)],beforecluster[sizeof(oldcluster)];
+    memcpy(beforecpu,oldcpu,sizeof(oldcpu));memcpy(beforecluster,oldcluster,sizeof(oldcluster));
+    unixnu_topology_info_v3_t view={0};
+    unixnu_topology_copy_v3(&source,soc,&view,newcpu,newcluster);
+    assert(!memcmp(beforecpu,oldcpu,sizeof(oldcpu)));assert(!memcmp(beforecluster,oldcluster,sizeof(oldcluster)));
+    assert(view.version==3 && view.max_soc_die_id==(count-1)/16);
