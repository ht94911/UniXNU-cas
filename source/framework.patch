diff --git a/scripts/build-qcom-usb-debug.py b/scripts/build-qcom-usb-debug.py
new file mode 100644
index 0000000..d4de690
--- /dev/null
+++ b/scripts/build-qcom-usb-debug.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Adapt the pinned standalone USB archive recipe to UniXNU's component outputs.
+
+The module owns all driver compilation and symbol audits. Use this target's
+real PE record; never reuse an archive from another kernel or candidate.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+from kernel_target import check_object
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--component', type=Path, required=True)
+    parser.add_argument('--soc', required=True)
+    parser.add_argument('--profile', required=True)
+    args = parser.parse_args()
+    component = args.component.resolve()
+    if subprocess.check_output(['git', '-C', component, 'status', '--porcelain']):
+        raise SystemExit('USB component must be a clean pinned source checkout')
+    record = ROOT / 'build/xnu/ios-obj/DEVELOPMENT_ARM64_BCM2837/pexpert/DEVELOPMENT/pe_kprintf.o.json'
+    if not record.is_file():
+        raise SystemExit('Generate the actual target PE compile record before building USB')
+    patch_state = json.loads(subprocess.check_output([
+        'python3', component / 'scripts/xnu_patches.py', 'status', '--profile', args.profile,
+        '--xnu', ROOT / '.cache/xnu-work'], text=True))
+    if patch_state['state_before'] != 'applied':
+        raise SystemExit('Apply the complete versioned USB hooks before compiling the component')
+    cache = ROOT / '.cache/qcom-usb-debug'
+    cache.mkdir(parents=True, exist_ok=True)
+    # Standalone build.py deliberately rejects reused output directories.
+    # Keep failed evidence; every attempt recompiles with this target's headers.
+    attempt = Path(tempfile.mkdtemp(prefix='archive-', dir=cache)) / 'module'
+    subprocess.run(['python3', component / 'scripts/build.py', '--compile-record', record,
+                    '--soc', args.soc, '--xnu-profile', args.profile, '--output', attempt], check=True)
+    for obj in sorted(attempt.glob('*.o')):
+        check_object(obj.read_bytes(), str(obj))
+    archive = attempt / 'libQcomXnuUsbDebug.a'
+    report = json.loads((attempt / 'build-report.json').read_text())
+    if hashlib.sha256(archive.read_bytes()).hexdigest() != report['archive_sha256']:
+        raise SystemExit('Standalone USB archive report/hash mismatch')
+    report.update(component_revision=subprocess.check_output(
+        ['git', '-C', component, 'rev-parse', 'HEAD'], text=True).strip(),
+        target_objects_validated=True, evidence_directory=str(attempt))
+    report['consumer_patch_state'] = patch_state
+    output = ROOT / 'build/qcom-usb-debug'
+    output.mkdir(parents=True, exist_ok=True)
+    temporary = output / 'libQcomXnuUsbDebug.a.new'
+    shutil.copyfile(archive, temporary)
+    temporary.replace(output / archive.name)
+    (output / 'build-report.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(output / archive.name)
+
+
+if __name__ == '__main__':
+    main()
