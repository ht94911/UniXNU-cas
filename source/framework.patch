+"""Host checks of the IIG-generated CallPlatformFunction client.
+
+The ABI fixture matches the donor's 140/84-byte kernel messages. Provider
+responses are simulated; this does not qualify a native server or a boot.
+"""
+import argparse,json,pathlib,subprocess,tempfile
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--output-dir',type=pathlib.Path)
+parser.add_argument('--cxx',default='g++')
+args=parser.parse_args()
+temporary=tempfile.TemporaryDirectory(prefix='unixnu-platform-client-')
+O=args.output_dir or pathlib.Path(temporary.name)
+O.mkdir(parents=True,exist_ok=True)
+patch=(pathlib.Path(__file__).resolve().parents[1]/'patches/xnu-12377/iokit-platform-function-client.patch').read_text()
+section=patch.split('+++ b/iokit/Kernel/IOUserServer.cpp\n',1)[1]
+added='\n'.join(line[1:] for line in section.splitlines() if line.startswith('+'))+'\n'
+start=added.index('struct IOService_CallPlatformFunction_Msg_Content')
+end=added.rindex('\n#endif')
+(O/'iig-client-implementation.cpp').write_text(added[start:end])
+
+prefix=r'''
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+#include <cassert>
+#include <cstdio>
+#define KERNEL 1
+using kern_return_t=int;
+using OSObjectRef=uintptr_t;
+constexpr int kIOReturnSuccess=0,kIOReturnIPCError=-1,kIOReturnBadArgument=-2;
+constexpr int kIORPCVersion190615=0x4da2b68c;
+constexpr unsigned kIORPCMessageOneway=8,kIORPCMessageSimpleReply=128,kIORPCMessageLocalHost=2,kIORPCMessageOnqueue=32;
+constexpr unsigned MACH_MSG_PORT_DESCRIPTOR=0,MACH_MSG_OOL_DESCRIPTOR=1,MACH_MSG_VIRTUAL_COPY=1;
+#pragma pack(push,4)
+struct mach_msg_header_t {uint32_t msgh_bits,msgh_size;uintptr_t remote,local;uint32_t voucher,msgh_id;};
+struct mach_msg_body_t {uint32_t msgh_descriptor_count;};
+struct mach_msg_port_descriptor_t {uintptr_t name;uint32_t pad;uint16_t pad2;uint8_t disposition,type;};
+struct mach_msg_ool_descriptor_t {void *address;uint8_t deallocate,copy,pad,type;uint32_t size;};
+struct IORPCMessageMach {mach_msg_header_t msgh;mach_msg_body_t msgh_body;};
+struct IORPCMessage {uint64_t msgid,flags,objectRefs;};
+#pragma pack(pop)
+struct mach_msg_max_trailer_t {uint8_t raw[68];};
+struct IORPC {IORPCMessageMach *message,*reply;uint32_t sendSize,replySize;IORPCMessage *kernelContent;};
+class OSMetaClassBase {public: virtual ~OSMetaClassBase()=default;};
+using OSDispatchMethod=kern_return_t(*)(OSMetaClassBase*,const IORPC);
+class OSObject:public OSMetaClassBase {public:virtual kern_return_t Invoke(const IORPC);};
+class OSString:public OSObject {};
+class OSDictionary:public OSObject {};
+#define OSDynamicCast(type,value) dynamic_cast<type*>(value)
+class IOService:public OSObject {public:
+ kern_return_t CallPlatformFunction(OSString*,bool,OSDictionary*,OSDictionary**,OSDispatchMethod=nullptr);
+};
+#define IOService_CallPlatformFunction_ID 0xbf66f4287c60ef85ULL
+'''
+test=r'''
+static_assert(sizeof(IOService_CallPlatformFunction_Msg_With_Content)==140);
+static_assert(sizeof(IOService_CallPlatformFunction_Rpl_With_Content)==84);
+static_assert(offsetof(IOService_CallPlatformFunction_Msg_With_Content,content)==84);
+static_assert(offsetof(IOService_CallPlatformFunction_Rpl_With_Content,content)==52);
+static OSString name;static OSDictionary input,output;static OSObject wrong;
+static unsigned calls=0,supercalls=0;static int mode=0;static bool expected_wait=false;
+static int dispatch(OSMetaClassBase *target,const IORPC rpc) {
+ assert(target!=nullptr);assert(rpc.sendSize==140 && rpc.replySize==152);
+ auto *msg=(IOService_CallPlatformFunction_Msg_With_Content*)rpc.message;
+ assert(msg->mach.msgh.msgh_size==140 && msg->mach.msgh.msgh_id==(uint32_t)kIORPCVersion190615);
+ assert(msg->mach.msgh_body.msgh_descriptor_count==3);
+ assert(msg->content.__hdr.objectRefs==3 && msg->content.__hdr.msgid==0xbf66f4287c60ef85ULL);
+ assert(msg->content.__object==(OSObjectRef)target);
+ assert(msg->content.functionName==&name);
+ assert(msg->content.inParam==&input);
+ assert(msg->content.__hdr.flags==0);
+ assert(msg->__object__descriptor.type==MACH_MSG_PORT_DESCRIPTOR);
+ assert(msg->functionName__descriptor.type==MACH_MSG_OOL_DESCRIPTOR && msg->inParam__descriptor.type==MACH_MSG_OOL_DESCRIPTOR);
+ assert(msg->functionName__descriptor.copy==MACH_MSG_VIRTUAL_COPY && msg->inParam__descriptor.copy==MACH_MSG_VIRTUAL_COPY);
+ assert(msg->functionName__descriptor.address==(void*)32 && msg->inParam__descriptor.address==(void*)40);
+ assert(!msg->functionName__descriptor.deallocate && !msg->inParam__descriptor.deallocate);
+ assert(msg->content.waitForFunction==expected_wait);
+ assert(rpc.kernelContent==&msg->content.__hdr);
+ if(mode==1)return 0x123456;
+ auto *reply=(IOService_CallPlatformFunction_Rpl_With_Content*)rpc.reply;
+ memset(reply,0,sizeof(*reply));reply->mach.msgh.msgh_size=84;
+ reply->mach.msgh_body.msgh_descriptor_count=1;
+ reply->content.__hdr.msgid=IOService_CallPlatformFunction_ID;
+ reply->content.__hdr.objectRefs=1;reply->content.outParam=&output;
+ switch(mode) {
+  case 2:reply->mach.msgh.msgh_size=83;break;
+  case 3:reply->content.__hdr.msgid^=1;break;
+  case 4:reply->mach.msgh_body.msgh_descriptor_count=2;break;
+  case 5:reply->content.__hdr.objectRefs=2;break;
+  case 6:reply->content.outParam=reinterpret_cast<OSDictionary*>(&wrong);break;
+  case 7:reply->content.outParam=0;break;
+ }
+ return 0;
+}
+kern_return_t OSObject::Invoke(const IORPC rpc) {calls++;return dispatch(this,rpc);}
+static kern_return_t super_dispatch(OSMetaClassBase *self,const IORPC rpc) {supercalls++;return dispatch(self,rpc);}
+int main() {
+ IOService service;unsigned cases=0;
+ for(unsigned wait=0;wait<2;wait++)for(unsigned use_super=0;use_super<2;use_super++)for(mode=0;mode<8;mode++) {
+  expected_wait=wait;OSDictionary *out=(OSDictionary*)uintptr_t(0x1234);
+  unsigned c=calls,s=supercalls;
+  int result=service.CallPlatformFunction(&name,wait,&input,&out,use_super?super_dispatch:nullptr);
+  assert(calls==c+(use_super?0:1));assert(supercalls==s+(use_super?1:0));
+  if(mode==1)assert(result==0x123456 && out==(OSDictionary*)uintptr_t(0x1234));
+  else if(mode>=2 && mode<=5)assert(result==kIOReturnIPCError && out==(OSDictionary*)uintptr_t(0x1234));
+  else if(mode==6)assert(result==kIOReturnBadArgument && out==nullptr);
+  else assert(result==0 && out==(mode==7?nullptr:&output));
+  cases++;
+ }
+ printf("%u IIG client wire/reply/error/super-dispatch cases passed; server capability unclaimed\n",cases);
+}
+'''
+src=O/'platform-client-host-test.cpp';src.write_text(prefix+(O/'iig-client-implementation.cpp').read_text()+test)
+commands=[[args.cxx,'-std=c++17','-O1','-g','-Wall','-Wextra','-Werror','-fsanitize=address,undefined',str(src),'-o',str(O/'platform-client-host-test')],[str(O/'platform-client-host-test')]]
+result=[]
+for cmd in commands:
+ p=subprocess.run(cmd,capture_output=True,text=True);result.append(dict(command=cmd,returncode=p.returncode,stdout=p.stdout,stderr=p.stderr));print(p.returncode,p.stdout,p.stderr[:4000]);
+ if p.returncode:break
+(O/'client-host-check.json').write_text(json.dumps(result,indent=2));assert len(result)==2 and all(x['returncode']==0 for x in result)
