+      assert(!memcmp(o,n,28));assert(!memcmp(o+28,n+32,4));assert(!memcmp(o+32,n+40,48));
+      assert(*(uint32_t*)(n+28)==soc[i*4]);
+    }
+    /* Re-publish after canonical MMIO mapping and processor-set initialization. */
+    oldcpu[boot].cpu_IMPL_regs=0xabcdef00;oldcpu[boot].cpu_pset_id=7;
+    oldcluster[boot/4].acc_IMPL_regs=0x12340000;
+    unixnu_topology_copy_v3(&source,soc,&view,newcpu,newcluster);
+    assert(view.boot_cpu==&newcpu[boot] && view.boot_cpu->cpu_IMPL_regs==0xabcdef00);
+    assert(view.boot_cpu->cpu_pset_id==7 && view.boot_cluster->acc_IMPL_regs==0x12340000);
+    cases++;
+  }
+  printf("%u mixed-layout/boot-pointer cases passed\n",cases);return 0;
+}
+'''
+src=prefix+enum+'\n'+old+'\n'+(O/'topology_v3_compat.h').read_text()+test
+(O/'topology-v3-test.c').write_text(src)
+commands=[[args.cc,'-std=c11','-O1','-g','-Wall','-Wextra','-Werror','-fsanitize=address,undefined',str(O/'topology-v3-test.c'),'-o',str(O/'topology-v3-test')],[str(O/'topology-v3-test')]]
+results=[]
