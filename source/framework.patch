+"""Actual public-anchor parsing rejects private or wrong-size input."""
+import importlib.util
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+spec = importlib.util.spec_from_file_location('source_storage', Path(__file__).with_name('build-sheng-source-storage.py'))
+storage = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(storage)
+
+class OwnerAnchorTests(unittest.TestCase):
+    def test_public_anchor_is_canonical_and_private_material_is_refused(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root=Path(directory)
+            private, public=root/'owner.pem', root/'public.pem'
+            subprocess.run(['openssl','genpkey','-algorithm','RSA','-pkeyopt','rsa_keygen_bits:3072','-out',private],check=True,capture_output=True)
+            subprocess.run(['openssl','pkey','-in',private,'-pubout','-out',public],check=True,capture_output=True)
+            anchor=storage.owner_anchor(public)
+            self.assertEqual(len(anchor),395)
+            self.assertEqual(anchor[:8],b'VROOTKEY')
+            self.assertEqual(anchor[-3:],b'\x01\x00\x01')
+            with self.assertRaisesRegex(ValueError,'public owner key'):
+                storage.owner_anchor(private)
+            with self.assertRaisesRegex(ValueError,'public owner key'):
+                storage.owner_anchor(root/'absent')
+
+if __name__=='__main__':unittest.main()
