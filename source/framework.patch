+    assert(*(uint32_t*)(bytes(&view)+64)==source.chip_revision);
+    assert(*(void**)(bytes(&view)+32)==newcpu && *(void**)(bytes(&view)+40)==newcluster);
+    assert(*(uint32_t*)(bytes(&view)+112)==source.cluster_power_down);
+    for(unsigned i=0;i<5;i++) {
+      assert(*(uint32_t*)(bytes(&view)+72+i*4)==(i<4?100+i:0));
+      assert(*(uint32_t*)(bytes(&view)+92+i*4)==(i<4?200+i:0));
+    }
+    for(unsigned i=0;i<count;i++) {
+      unsigned char *o=bytes(oldcpu)+i*128,*n=bytes(newcpu)+i*136;
+      assert(!memcmp(o,n,16));assert(!memcmp(o+16,n+20,24));assert(!memcmp(o+40,n+48,80));
+      assert(n[128]==o[120]);assert(*(uint32_t*)(n+16)==soc[i]);
+    }
+    for(unsigned i=0;i<nc;i++) {
