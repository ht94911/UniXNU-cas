diff --git a/patches/xnu-12377/image4-v2-no-monitor.patch b/patches/xnu-12377/image4-v2-no-monitor.patch
new file mode 100644
index 0000000..0edffc0
--- /dev/null
+++ b/patches/xnu-12377/image4-v2-no-monitor.patch
@@ -0,0 +1,63 @@
+--- a/bsd/kern/code_signing/xnu.c
++++ b/bsd/kern/code_signing/xnu.c
+@@ -387,3 +387,60 @@
+ }
+ 
+ #endif /* !CODE_SIGNING_MONITOR */
++
++
++#if XNU_IOS27_IMAGE4_V2_NOMONITOR
++#if CODE_SIGNING_MONITOR
++#error "Image4 V2 NoMonitor compatibility requires the real NoMonitor configuration"
++#endif
++/* Darwin 27's selected NoMonitor API contract. Observed in the Apple x86_64
++ * kernel ce09da26bf61 (run41354262114), including both common wrappers and
++ * xnu_image4_v2 backends: operation result 8, invalid load arguments 3.
++ * This does not advertise or implement a TXM/PPL backend and grants no trust.
++ * Existing code_signing_configuration and the software verifier are untouched.
++ */
++typedef uint16_t unixnu_image4_v2_result_t;
++enum {
++    UNIXNU_IMAGE4_V2_INVALID_LOAD_ARGUMENT = 3,
++    UNIXNU_IMAGE4_V2_NO_MONITOR_RESULT = 8,
++};
++unixnu_image4_v2_result_t image4_v2_set_nonce_digest(uint32_t handle,
++    const void *digest, size_t digest_length) __attribute__((used));
++unixnu_image4_v2_result_t image4_v2_roll_nonce(uint32_t handle) __attribute__((used));
++unixnu_image4_v2_result_t image4_v2_load_diavlo_root_ca(const void *manifest,
++    size_t manifest_length, const void *payload, size_t payload_length) __attribute__((used));
++unixnu_image4_v2_result_t image4_v2_load_local_policy(const void *manifest,
++    size_t manifest_length) __attribute__((used));
++
++unixnu_image4_v2_result_t
++image4_v2_set_nonce_digest(uint32_t handle __unused,
++    const void *digest __unused, size_t digest_length __unused)
++{
++    return UNIXNU_IMAGE4_V2_NO_MONITOR_RESULT;
++}
++
++unixnu_image4_v2_result_t
++image4_v2_roll_nonce(uint32_t handle __unused)
++{
++    return UNIXNU_IMAGE4_V2_NO_MONITOR_RESULT;
++}
++
++unixnu_image4_v2_result_t
++image4_v2_load_diavlo_root_ca(const void *manifest, size_t manifest_length,
++    const void *payload, size_t payload_length)
++{
++    if (!manifest || !manifest_length || !payload || !payload_length) {
++        return UNIXNU_IMAGE4_V2_INVALID_LOAD_ARGUMENT;
++    }
++    return UNIXNU_IMAGE4_V2_NO_MONITOR_RESULT;
++}
++
++unixnu_image4_v2_result_t
++image4_v2_load_local_policy(const void *manifest, size_t manifest_length)
++{
++    if (!manifest || !manifest_length) {
++        return UNIXNU_IMAGE4_V2_INVALID_LOAD_ARGUMENT;
++    }
++    return UNIXNU_IMAGE4_V2_NO_MONITOR_RESULT;
++}
++#endif /* XNU_IOS27_IMAGE4_V2_NOMONITOR */
diff --git a/patches/xnu-12377/iokit-platform-function-client.patch b/patches/xnu-12377/iokit-platform-function-client.patch
new file mode 100644
index 0000000..726cf67
--- /dev/null
+++ b/patches/xnu-12377/iokit-platform-function-client.patch
@@ -0,0 +1,170 @@
+--- a/iokit/IOKit/IOService.h
++++ b/iokit/IOKit/IOService.h
+@@ -404,6 +404,16 @@
+ class IOService : public IORegistryEntry
+ {
+ 	OSDeclareDefaultStructorsWithDispatch(IOService);
++
++#if XNU_IOS27_PLATFORM_FUNCTION_CLIENT
++public:
++    /* IIG client only: existing Invoke/provider dispatch returns real status.
++     * There is deliberately no new server case or _Impl returning a constant.
++     */
++    kern_return_t CallPlatformFunction(OSString *functionName, bool waitForFunction,
++        OSDictionary *inParam, OSDictionary **outParam,
++        OSDispatchMethod supermethod = NULL) __attribute__((used));
++#endif
+ 
+ #if XNU_KERNEL_PRIVATE
+ public:
+--- a/iokit/Kernel/IOUserServer.cpp
++++ b/iokit/Kernel/IOUserServer.cpp
+@@ -8046,3 +8046,148 @@
+ {
+ 	return kIOReturnUnsupported;
+ }
++
++#if XNU_IOS27_PLATFORM_FUNCTION_CLIENT
++/* Generated by Apple's DriverKit-440 IIG from complete public source
++ * declarations, with serialized OSString/OSDictionary operands (run41351733717).
++ * Method ID and 140/84-byte kernel layouts match 24A446; native host IORPC
++ * flags/Invoke semantics are retained rather than copying donor internals.
++ * Preserve Invoke, super dispatch, reply validation and dynamic type checks.
++ * This client does not claim a server capability that the provider lacks.
++ */
++#define IOService_CallPlatformFunction_ID 0xbf66f4287c60ef85ULL
++struct IOService_CallPlatformFunction_Msg_Content
++{
++    IORPCMessage __hdr;
++    OSObjectRef  __object;
++    OSString * functionName;
++#if !defined(__LP64__)
++    uint32_t __functionNamePad;
++#endif /* !defined(__LP64__) */
++    OSDictionary * inParam;
++#if !defined(__LP64__)
++    uint32_t __inParamPad;
++#endif /* !defined(__LP64__) */
++    bool  waitForFunction;
++};
++#pragma pack(4)
++struct IOService_CallPlatformFunction_Msg
++{
++    IORPCMessageMach           mach;
++    mach_msg_port_descriptor_t __object__descriptor;
++    mach_msg_ool_descriptor_t  functionName__descriptor;
++    mach_msg_ool_descriptor_t  inParam__descriptor;
++};
++struct IOService_CallPlatformFunction_Msg_With_Content
++{
++    IORPCMessageMach           mach;
++    mach_msg_port_descriptor_t __object__descriptor;
++    mach_msg_ool_descriptor_t  functionName__descriptor;
++    mach_msg_ool_descriptor_t  inParam__descriptor;
++    IOService_CallPlatformFunction_Msg_Content content;
++};
++#pragma pack()
++#define IOService_CallPlatformFunction_Msg_ObjRefs (3)
++
++struct IOService_CallPlatformFunction_Rpl_Content
++{
++    IORPCMessage __hdr;
++    OSDictionary * outParam;
++#if !defined(__LP64__)
++    uint32_t __outParamPad;
++#endif /* !defined(__LP64__) */
++};
++#pragma pack(4)
++struct IOService_CallPlatformFunction_Rpl
++{
++    IORPCMessageMach           mach;
++    mach_msg_ool_descriptor_t  outParam__descriptor;
++};
++struct IOService_CallPlatformFunction_Rpl_With_Content
++{
++    IORPCMessageMach           mach;
++    mach_msg_ool_descriptor_t  outParam__descriptor;
++    IOService_CallPlatformFunction_Rpl_Content content;
++};
++#pragma pack()
++#define IOService_CallPlatformFunction_Rpl_ObjRefs (1)
++
++static_assert(sizeof(IOService_CallPlatformFunction_Msg_With_Content) == 140, "CallPlatformFunction request ABI");
++static_assert(sizeof(IOService_CallPlatformFunction_Rpl_With_Content) == 84, "CallPlatformFunction reply ABI");
++static_assert(__builtin_offsetof(IOService_CallPlatformFunction_Msg_With_Content, content) == 84, "CallPlatformFunction content ABI");
++static_assert(sizeof(IORPC) == 32, "kernel IORPC call ABI");
++kern_return_t
++IOService::CallPlatformFunction(
++        OSString * functionName,
++        bool waitForFunction,
++        OSDictionary * inParam,
++        OSDictionary ** outParam,
++        OSDispatchMethod supermethod)
++{
++    kern_return_t ret;
++    union
++    {
++        IOService_CallPlatformFunction_Msg_With_Content msg;
++        struct
++        {
++            IOService_CallPlatformFunction_Rpl_With_Content rpl;
++            mach_msg_max_trailer_t trailer;
++        } rpl;
++    } buf;
++    struct IOService_CallPlatformFunction_Msg_With_Content * msg = &buf.msg;
++    struct IOService_CallPlatformFunction_Rpl_With_Content * rpl = &buf.rpl.rpl;
++
++    memset(msg, 0, sizeof(*msg));
++    msg->mach.msgh.msgh_id   = kIORPCVersion190615;
++    msg->mach.msgh.msgh_size = sizeof(*msg);
++    msg->content.__hdr.flags = 0*kIORPCMessageOneway
++                             | 0*kIORPCMessageSimpleReply
++                             | 0*kIORPCMessageLocalHost
++                             | 0*kIORPCMessageOnqueue;
++    msg->content.__hdr.msgid = IOService_CallPlatformFunction_ID;
++    msg->content.__object = (OSObjectRef) this;
++    msg->content.__hdr.objectRefs = IOService_CallPlatformFunction_Msg_ObjRefs;
++    msg->mach.msgh_body.msgh_descriptor_count = 3;
++
++    msg->__object__descriptor.type = MACH_MSG_PORT_DESCRIPTOR;
++
++    msg->functionName__descriptor.type = MACH_MSG_OOL_DESCRIPTOR;
++    msg->functionName__descriptor.copy = MACH_MSG_VIRTUAL_COPY;
++    msg->functionName__descriptor.address = (void *) __builtin_offsetof(IOService_CallPlatformFunction_Msg_Content, functionName);
++    msg->content.functionName = functionName;
++
++    msg->content.waitForFunction = waitForFunction;
++
++    msg->inParam__descriptor.type = MACH_MSG_OOL_DESCRIPTOR;
++    msg->inParam__descriptor.copy = MACH_MSG_VIRTUAL_COPY;
++    msg->inParam__descriptor.address = (void *) __builtin_offsetof(IOService_CallPlatformFunction_Msg_Content, inParam);
++    msg->content.inParam = inParam;
++
++#ifdef KERNEL
++    IORPC rpc = { .message = &buf.msg.mach, .reply = &buf.rpl.rpl.mach, .sendSize = sizeof(buf.msg), .replySize = sizeof(buf.rpl), .kernelContent = &buf.msg.content.__hdr };
++#else /* KERNEL */
++    IORPC rpc = { .message = &buf.msg.mach, .reply = &buf.rpl.rpl.mach, .sendSize = sizeof(buf.msg), .replySize = sizeof(buf.rpl) };
++#endif /* KERNEL */
++    if (supermethod) ret = supermethod((OSObject *)this, rpc);
++    else             ret = ((OSObject *)this)->Invoke(rpc);
++
++    if (kIOReturnSuccess == ret)
++    do {
++        {
++            if (rpl->mach.msgh.msgh_size                  != sizeof(*rpl)) { ret = kIOReturnIPCError; break; };
++            if (rpl->content.__hdr.msgid                  != IOService_CallPlatformFunction_ID) { ret = kIOReturnIPCError; break; };
++            if (rpl->mach.msgh_body.msgh_descriptor_count != 1) { ret = kIOReturnIPCError; break; };
++            if (IOService_CallPlatformFunction_Rpl_ObjRefs   != rpl->content.__hdr.objectRefs) { ret = kIOReturnIPCError; break; };
++        }
++    }
++    while (false);
++    if (kIOReturnSuccess == ret)
++    {
++        *outParam = OSDynamicCast(OSDictionary, (OSObject *) rpl->content.outParam);
++        if (rpl->content.outParam && !*outParam) ret = kIOReturnBadArgument;
++    }
++
++
++    return (ret);
++}
++#endif
