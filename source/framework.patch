index 0000000..162cdd5
--- /dev/null
+++ b/scripts/qemu-entry/darwinboot_parser.py
@@ -0,0 +1,72 @@
+"""Read a kernel layout through DarwinBoot's unchanged production C parser.
+
+Host fixture adapter only: no loader code, relocations, or guest modifications.
+The preamble is the existing component test's literal host typedef shim.
+"""
+import ast
+import ctypes
+import hashlib
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import tempfile
+
+
+def parse_kernel(source, data):
+    source = Path(source).resolve()
+    text = source.read_text()
+    # Driver source is DarwinBootPkg/Driver/DarwinBoot.c.
+    test = source.parents[2] / 'Test/test-kernel-parser.py'
+    shim = None
+    for node in ast.parse(test.read_text()).body:
+        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'preamble' for t in node.targets):
+            shim = ast.literal_eval(node.value)
+    if shim is None:
+        raise ValueError('DarwinBoot host parser test has no literal preamble')
+    types = text[text.index('typedef struct {'):text.index('STATIC EFI_HANDLE')]
+    parser = text[text.index('STATIC\nEFI_STATUS\nParseKernelHeader'):text.index('STATIC\nBOOLEAN\nAdtNode')]
+    wrapper = '''
+int describe(const UINT8 *p, UINTN n, UINT64 *v, UINTN capacity) {
+  KERNEL k; EFI_STATUS status = ParseKernel(p, n, &k);
+  if (status != EFI_SUCCESS) return status;
+  if (capacity < 4 + k.Count * 5) return 1;
+  v[0] = k.Base; v[1] = k.End; v[2] = k.Entry; v[3] = k.Count;
+  for (UINTN i = 0; i < k.Count; ++i) {
+    v[4+i*5] = k.Segments[i].Address; v[5+i*5] = k.Segments[i].Size;
+    v[6+i*5] = k.Segments[i].FileOffset; v[7+i*5] = k.Segments[i].FileSize;
+    v[8+i*5] = k.Segments[i].Protection;
+  }
+  return 0;
+}
+'''
+    compiler = shutil.which('clang')
+    if not compiler:
+        raise ValueError('clang is required for the production parser fixture')
+    with tempfile.TemporaryDirectory(prefix='darwinboot-layout-') as directory:
+        root = Path(directory)
+        (root / 'parser.c').write_text(shim + types + parser + wrapper)
+        subprocess.run([compiler, '-Wall', '-Wextra', '-Werror', '-shared', '-fPIC',
+                        str(root / 'parser.c'), '-o', str(root / 'parser.so')], check=True)
+        library = ctypes.CDLL(str(root / 'parser.so'))
+        library.describe.argtypes = [ctypes.c_void_p, ctypes.c_size_t,
+                                     ctypes.POINTER(ctypes.c_uint64), ctypes.c_size_t]
+        values = (ctypes.c_uint64 * (4 + 64 * 5))()
+        status = library.describe(ctypes.create_string_buffer(data), len(data), values, len(values))
+        if status:
+            raise ValueError(f'Production DarwinBoot parser refused kernel: EFI status {status}')
+    # Names are labels only; geometry and acceptance come exclusively from C.
+    names, offset = [], 32
+    for _ in range(struct.unpack_from('<I', data, 16)[0]):
+        command, size = struct.unpack_from('<II', data, offset)
+        if command == 0x19 and struct.unpack_from('<Q', data, offset + 32)[0]:
+            names.append(data[offset + 8:offset + 24].rstrip(b'\0').decode('ascii'))
+        offset += size
+    if len(names) != values[3]:
+        raise ValueError('Production segment count differs from label count')
+    segments = []
+    for i, name in enumerate(names):
+        start = 4 + i * 5
+        segments.append((name, *values[start:start + 5]))
+    return {'base': values[0], 'end': values[1], 'entry': values[2], 'segments': segments,
+            'parser_source': str(source), 'parser_source_sha256': hashlib.sha256(source.read_bytes()).hexdigest()}
