+arm_prefix=prefix.replace('#include <assert.h>','#define assert(x) ((x) ? (void)0 : __builtin_trap())').replace('#include <stdio.h>','').replace('#include <string.h>','')+'\n#define __BEGIN_DECLS\n#define __END_DECLS\n'
+arm_src=arm_prefix+enum+'\n'+old+'\n'+(O/'topology_v3_compat.h').read_text()+'''\nvoid check_copy(const ml_topology_info_t *s, const unsigned int *ids, unixnu_topology_info_v3_t *v, unixnu_topology_cpu_v3_t *c, unixnu_topology_cluster_v3_t *k) { unixnu_topology_copy_v3(s,ids,v,c,k); }\n'''
+(O/'topology-v3-arm64e.c').write_text(arm_src)
