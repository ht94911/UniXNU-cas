// Xiaomi 17 Ultra (nezha). Memory and reserved regions from the N0 live DT (2026-10-26).
/dts-v1/;
/include/ "sm8850.dtsi"

/ {
    model = "Qualcomm Technologies, Inc. xiaomi nezha";
    compatible = "xiaomi,nezha", "qcom,kaanapali-mtp", "qcom,kaanapali", "qcom,mtp";
    chosen { stdout-path = "/display"; };
    // Follow sheng27's standard ADT export for the stock wifid job condition.
    // The board worker owns PCIe resources; this node adds no DMA or MMIO lease.
    wlan {
        compatible = "qcom,wcn7860";
        unixnu,adt-name = "wlan";
        status = "okay";
    };
    bluetooth {
        device_type = "bluetooth";
        compatible = "qcom,wcn7860-bt";
        unixnu,adt-name = "bluetooth";
        transport-encoding = <1>;
        transport-speed = <3200000>;
        status = "okay";
    };
    memory@81960000 {
        device_type = "memory";
        reg = <0x0 0x81960000 0x0 0xa0000>;
    };
    memory@81a60000 {
        device_type = "memory";
        reg = <0x0 0x81a60000 0x0 0x1a0000>;
    };
    memory@81cf4000 {
        device_type = "memory";
        reg = <0x0 0x81cf4000 0x0 0xc000>;
    };
    memory@82478000 {
        device_type = "memory";
        reg = <0x0 0x82478000 0x0 0x28000>;
    };
    memory@82600000 {
        device_type = "memory";
        reg = <0x0 0x82600000 0x0 0x100000>;
    };
    memory@82800000 {
        device_type = "memory";
        reg = <0x0 0x82800000 0x0 0x2800000>;
    };
    memory@8a000000 {
        device_type = "memory";
        reg = <0x0 0x8a000000 0x0 0xa00000>;
    };
    memory@98b00000 {
        device_type = "memory";
        reg = <0x0 0x98b00000 0x0 0xa00000>;
    };
    memory@9959c000 {
        device_type = "memory";
        reg = <0x0 0x9959c000 0x0 0x64000>;
    };
    memory@9ce80000 {
        device_type = "memory";
        reg = <0x0 0x9ce80000 0x0 0x31d0000>;
    };
    memory@a0910000 {
        device_type = "memory";
        reg = <0x0 0xa0910000 0x0 0xa70000>;
    };
    memory@a6980000 {
        device_type = "memory";
        reg = <0x0 0xa6980000 0x0 0x1d450000>;
    };
    memory@c4800000 {
        device_type = "memory";
        reg = <0x0 0xc4800000 0x0 0x13000000>;
    };
    memory@d7c00000 {
        device_type = "memory";
        reg = <0x0 0xd7c00000 0x0 0x400000>;
    };
    memory@deca0000 {
        device_type = "memory";
        reg = <0x0 0xdeca0000 0x0 0x2075f800>;
    };
    memory@ff400000 {
        device_type = "memory";
        reg = <0x0 0xff400000 0x0 0x400000>;
    };
    memory@880000000 {
        device_type = "memory";
        reg = <0x8 0x80000000 0x0 0x2f6fd000>;
    };
    memory@8b0000000 {
        device_type = "memory";
        reg = <0x8 0xb0000000 0x0 0x8500000>;
    };
    memory@8b8700000 {
        device_type = "memory";
        reg = <0x8 0xb8700000 0x0 0x1e00000>;
    };
    memory@8c0000000 {
        device_type = "memory";
        reg = <0x8 0xc0000000 0x1 0x40000000>;
    };
    memory@a00000000 {
        device_type = "memory";
        reg = <0xa 0x0 0x2 0x0>;
    };
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
        gunyah_hyp_region@80000000 {
            reg = <0x0 0x80000000 0x0 0xe00000>;
            no-map;
        };
        reserved_region@80e00000 {
            reg = <0x0 0x80e00000 0x0 0x400000>;
            no-map;
        };
        cpucp_pdp_region@81200000 {
            reg = <0x0 0x81200000 0x0 0x200000>;
            no-map;
        };
        xbl_dtlog_region@81a00000 {
            reg = <0x0 0x81a00000 0x0 0x60000>;
            no-map;
        };
        aop_image_region@81c00000 {
            reg = <0x0 0x81c00000 0x0 0x60000>;
            no-map;
        };
        aop_cmd_db_region@81c60000 {
            reg = <0x0 0x81c60000 0x0 0x20000>;
            no-map;
        };
        aop_tme_uefi_merged_region@81c80000 {
            reg = <0x0 0x81c80000 0x0 0x74000>;
            no-map;
        };
        smem_region@81d00000 {
            reg = <0x0 0x81d00000 0x0 0x200000>;
            no-map;
        };
        pdp_ns_shared_region@81f00000 {
            reg = <0x0 0x81f00000 0x0 0x100000>;
            no-map;
        };
        cpucp_scandump_region@82000000 {
            reg = <0x0 0x82000000 0x0 0x380000>;
            no-map;
        };
        adsp_mhi_region@82380000 {
            reg = <0x0 0x82380000 0x0 0x20000>;
            no-map;
        };
        soccp_sdi_region@823a0000 {
            reg = <0x0 0x823a0000 0x0 0x40000>;
            no-map;
        };
        pmic_minii_dump_region@823e0000 {
            reg = <0x0 0x823e0000 0x0 0x80000>;
            no-map;
        };
        qup_fw_region@82460000 {
            reg = <0x0 0x82460000 0x0 0x18000>;
            no-map;
        };
        pvm_fw_region@824a0000 {
            reg = <0x0 0x824a0000 0x0 0x100000>;
            no-map;
        };
        tz_stat_region@82700000 {
            reg = <0x0 0x82700000 0x0 0x100000>;
            no-map;
        };
        qdss_apps_region@82800000 {
            reg = <0x0 0x82800000 0x0 0x2000000>;
            no-map;
        };
        dsm_partition_1_region@85000000 {
            reg = <0x0 0x85000000 0x0 0x4f00000>;
            no-map;
        };
        dsm_partition_2_region@89f00000 {
            reg = <0x0 0x89f00000 0x0 0x100000>;
            no-map;
        };
        mpss_region@8aa00000 {
            reg = <0x0 0x8aa00000 0x0 0xe100000>;
            no-map;
        };
        q6_mpss_dtb_region@99500000 {
            reg = <0x0 0x99500000 0x0 0x80000>;
            no-map;
        };
        ipa_fw_region@99580000 {
            reg = <0x0 0x99580000 0x0 0x10000>;
            no-map;
        };
        ipa_gsi_region@99590000 {
            reg = <0x0 0x99590000 0x0 0xa000>;
            no-map;
        };
        gpu_microcode_region@9959a000 {
            reg = <0x0 0x9959a000 0x0 0x2000>;
            no-map;
        };
        camera_region@99600000 {
            reg = <0x0 0x99600000 0x0 0x800000>;
            no-map;
        };
        camera_2_region@99e00000 {
            reg = <0x0 0x99e00000 0x0 0x800000>;
            no-map;
        };
        video_region@9a600000 {
            reg = <0x0 0x9a600000 0x0 0x800000>;
            no-map;
        };
        cvp_region@9ae00000 {
            reg = <0x0 0x9ae00000 0x0 0x700000>;
            no-map;
        };
        cdsp_region@9b500000 {
            reg = <0x0 0x9b500000 0x0 0x1900000>;
            no-map;
        };
        q6_cdsp_dtb_region@9ce00000 {
            reg = <0x0 0x9ce00000 0x0 0x80000>;
            no-map;
        };
        dcp_dtb_region@a0050000 {
            reg = <0x0 0xa0050000 0x0 0x80000>;
            no-map;
        };
        dcp_region@a00d0000 {
            reg = <0x0 0xa00d0000 0x0 0x300000>;
            no-map;
        };
        soccp_region@a03d0000 {
            reg = <0x0 0xa03d0000 0x0 0x500000>;
            no-map;
        };
        soccp_dtb_region@a08d0000 {
            reg = <0x0 0xa08d0000 0x0 0x40000>;
            no-map;
        };
        q6_adsp_dtb_region@a1380000 {
            reg = <0x0 0xa1380000 0x0 0x80000>;
            no-map;
        };
        adspslpi_region@a1400000 {
            reg = <0x0 0xa1400000 0x0 0x5580000>;
            no-map;
        };
        hypervisor_extended_heap_region@c3dd0000 {
            reg = <0x0 0xc3dd0000 0x0 0xa30000>;
            no-map;
        };
        xbl_ramdump_region@d7800000 {
            reg = <0x0 0xd7800000 0x0 0x200000>;
            no-map;
        };
        global_sync_region@d7a00000 {
            reg = <0x0 0xd7a00000 0x0 0x200000>;
            no-map;
        };
        tz_merged_region@d8000000 {
            reg = <0x0 0xd8000000 0x0 0x800000>;
            no-map;
        };
        trust_ui_vm_region@f3800000 {
            reg = <0x0 0xf3800000 0x0 0x5000000>;
            no-map;
        };
        oem_vm_region@f8800000 {
            reg = <0x0 0xf8800000 0x0 0x3800000>;
            no-map;
        };
        shm@fc200000 {
            reg = <0x0 0xfc200000 0x0 0x400000>;
            no-map;
        };
        splash_region@fc800000 {
            reg = <0x0 0xfc800000 0x0 0x2b00000>;
            no-map;
        };
        dump_display_region@ff3ff800 {
            reg = <0x0 0xff3ff800 0x0 0x800>;
            no-map;
        };
        ramoops_region@ff400000 {
            reg = <0x0 0xff400000 0x0 0x200000>;
            no-map;
        };
        llcc_lpi_region@ff800000 {
            reg = <0x0 0xff800000 0x0 0x800000>;
            no-map;
        };
        lcp_dare_region@880000000 {
            reg = <0x8 0x80000000 0x0 0x6000000>;
            no-map;
        };
    };
};

&cpu0 { status = "okay"; };
&cpu1 { status = "okay"; };
&cpu2 { status = "okay"; };
&cpu3 { status = "okay"; };
&cpu4 { status = "okay"; };
&cpu5 { status = "okay"; };
&cpu6 { status = "okay"; };
&cpu7 { status = "okay"; };


// XNU12377 requires an explicit scheduler cluster class. Reuse the upstream
// E/P property exported by devicetree.py (as sheng27 does). SM8850 uses Oryon
// cores; this cpus=1 bring-up starts with a logical P class for every node.
// It does not claim heterogeneous scheduling/frequency validation.
&cpu0 { unixnu,cluster-type = "P"; };
&cpu1 { unixnu,cluster-type = "P"; };
&cpu2 { unixnu,cluster-type = "P"; };
&cpu3 { unixnu,cluster-type = "P"; };
&cpu4 { unixnu,cluster-type = "P"; };
&cpu5 { unixnu,cluster-type = "P"; };
&cpu6 { unixnu,cluster-type = "P"; };
&cpu7 { unixnu,cluster-type = "P"; };
