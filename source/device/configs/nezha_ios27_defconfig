#043: existing owner-verified read-only OS/SystemOS view before PID1; no Data or graphics changes.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_QCOM_USB_DEBUG=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
# Preserve042 source UFS, original storage/decompressor selection and hardware-tested USB.
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_BOOT_PROGRESS=y

# Existing pre-AMFI service hook; real donor class, no Apple MMIO provider.
CONFIG_XNU_SHENG_PMGR=y

# Actual policy bundle is prepared locally and authenticated during handoff.
# Mac compilation receives only this public anchor, never images or keys.
CONFIG_XNU_SOURCE_STORAGE_OWNER_PUBLIC_KEY="{tree}/kits/nezha/ios27-root-owner-public.pem"
CONFIG_XNU_SOURCE_STORAGE_TABLES="userdata"
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/sheng-source-storage/libShengSourceStorage.a -Wl,-force_load,{tree}/build/nezha27-usb-control/libNezha27UsbControl.a -Wl,-force_load,{tree}/build/nezha27-input/libNezha27Input.a -Wl,-force_load,{tree}/build/adreno840/libAdreno840.a -Wl,-force_load,{tree}/build/nezha27-shared/libNezha27Shared.a -Wl,-force_load,{tree}/build/nezha27-baseband/libNezha27Baseband.a"

# No sheng SPMI cell or hypervisor-watchdog reset code in this27 archive.
CONFIG_XNU_SOURCE_STORAGE_BOARD_RESET=n

# First root mount uses USB console; no GPU-dependent file/screenshot exporter.
CONFIG_XNU_SOURCE_STORAGE_DIAG_EXPORT=n

# Observed fresh APFS seed UUID; no17 Data or persistence.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="0D2ECEAF-0E9E-4C53-91E2-A48CDBDB5FF6"
