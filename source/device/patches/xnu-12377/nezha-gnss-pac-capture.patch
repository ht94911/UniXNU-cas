+
+#if __arm64__
+/* The existing fatal recorder calls this while holding a waiting thread's
+ * scheduler lock and its task lock. Copy scalars only; never copy user memory,
+ * acquire another lock, or dereference the wait-event knote here. */
+void sheng_gnss_waiter_snapshot(thread_t, unsigned, thread_continue_t,
+    void *, uint64_t [32]);
+
+void
+sheng_gnss_waiter_snapshot(thread_t thread, unsigned block_hint,
+    thread_continue_t continuation, void *parameter, uint64_t words[32])
+{
+	struct uthread *uth = get_bsdthread_info(thread);
+	memset(words, 0, 32 * sizeof(*words));
+	if (uth == NULL) {
+		return;
+	}
+	words[0] = uth->syscall_code;
+	words[1] = uth->uu_workq_flags;
+	words[2] = uth->uu_workq_stackaddr;
+	words[3] = uth->uu_workq_thport;
+	words[4] = (uint32_t)uth->uu_rval[0] | ((uint64_t)(uint32_t)uth->uu_rval[1] << 32);
+	memcpy(&words[5], uth->uu_arg, sizeof(uth->uu_arg));
+	/* uu_save is a union: only interpret the original wait continuation's
+	 * storage when both its pointer and typed continuation match. */
+	if (uth->syscall_code == SYS_kevent_id &&
+	    block_hint == kThreadWaitWorkloopSyncWait &&
+	    continuation == filt_wlwait_continue &&
+	    parameter == &uth->uu_save.uus_kevent_register) {
+		struct _kevent_register *args = &uth->uu_save.uus_kevent_register;
+		_Static_assert(sizeof(args->kev) == 9 * sizeof(*words), "kevent scalar layout");
+		words[13] = 1;
+		memcpy(&words[14], &args->kev, sizeof(args->kev));
+		words[23] = (uint64_t)args->handoff_thread;
+		words[24] = (uint64_t)args->kqwl;
+		words[25] = (uint32_t)args->eventout;
+		words[26] = args->ueventlist;
+	}
+}
+#endif /* __arm64__ */
 
