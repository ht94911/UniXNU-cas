+/* Copy saved scalar states under try-locks, then read sampled user frames
+ * outside those locks. The current locationd fault already owns this task. */
+#if __arm64__
+struct sheng_gnss_object_peer {
+	uint64_t tid, pc, lr, sp, fp, x19, x20;
+	uint64_t tsd, wait_event, waitq, continuation, parameter;
+	uint64_t x21, x22, x23, x24, x25, x26, x27, x28;
+	uint64_t bsd[32];
+	int wait_result;
+	unsigned state, block_hint;
+};
+
+static bool
+sheng_gnss_user_range(uint64_t address, unsigned size)
+{
+	return address >= 4096 && address < (UINT64_C(1) << 47) &&
+	       size <= (UINT64_C(1) << 47) - address;
+}
+
+static void
+sheng_gnss_object_words(const char *label, uint64_t address)
+{
+	uint64_t words[16] = {};
+	int error = sheng_gnss_user_range(address, sizeof(words)) ?
+	    copyin((user_addr_t)address, words, sizeof(words)) : -1;
+	printf("NEZHA GNSS OBJECT: %s address=0x%llx bytes=%lu error=%d\n",
+	    label, address, sizeof(words), error);
+	if (error) {
+		return;
+	}
+	for (unsigned i = 0; i < 16; i += 4) {
+		printf("NEZHA GNSS OBJECT: %s+0x%x %llx %llx %llx %llx\n",
+		    label, i * 8, words[i], words[i + 1], words[i + 2], words[i + 3]);
+	}
+}
+
+#ifdef MACH_BSD
+extern void sheng_gnss_waiter_snapshot(thread_t, unsigned, thread_continue_t,
+    void *, uint64_t [32]);
+#endif
+
+static void
+sheng_gnss_object_context(task_t task, arm_saved_state_t *fault)
+{
+	static struct sheng_gnss_object_peer peers[64];
+	static unsigned busy;
+	const uint64_t object = get_saved_state_reg(fault, 25);
+	const uint64_t lane = get_saved_state_reg(fault, 20);
+	unsigned count = 0, visited = 0, skipped = 0;
+	if (!ml_get_interrupts_enabled() ||
+	    __atomic_exchange_n(&busy, 1u, __ATOMIC_ACQUIRE)) {
+		printf("NEZHA GNSS OBJECT: peer snapshot unavailable\n");
+		return;
+	}
+	sheng_gnss_object_words("item", object);
+	sheng_gnss_object_words("lane", lane);
+	sheng_gnss_object_words("next", get_saved_state_reg(fault, 26));
+	sheng_gnss_object_words("tail", get_saved_state_reg(fault, 1));
+	if (!task_lock_try(task)) {
+		printf("NEZHA GNSS OBJECT: task snapshot busy\n");
+		__atomic_store_n(&busy, 0u, __ATOMIC_RELEASE);
+		return;
+	}
+	thread_t peer;
+	queue_iterate(&task->threads, peer, thread_t, task_threads) {
+		if (visited++ >= 64) {
+			break;
+		}
+		boolean_t irq = ml_set_interrupts_enabled(FALSE);
+		if (!simple_lock_try(&peer->sched_lock, &thread_lck_grp)) {
+			++skipped;
+			ml_set_interrupts_enabled(irq);
+			continue;
+		}
+		arm_saved_state_t *state = peer->machine.upcb;
+		if ((peer->state & (TH_WAIT | TH_RUN | TH_TERMINATE | TH_TERMINATE2)) == TH_WAIT &&
+		    state != NULL && is_saved_state64(state)) {
+			uint64_t sp = get_saved_state_sp(state);
+			bool near = sheng_gnss_user_range(sp, 16) &&
+			    ((object >= sp && object - sp <= 65536) ||
+			     (sp > object && sp - object <= 4096));
+			if (near) {
+				struct sheng_gnss_object_peer *sample = &peers[count++];
+				*sample = (struct sheng_gnss_object_peer){
+					.tid = peer->thread_id, .state = peer->state,
+					.pc = get_saved_state_pc(state), .lr = get_saved_state_lr(state),
+					.sp = sp, .fp = get_saved_state_fp(state),
+					.x19 = get_saved_state_reg(state, 19),
+					.x20 = get_saved_state_reg(state, 20),
+					.x21 = get_saved_state_reg(state, 21),
+					.x22 = get_saved_state_reg(state, 22),
+					.x23 = get_saved_state_reg(state, 23),
+					.x24 = get_saved_state_reg(state, 24),
+					.x25 = get_saved_state_reg(state, 25),
+					.x26 = get_saved_state_reg(state, 26),
+					.x27 = get_saved_state_reg(state, 27),
+					.x28 = get_saved_state_reg(state, 28),
+					.tsd = peer->machine.cthread_self,
+					.wait_event = peer->wait_event,
+					.waitq = (uint64_t)peer->waitq.wq_q,
+					.wait_result = peer->wait_result,
+					.block_hint = peer->block_hint,
+					.continuation = (uint64_t)peer->continuation,
+					.parameter = (uint64_t)peer->parameter,
+				};
+#ifdef MACH_BSD
+				sheng_gnss_waiter_snapshot(peer, sample->block_hint,
+				    peer->continuation, peer->parameter, sample->bsd);
+#endif
+			}
+		}
+		thread_unlock(peer);
+		ml_set_interrupts_enabled(irq);
+	}
+	unsigned slide = task->task_shared_region_slide;
+	uint64_t images = task->all_image_info_addr;
+	task_unlock(task);
+	sheng_gnss_object_words("dyld-images", images);
+	printf("NEZHA GNSS OBJECT: peers=%u visited=%u skipped=%u cache_slide=0x%x sampled=1\n",
+	    count, visited > 64 ? 64 : visited, skipped, slide);
+	for (unsigned i = 0; i < count; ++i) {
+		const struct sheng_gnss_object_peer *sample = &peers[i];
+		uint64_t fp = sample->fp;
+		printf("NEZHA GNSS PEER: tid=%llx state=0x%x pc=%llx lr=%llx sp=%llx fp=%llx x19=%llx x20=%llx\n",
+		    sample->tid, sample->state, sample->pc, sample->lr, sample->sp,
+		    fp, sample->x19, sample->x20);
+		printf("NEZHA GNSS WAIT: tid=%llx event=%llx waitq=%llx result=%d hint=%u continuation=%llx parameter=%llx tsd=%llx sampled=1\n",
+		    sample->tid, sample->wait_event, sample->waitq, sample->wait_result,
+		    sample->block_hint, sample->continuation, sample->parameter, sample->tsd);
+		printf("NEZHA GNSS PEER REGS: tid=%llx x21=%llx x22=%llx x23=%llx x24=%llx x25=%llx x26=%llx x27=%llx x28=%llx\n",
+		    sample->tid, sample->x21, sample->x22, sample->x23, sample->x24,
+		    sample->x25, sample->x26, sample->x27, sample->x28);
+		for (unsigned word = 0; word < 32; word += 4) {
+			printf("NEZHA GNSS BSD: tid=%llx word=%u %llx %llx %llx %llx\n",
+			    sample->tid, word, sample->bsd[word], sample->bsd[word + 1],
+			    sample->bsd[word + 2], sample->bsd[word + 3]);
+		}
+		if (sheng_gnss_user_range(sample->tsd, 0x400)) {
+			uint64_t dsc = 0, after = 0;
+			int error = copyin((user_addr_t)(sample->tsd + 0x3c8), &dsc, sizeof(dsc));
+			sheng_gnss_object_words("dispatch-tsd", sample->tsd + 0x3c0);
+			/* Original libdispatch stores its current sync context in this TSD slot.
+			 * Reads are samples after unlocking; do not treat pointer stability as
+			 * proof that another thread has not changed the context contents. */
+			if (!error && !(dsc & 15) && sheng_gnss_user_range(dsc, 128) &&
+			    dsc >= sample->sp && dsc - sample->sp <= 65536) {
+				sheng_gnss_object_words("current-dsc", dsc);
+			}
+			int repeat = copyin((user_addr_t)(sample->tsd + 0x3c8), &after, sizeof(after));
+			printf("NEZHA GNSS DSC: tid=%llx pointer=%llx after=%llx error=%d repeat=%d sampled=1\n",
+			    sample->tid, dsc, after, error, repeat);
+		}
+		for (unsigned frame = 0; frame < 18 && fp; ++frame) {
+			if (frame < 4 && fp >= 0x70 && !(fp & 15)) {
+				sheng_gnss_object_words("frame-state", fp - 0x70);
+			}
+			uint64_t pair[2] = {};
+			if (!sheng_gnss_user_range(fp, sizeof(pair)) || (fp & 15) ||
+			    copyin((user_addr_t)fp, pair, sizeof(pair))) {
+				printf("NEZHA GNSS PEER: tid=%llx frame=%u unavailable fp=%llx\n",
+				    sample->tid, frame, fp);
+				break;
+			}
+			printf("NEZHA GNSS PEER: tid=%llx frame=%u fp=%llx next=%llx ret=%llx\n",
+			    sample->tid, frame, fp, pair[0], pair[1] & UINT64_C(0x00007fffffffffff));
+			if (pair[0] <= fp || pair[0] - fp > 1048576) {
+				break;
+			}
+			fp = pair[0];
+		}
+	}
+	__atomic_store_n(&busy, 0u, __ATOMIC_RELEASE);
+}
+#endif /* __arm64__ */
+
+/* GNSS002 locationd PAC faults are fatal before the existing exception
+ * recorder runs. Reuse its saved-state/frame capture before fatal handling;
+ * only locationd, at most three captures, with the original exit retained. */
+static void
+sheng_gnss_pac_capture(exception_type_t exception, mach_exception_data_t code)
+{
+#ifdef MACH_BSD
+	thread_t thread = current_thread();
+	task_t task = current_task();
+	mach_msg_type_number_t codeCnt = 2;
+	static unsigned captures;
+	if (get_bsdtask_info(task) &&
+	    !strcmp(proc_best_name(get_bsdtask_info(task)), "locationd") &&
+	    __atomic_fetch_add(&captures, 1u, __ATOMIC_RELAXED) < 3u) {
+		printf("sheng-gnss-pac: %s[%d] exception type=0x%x code=0x%llx subcode=0x%llx\n",
+		    proc_best_name(get_bsdtask_info(task)), proc_pid(get_bsdtask_info(task)),
+		    exception, (unsigned long long)code[0], codeCnt > 1 ? (unsigned long long)code[1] : 0ULL);
+#if __arm64__
+		arm_saved_state_t *ss = find_user_regs(thread);
+		if (ss != NULL) {
+			uint64_t pc = get_saved_state_pc(ss);
+			/* The boot log's copy (the message buffer wraps long before a late look at it): the last four, with the frame chain. */
+			{
+				struct sheng_exc_record *rec = &sheng_exc_ring[sheng_exc_count & 3];
+				*rec = (struct sheng_exc_record){};
+				strlcpy(rec->name, proc_best_name(get_bsdtask_info(task)), sizeof(rec->name));
+				rec->pid = (uint32_t)proc_pid(get_bsdtask_info(task));rec->type = (uint32_t)exception;
+				rec->pc = pc;rec->lr = get_saved_state_lr(ss);rec->far = get_saved_state_far(ss);rec->esr = get_saved_state_esr(ss);
+				uint64_t fp = get_saved_state_fp(ss);
+				for (unsigned i = 0; thread == current_thread() && i < 12 && fp && !(fp & 7); i++) {
+					uint64_t frame[2];
+					if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+						break;
+					}
+					rec->ret[i] = frame[1] & 0x00007fffffffffffULL;rec->frames = i + 1;
+					if (frame[0] <= fp) {
+						break;
+					}
+					fp = frame[0];
+				}
+				sheng_exc_count = sheng_exc_count + 1;
+			}
+			printf("sheng-gnss-pac: pc=0x%llx lr=0x%llx sp=0x%llx far=0x%llx esr=0x%x\n",
+			    pc, get_saved_state_lr(ss), get_saved_state_sp(ss), get_saved_state_far(ss), get_saved_state_esr(ss));
+			for (unsigned r = 0; r < 29; r += 4) {
+				printf("sheng-gnss-pac: x%u=0x%llx 0x%llx 0x%llx 0x%llx\n", r,
+				    get_saved_state_reg(ss, r), get_saved_state_reg(ss, r + 1),
+				    r + 2 < 29 ? get_saved_state_reg(ss, r + 2) : 0ULL, r + 3 < 29 ? get_saved_state_reg(ss, r + 3) : 0ULL);
+			}
+			uint32_t insn[8] = {};
+			if (copyin((user_addr_t)(pc - 16), insn, sizeof(insn)) == 0) {
+				printf("sheng-gnss-pac: insn@pc-16 %08x %08x %08x %08x | %08x %08x %08x %08x\n",
+				    insn[0], insn[1], insn[2], insn[3], insn[4], insn[5], insn[6], insn[7]);
+				if (insn[4] == UINT32_C(0xdac11a30)) {
+					sheng_gnss_object_context(task, ss);
+				}
+			}
+			/* What the fault address maps to: physical page, managed DRAM or not, cache attributes. */
+			extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+			extern unsigned int pmap_cache_attributes(ppnum_t);
+			extern boolean_t pmap_valid_page(ppnum_t);
+			ppnum_t pn = pmap_find_phys(get_task_pmap(task), get_saved_state_far(ss));
+			printf("sheng-gnss-pac: far page 0x%x managed=%d wimg=0x%x\n", pn, pn ? pmap_valid_page(pn) : -1,
+			    pn ? pmap_cache_attributes(pn) : 0);
+			if (thread == current_thread()) {
+				/* The attributes the MMU uses for this user address (PAR_EL1[63:56] is the MAIR encoding) and SCTLR_EL1. */
+				uint64_t par = 0, sctlr = 0, mair = 0;
+				__asm__ volatile ("at s1e0w, %3\n isb\n mrs %0, par_el1\n mrs %1, sctlr_el1\n mrs %2, mair_el1"
+				    : "=r"(par), "=r"(sctlr), "=r"(mair) : "r"(get_saved_state_far(ss)) : "memory");
+				printf("sheng-gnss-pac: par=0x%llx (attr 0x%llx) sctlr=0x%llx mair=0x%llx\n", par, par >> 56, sctlr, mair);
+				void sheng_dump_user_backtrace(const char *tag);
+				sheng_dump_user_backtrace("sheng-gnss-pac");
+			}
+		}
+#endif /* __arm64__ */
+	}
+#endif /* MACH_BSD */
+}
