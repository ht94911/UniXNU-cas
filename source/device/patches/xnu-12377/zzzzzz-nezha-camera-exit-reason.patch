+			    p->p_pid, p->p_exit_reason ? p->p_exit_reason->osr_namespace : 0,
+			    p->p_exit_reason ? (unsigned long long)p->p_exit_reason->osr_code : 0,
+			    p->p_exit_reason ? exit_reason_get_string_desc(p->p_exit_reason) : "<absent>");
+		}
