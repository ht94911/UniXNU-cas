+#if XNU_QCOM_USB_DEBUG
+	/* Capture the original va_list before debugger cross-CPU synchronization.
+	 * Only the first entry formats; a nested fault keeps the original panic
+	 * path and cannot recursively format an invalid string. No storage I/O.
+	 */
+	static unsigned int qcom_system_panic_recorded;
+	if (!__atomic_exchange_n(&qcom_system_panic_recorded, 1u, __ATOMIC_ACQ_REL)) {
+		char text[1536];
+		uint64_t mpidr, esr, far, elr;
+		__asm__ volatile("mrs %0, mpidr_el1" : "=r" (mpidr));
+		__asm__ volatile("mrs %0, esr_el1" : "=r" (esr));
+		__asm__ volatile("mrs %0, far_el1" : "=r" (far));
+		__asm__ volatile("mrs %0, elr_el1" : "=r" (elr));
+		int n = snprintf(text, sizeof(text),
+		    "\nNEZHA SYSTEM PANIC ENTRY: mpidr=%#llx caller=%#lx reason=%u context=%#llx options=%#llx esr_sample=%#llx far_sample=%#llx elr_sample=%#llx\n",
+		    (unsigned long long)mpidr, panic_caller, reason,
+		    (unsigned long long)(uintptr_t)ctx, (unsigned long long)panic_options_mask,
+		    (unsigned long long)esr, (unsigned long long)far, (unsigned long long)elr);
+		if (n > 0 && (size_t)n < sizeof(text)) {
+			va_list copy;
+			va_copy(copy, *panic_args);
+			(void)vsnprintf(text + n, sizeof(text) - (size_t)n,
+			    panic_format_str, copy);
+			va_end(copy);
+			(void)qcom_usb_debug_write(text, strnlen(text, sizeof(text)));
+		}
+		(void)qcom_usb_debug_write("\n", 1);
+		if (PE_kputc != NULL) {
+			uintptr_t frames[16];
+			backtrace_info_t info = BTI_NONE;
+			unsigned int count = backtrace(frames, 16, NULL, &info);
+			n = snprintf(text, sizeof(text), "NEZHA SYSTEM PANIC STACK: frames=%u info=%#x", count, (unsigned)info);
+			for (unsigned int i = 0; i < count && n > 0 && (size_t)n < sizeof(text); ++i) {
+				int added = snprintf(text + n, sizeof(text) - (size_t)n,
+				    " %#llx", (unsigned long long)frames[i]);
+				if (added < 0 || (size_t)added >= sizeof(text) - (size_t)n) break;
+				n += added;
+			}
+			(void)qcom_usb_debug_write(text, strnlen(text, sizeof(text)));
+			(void)qcom_usb_debug_write("\n", 1);
+		}
+		/* The qualified hardware drain remains restricted to the master CPU.
+		 * On another CPU, allow the still-running owner worker up to 100 ms
+		 * to send the CPU queue before the unchanged debugger stops peers.
+		 * Sampling status takes no MMIO ownership and never steals a lock.
+		 */
+		if (!qcom_usb_debug_wait_drained(100)) {
+			uint64_t start, now, frequency;
+			__asm__ volatile("mrs %0, cntfrq_el0" : "=r" (frequency));
+			__asm__ volatile("isb; mrs %0, cntvct_el0" : "=r" (start));
+			if (frequency >= 1000 && frequency <= 1000000000ULL) {
+				for (unsigned int i = 0; i < 100000u; ++i) {
+					struct qcom_usb_debug_status status;
+					qcom_usb_debug_get_status(&status);
+					if (status.phase != QCOM_USB_DEBUG_ACTIVE ||
+					    (status.error != QCOM_USB_DEBUG_STATUS_BUSY &&
+					    !status.buffer_pending && !status.transport_pending)) break;
+					__asm__ volatile("isb; mrs %0, cntvct_el0" : "=r" (now));
+					if (now - start >= frequency / 10u) break;
+					__asm__ volatile("yield" ::: "memory");
+				}
+			}
+		}
+	}
+#endif
