+
+	/* HakiOS f128f1d exec_inject_env supplies the per-process environment
+	 * append. The nezha camera library is only for the original camera
+	 * daemon in this explicit continuous-camera boot; original argv/env,
+	 * code signatures and service permissions remain in force. */
+	unsigned camera_mode = 0;
+	if (PE_parse_boot_argn("nezha-camera", &camera_mode, sizeof(camera_mode)) && camera_mode == 6 &&
