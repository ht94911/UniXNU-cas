--- a/security/mac_process.c
+++ b/security/mac_process.c
@@ -78,6 +78,8 @@
 #include <kern/task.h>
 #include <kern/zalloc.h>
 #include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <sys/codesign.h>
 
 #include <os/hash.h>
 
@@ -915,11 +917,48 @@
 // entry are valid: the constraint category of an owner or cryptex binary is not the platform one. The original release
 // AMFI ignores its own amfi_* boot arguments, so the check is cleared here when the board asks for it. An option of the
 // instrumented board only: the boot argument, not the default, decides.
+/* The original service path rejected an owner-signed recorder with c[8]e[6].
+ * Permit only this already validated, immutable helper in its explicit test
+ * payload. Signature validation and every other exec policy remain in place. */
+static bool
+nezha_audio_record_launch(proc_t p, struct image_params *imgp)
+{
+	DTEntry chosen = NULL;
+	const void *property = NULL;
+	unsigned int length = 0;
+	uint32_t selected = 0;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "nezha-audio-record", &property, &length) != kSuccess ||
+	    property == NULL || length != sizeof(selected)) {
+		return false;
+	}
+	memcpy(&selected, property, sizeof(selected));
+	struct _posix_spawnattr *attr = imgp->ip_px_sa;
+	if (selected != 90 || !(imgp->ip_flags & IMGPF_SPAWN) || imgp->ip_scriptvp ||
+	    attr == NULL || attr->psa_launch_type != CS_LAUNCH_TYPE_SYSTEM_SERVICE ||
+	    proc_original_ppid(p) != 1 || !(imgp->ip_csflags & CS_VALID)) {
+		return false;
+	}
+	struct cs_blob *blob = csvnode_get_blob(imgp->ip_vp, imgp->ip_arch_offset);
+	const uint8_t *hash = blob ? csblob_get_cdhash(blob) : NULL;
+	const char *identity = blob ? csblob_get_identity(blob) : NULL;
+	static const uint8_t recorder_hash[CS_CDHASH_LEN] = {
+	    0xfa, 0x8e, 0x18, 0xef, 0xc9, 0x0a, 0x76, 0x61, 0xf4, 0x9f,
+	    0x35, 0x41, 0x71, 0xbb, 0x41, 0xc8, 0x4f, 0x1c, 0xae, 0x3a
+	};
+	return hash && identity &&
+	       strcmp(identity, "org.unixnu.nezha.audio-record") == 0 &&
+	       memcmp(hash, recorder_hash, sizeof(recorder_hash)) == 0;
+}
+
 int
 mac_proc_check_launch_constraints(proc_t curp, struct image_params *imgp, os_reason_t *reasonp)
 {
 	uint32_t skip = 0;
 	if (PE_parse_boot_argn("sheng-no-lc", &skip, sizeof(skip)) && skip != 0) {
+		return 0;
+	}
+	if (nezha_audio_record_launch(curp, imgp)) {
 		return 0;
 	}
 	char *fatal_failure_desc = NULL;
