<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.unixnu.nezha.location-launch</string>
<key>ProgramArguments</key><array><string>/usr/libexec/nezha-location-launch</string></array>
<key>UserName</key><string>mobile</string>
<key>RunAtLoad</key><false/>
<key>LaunchOnlyOnce</key><true/>
<key>KeepAlive</key><false/>
<key>ProcessType</key><string>Background</string>
<key>StartInterval</key><integer>120</integer>
<key>StandardOutPath</key><string>/private/var/mobile/Library/Logs/nezha-location-launch.stdout</string>
<key>StandardErrorPath</key><string>/private/var/mobile/Library/Logs/nezha-location-launch.stderr</string>
</dict></plist>
