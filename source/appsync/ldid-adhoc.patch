+
+// Map Mach-O code for random access to its load commands and signature.
+// Plain resources stay on the stream reader so hashing can reclaim each buffer.
+class MapBuffer : public std::streambuf {
+  private:
+    Map map_;
+
+  public:
+    MapBuffer(const std::string &path) {
+        map_.open(path, O_RDONLY, PROT_READ, MAP_PRIVATE);
+        char *base(static_cast<char *>(map_.data()));
+        setg(base, base, base + map_.size());
+    }
+
+    static bool Look(const std::string &path) {
+        struct stat info;
+        if (stat(path.c_str(), &info) || !S_ISREG(info.st_mode) || info.st_size < 4)
+            return false;
+        int file = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (file < 0)
+            return false;
+        uint32_t magic;
+        ssize_t count;
+        do {
+            count = read(file, &magic, sizeof(magic));
+        } while (count < 0 && errno == EINTR);
+        close(file);
+        return count == sizeof(magic) && (magic == MH_MAGIC || magic == MH_MAGIC_64 ||
+            magic == MH_CIGAM || magic == MH_CIGAM_64 || magic == FAT_MAGIC || magic == FAT_CIGAM);
+    }
+
+    const void *data() const { return map_.data(); }
+    size_t size() const { return map_.size(); }
+};
 #endif // LDID_NOTOOLS
 
