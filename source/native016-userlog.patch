 #include <sys/systm.h>
 #include <sys/sysctl.h>
 #include <sys/proc.h>
+#include <sys/codesign.h>
+#include <pexpert/pexpert.h>
 #include <sys/errno.h>
 #include "QcomUserLogWire.h"
 #include "QcomXnuUsbDebug.h"
 
+/* Native015 temporary producer: an exact boot-selected code identity only. */
+static int
+qcom_usb_userlog_hex(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static int
+qcom_usb_userlog_producer(proc_t process)
+{
+    /* Force string parsing: an all-decimal 40-hex hash is still a hash.
+     * One extra byte prevents a longer argument from truncating to 40 hex. */
+    char argument[42] = {0};
+    uint8_t wanted[20];
+    _Static_assert(CS_CDHASH_LEN == sizeof wanted, "Native CDHash must be 20 bytes");
+    if (!PE_parse_boot_arg_str("btlog", argument, sizeof argument) || argument[40]) return 0;
+    for (size_t i = 0; i < sizeof wanted; ++i) {
+        int high = qcom_usb_userlog_hex(argument[2 * i]);
+        int low = qcom_usb_userlog_hex(argument[2 * i + 1]);
+        if (high < 0 || low < 0) return 0;
+        wanted[i] = (uint8_t)((high << 4) | low);
+    }
+    const uint8_t *actual = cs_get_cdhash(process);
+    if (!actual) return 0;
+    uint8_t difference = 0;
+    for (size_t i = 0; i < sizeof wanted; ++i) difference |= wanted[i] ^ actual[i];
+    return difference == 0;
+}
+
+static int
+qcom_usb_userlog_literal(const struct QcomUserLogWire *w, size_t *at, const char *text)
+{
+    for (; *text; ++text, ++*at) {
+        if (*at >= w->bytes || w->data[*at] != (uint8_t)*text) return 0;
+    }
+    return 1;
+}
+
+static int
+qcom_usb_userlog_u32(const struct QcomUserLogWire *w, size_t *at, uint32_t *result)
+{
+    if (*at >= w->bytes || w->data[*at] < '0' || w->data[*at] > '9') return 0;
+    size_t first = *at;
+    uint32_t value = 0;
+    while (*at < w->bytes && w->data[*at] >= '0' && w->data[*at] <= '9') {
+        uint32_t digit = w->data[*at] - '0';
+        if ((*at > first && w->data[first] == '0') || value > (0xffffffffu - digit) / 10u) return 0;
+        value = value * 10u + digit;
+        ++*at;
+    }
+    *result = value;
+    return 1;
+}
+
+static int
+qcom_usb_userlog_scalar(const struct QcomUserLogWire *w, proc_t process)
+{
+    uint32_t stage, pid, value;
+    size_t at = 0;
+    pid_t actual_pid = proc_pid(process);
+    if (actual_pid <= 0 || w->flags != SOC_ULOG_STATUS || w->bytes > 128u ||
+        w->sequence || w->offset || w->total != w->bytes ||
+        w->sessionHi != 0x51425455u || w->sessionLo != (uint32_t)actual_pid) return 0;
+    if (!qcom_usb_userlog_literal(w, &at, "[qbt-ui] p=") ||
+        !qcom_usb_userlog_u32(w, &at, &stage) ||
+        !qcom_usb_userlog_literal(w, &at, " pid=") ||
+        !qcom_usb_userlog_u32(w, &at, &pid) ||
+        !qcom_usb_userlog_literal(w, &at, " a=") ||
+        !qcom_usb_userlog_u32(w, &at, &value) ||
+        !qcom_usb_userlog_literal(w, &at, " b=0\n") || at != w->bytes ||
+        pid != (uint32_t)actual_pid) return 0;
+    switch (stage) {
+    case 1: case 4: return value == 1u;
+    case 2: case 3: case 6: case 7: case 9: case 10: return value <= 1u;
+    case 5: return value <= 5u || value == 7u;
+    case 8: return value <= 3u;
+    default: return 0;
+    }
+}
+
