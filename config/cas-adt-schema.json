{
  "schema_version": 1,
  "format": "cas Apple Device Tree contract; not flattened Android FDT",
  "endianness": "little",
  "property_name_bytes": 32,
  "alignment": 4,
  "limits": {
    "blob_bytes": 1048576,
    "depth": 32,
    "nodes": 1024,
    "properties_per_node": 128,
    "children_per_node": 256,
    "node_name_bytes": 63
  },
  "policies": {
    "page_size": 4096,
    "nvram_bank_bytes": 8192,
    "cpu0_default": true,
    "smp_is_audit_only": true,
    "allow_apple_identity": false,
    "allow_root_volume": false,
    "framebuffer_handoff": "boot_args.Video",
    "memory_is_informational": true,
    "owned_memory_requires_live_validation": true
  },
  "nodes": {
    "/": {
      "model": "cstring",
      "compatible": "strings",
      "#address-cells": "u32",
      "#size-cells": "u32"
    },
    "/chosen": {
      "osenvironment": "cstring",
      "dram-base": "u64",
      "dram-size": "u64",
      "darwinboot-memory-size": "u64",
      "nvram-bank-size": "u32",
      "nvram-bank-count": "u32",
      "nvram-current-bank": "u32",
      "nvram-proxy-data": "nvram"
    },
    "/chosen/memory-map": {},
    "/cpus": {},
    "/cpus/cpu[0-7]": {
      "device_type": "cstring",
      "state": "cstring",
      "reg": "u32",
      "compatible": "strings",
      "timebase-frequency": "u32"
    },
    "/arm-io": {
      "device_type": "cstring",
      "#address-cells": "u32",
      "#size-cells": "u32",
      "ranges": "3xu64"
    },
    "/arm-io/intc": {
      "compatible": "cstring",
      "reg": "4xu64",
      "redistributor-stride": "u64"
    },
    "/psci": {
      "compatible": "cstring",
      "method": "cstring"
    },
    "/timer": {
      "compatible": "cstring",
      "clock-frequency": "u32",
      "interrupts": "12xu32"
    },
    "/memory": {
      "device_type": "cstring",
      "reg": "ranges64"
    },
    "/reserved-memory": {
      "#address-cells": "u32",
      "#size-cells": "u32",
      "ranges": "empty"
    },
    "/reserved-memory/region[0-9]+": {
      "reg": "2xu64"
    },
    "/defaults": {
      "sleep-disabled": "u32"
    },
    "/options": {}
  },
  "private_only_optional_properties": {
    "/chosen": {
      "random-seed": "64bytes"
    }
  },
  "forbidden_properties": [
    "unique-chip-id",
    "chip-id",
    "serial-number",
    "mlb-serial-number",
    "platform-uuid",
    "mac-address",
    "local-mac-address",
    "root-matching",
    "boot-uuid",
    "boot-manifest-hash",
    "boot-nonce",
    "RAMDisk",
    "PackedRAMDisk",
    "TrustCache",
    "GpuAddon"
  ],
